---
import config from '../../config';
import { footerNav } from '../../config/navigation';

const year = new Date().getFullYear();
---

<footer class="bg-zinc-950">

  <!-- Gradient accent line -->
  <div class="h-px" style="background:linear-gradient(90deg,transparent 0%,#3f3f46 25%,#71717a 50%,#3f3f46 75%,transparent 100%);"></div>

  <div class="max-w-7xl mx-auto px-6">

    <div class="py-14 grid grid-cols-1 md:grid-cols-[1.6fr_1fr_1fr] gap-10 md:gap-6">

      <div>
        <a href="/" aria-label="Carbid" class="flex items-center mb-5">
          <img src="/images/carbid logo.png" alt="Carbid"
               style="width:148px;height:40px;object-fit:cover;object-position:center 50%;filter:invert(1);"
               loading="lazy" />
        </a>
        <p class="text-sm text-zinc-500 max-w-[260px] leading-relaxed mb-5">
          Visi Lietuvos ir Europos automobilių aukcionai viename ekrane.
        </p>
        <a href={`mailto:${config.companyEmail}`} class="text-xs text-zinc-600 hover:text-zinc-300 transition-colors">
          {config.companyEmail}
        </a>
      </div>

      {footerNav.map(({ title, items }) => (
        <div>
          <p class="text-[10px] font-medium text-zinc-600 uppercase tracking-widest mb-5">{title}</p>
          <ul class="space-y-3">
            {items.map(({ label, href }) => (
              <li>
                <a href={href} class="text-sm text-zinc-400 hover:text-white transition-colors">{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <div class="py-5 border-t border-zinc-900 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-zinc-600">
      <p>© {year} {config.companyName}</p>
      <div class="flex gap-5">
        <a href="/privatumas" class="hover:text-zinc-300 transition-colors">Privatumo politika</a>
        <a href="/salygos" class="hover:text-zinc-300 transition-colors">Sąlygos</a>
      </div>
    </div>

  </div>
</footer>
