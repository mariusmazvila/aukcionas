---
import config from '../../config';
import { footerNav } from '../../config/navigation';

const year = new Date().getFullYear();
---

<footer class="bg-zinc-100 border-t border-zinc-200">
  <div class="max-w-6xl mx-auto px-6">

    <div class="py-10 grid grid-cols-1 md:grid-cols-[1fr_1fr_1fr] gap-10">
      <div>
        <a href="/" aria-label="AutoBid">
          <img src="/images/autobid%20logo.png" alt="AutoBid" class="h-8 w-auto" />
        </a>
        <p class="mt-3 text-sm text-zinc-500 max-w-xs">
          Visi Lietuvos ir Europos automobilių aukcionai viename ekrane.
        </p>
        <a href={`mailto:${config.companyEmail}`} class="mt-3 block text-xs text-zinc-400 hover:text-zinc-700 transition-colors">
          {config.companyEmail}
        </a>
      </div>

      {footerNav.map(({ title, items }) => (
        <div>
          <p class="text-xs font-medium text-zinc-400 uppercase tracking-widest mb-4">{title}</p>
          <ul class="space-y-2.5">
            {items.map(({ label, href }) => (
              <li>
                <a href={href} class="text-sm text-zinc-600 hover:text-zinc-900 transition-colors">{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="py-4 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-zinc-400">
      <p>© {year} {config.companyName}</p>
      <div class="flex gap-4">
        <a href="/privatumas" class="hover:text-zinc-700 transition-colors">Privatumo politika</a>
        <a href="/salygos" class="hover:text-zinc-700 transition-colors">Sąlygos</a>
      </div>
    </div>

  </div>
</footer>
