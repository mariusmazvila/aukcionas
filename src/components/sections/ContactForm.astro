---
// Kontaktų forma su Netlify Forms integracija.
// Nereikia backend'o — Netlify automatiškai priima žinutes.
// Sėkmės puslapis: /aciu (konfiguruojama per action prop).
import config from '../../config';

interface Props {
  headline?: string;
  description?: string;
  /** Netlify Forms forma vardas (unikalus tarp visų formų) */
  formName?: string;
  /** Sėkmės puslapio URL */
  successUrl?: string;
  background?: 'white' | 'light';
  class?: string;
}

const {
  headline = 'Susisiekite su mumis',
  description,
  formName = 'kontaktai',
  successUrl = '/aciu',
  background = 'light',
  class: className,
} = Astro.props;

const sectionBg = background === 'light' ? 'bg-gray-50' : 'bg-white';
---

<section class:list={['py-16 lg:py-24', sectionBg, className]} id="kontaktai">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Kairė pusė: antraštė + kontaktų info -->
      <div>
        <slot name="eyebrow" />
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight tracking-tight">
          {headline}
        </h2>
        {description && (
          <p class="mt-4 text-lg text-gray-600 leading-relaxed">{description}</p>
        )}

        <ul class="mt-8 space-y-5">
          {config.companyEmail && (
            <li class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-900">El. paštas</p>
                <a
                  href={`mailto:${config.companyEmail}`}
                  class="text-blue-600 hover:text-blue-700 transition-colors"
                >
                  {config.companyEmail}
                </a>
              </div>
            </li>
          )}
          {config.companyPhone && (
            <li class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-900">Telefonas</p>
                <a
                  href={`tel:${config.companyPhone.replace(/\s/g, '')}`}
                  class="text-blue-600 hover:text-blue-700 transition-colors"
                >
                  {config.companyPhone}
                </a>
              </div>
            </li>
          )}
          {config.companyAddress && (
            <li class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-900">Adresas</p>
                <p class="text-gray-600">{config.companyAddress}</p>
              </div>
            </li>
          )}
        </ul>

        <!-- Papildomas slot'as — pvz. darbo laikas, žemėlapis -->
        <slot />
      </div>

      <!-- Dešinė pusė: forma -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <!--
          Netlify Forms: data-netlify="true" + paslėptas form-name laukas.
          Netlify automatiškai aptinka šią formą per deploy ir sukuria įrašų saugyklą.
          Honeypot: netlify-honeypot="bot-field" — anti-spam be CAPTCHA.
        -->
        <form
          name={formName}
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action={successUrl}
          class="space-y-5"
          novalidate
        >
          <input type="hidden" name="form-name" value={formName} />

          <!-- Honeypot laukas — robotai jį užpildo, žmonės ne -->
          <p class="hidden" aria-hidden="true">
            <label>
              Neužpildykite:
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="cf-vardas" class="block text-sm font-medium text-gray-700 mb-1.5">
                Vardas <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                id="cf-vardas"
                type="text"
                name="vardas"
                required
                autocomplete="given-name"
                placeholder="Jūsų vardas"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 placeholder-gray-400
                       focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow"
              />
            </div>
            <div>
              <label for="cf-el-pastas" class="block text-sm font-medium text-gray-700 mb-1.5">
                El. paštas <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                id="cf-el-pastas"
                type="email"
                name="el-pastas"
                required
                autocomplete="email"
                placeholder="jusu@pastas.lt"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 placeholder-gray-400
                       focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow"
              />
            </div>
          </div>

          <div>
            <label for="cf-telefonas" class="block text-sm font-medium text-gray-700 mb-1.5">
              Telefonas
              <span class="text-gray-400 font-normal">(neprivaloma)</span>
            </label>
            <input
              id="cf-telefonas"
              type="tel"
              name="telefonas"
              autocomplete="tel"
              placeholder="+370 600 00000"
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 placeholder-gray-400
                     focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow"
            />
          </div>

          <div>
            <label for="cf-zinute" class="block text-sm font-medium text-gray-700 mb-1.5">
              Žinutė <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <textarea
              id="cf-zinute"
              name="zinute"
              required
              rows="5"
              placeholder="Aprašykite savo projektą ar poreikius..."
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-gray-900 placeholder-gray-400
                     focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl
                   hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2
                   transition-colors duration-200 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Siųsti žinutę
          </button>

          <p class="text-xs text-center text-gray-400">
            Atsakysime per 2 darbo dienas. Jūsų duomenys saugomi pagal{' '}
            <a href="/privatumo-politika" class="text-blue-500 hover:text-blue-600 underline-offset-2 hover:underline">
              Privatumo politiką
            </a>.
          </p>
        </form>
      </div>

    </div>
  </div>
</section>
