---
/**
 * Hero — universali hero sekcija su dviem variantais.
 *
 * Variantas 'split':  tekstas kairėje, paveikslėlis dešinėje (default)
 * Variantas 'centered': tekstas centre, paveikslėlis apačioje
 *
 * CTA mygtukus galima pateikti kaip props arba per <slot name="cta">.
 * Paveikslėlį galima pakeisti per <slot name="image">.
 *
 * @example
 * <Hero
 *   headline="Elektros skydai pramonei"
 *   subheadline="Kokybė ir patikimumas nuo 2010 m."
 *   primaryCta={{ text: 'Gauti pasiūlymą', href: '/kontaktai' }}
 *   secondaryCta={{ text: 'Sužinoti daugiau', href: '/paslaugos' }}
 *   image={heroImg}
 *   imageAlt="Elektros skydo montavimas"
 * />
 */
import Button from '../ui/Button.astro';
import Image from '../ui/Image.astro';
import type { ImageMetadata } from 'astro';

interface Cta {
  text: string;
  href: string;
  external?: boolean;
}

interface Props {
  /** Pagrindinė antraštė (H1) */
  headline: string;
  /** Paantraštė arba aprašymas */
  subheadline?: string;
  /** Pagrindinis CTA mygtukas */
  primaryCta?: Cta;
  /** Antrinis CTA mygtukas */
  secondaryCta?: Cta;
  /** Paveikslėlis (lokalus ImageMetadata) */
  image?: ImageMetadata;
  /** Alt tekstas paveikslėliui */
  imageAlt?: string;
  /** Išdėstymo variantas */
  variant?: 'split' | 'centered';
  /** Papildomos CSS klasės sekcijos elementui */
  class?: string;
}

const {
  headline,
  subheadline,
  primaryCta,
  secondaryCta,
  image,
  imageAlt = headline,
  variant = 'split',
  class: className,
} = Astro.props;

const hasCta = primaryCta || secondaryCta || Astro.slots.has('cta');
const hasImage = image || Astro.slots.has('image');
---

<section class:list={[
  'relative overflow-hidden bg-white',
  variant === 'split' ? 'py-16 lg:py-24' : 'py-20 lg:py-32',
  className,
]}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    {variant === 'split' ? (
      <!-- Split: tekstas kairėje, paveikslėlis dešinėje -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Tekstas -->
        <div class="order-2 lg:order-1">
          <!-- Papildomas slot'as virš antraštės (pvz. badge/label) -->
          <slot name="eyebrow" />

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight tracking-tight">
            {headline}
          </h1>

          {subheadline && (
            <p class="mt-6 text-lg sm:text-xl text-gray-600 leading-relaxed max-w-lg">
              {subheadline}
            </p>
          )}

          <!-- Papildomas slot'as po paantraštės (pvz. feature list) -->
          <slot name="extras" />

          <!-- CTA mygtukų zona -->
          {hasCta && (
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <slot name="cta">
                {primaryCta && (
                  <Button variant="primary" size="lg" href={primaryCta.href} external={primaryCta.external}>
                    {primaryCta.text}
                  </Button>
                )}
                {secondaryCta && (
                  <Button variant="outline" size="lg" href={secondaryCta.href} external={secondaryCta.external}>
                    {secondaryCta.text}
                  </Button>
                )}
              </slot>
            </div>
          )}
        </div>

        <!-- Paveikslėlis -->
        {hasImage && (
          <div class="order-1 lg:order-2">
            <slot name="image">
              {image && (
                <Image
                  src={image}
                  alt={imageAlt}
                  widths={[480, 760]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  loading="eager"
                  class="w-full rounded-2xl shadow-xl object-cover"
                />
              )}
            </slot>
          </div>
        )}

      </div>
    ) : (
      <!-- Centered: viskas centre -->
      <div class="text-center max-w-4xl mx-auto">

        <slot name="eyebrow" />

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight tracking-tight">
          {headline}
        </h1>

        {subheadline && (
          <p class="mt-6 text-lg sm:text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto">
            {subheadline}
          </p>
        )}

        <slot name="extras" />

        {hasCta && (
          <div class="mt-8 flex flex-wrap justify-center items-center gap-4">
            <slot name="cta">
              {primaryCta && (
                <Button variant="primary" size="lg" href={primaryCta.href} external={primaryCta.external}>
                  {primaryCta.text}
                </Button>
              )}
              {secondaryCta && (
                <Button variant="outline" size="lg" href={secondaryCta.href} external={secondaryCta.external}>
                  {secondaryCta.text}
                </Button>
              )}
            </slot>
          </div>
        )}

        {hasImage && (
          <div class="mt-16">
            <slot name="image">
              {image && (
                <Image
                  src={image}
                  alt={imageAlt}
                  widths={[600, 1200]}
                  sizes="(max-width: 768px) 100vw, 900px"
                  loading="eager"
                  class="w-full rounded-2xl shadow-2xl object-cover"
                />
              )}
            </slot>
          </div>
        )}

      </div>
    )}

  </div>

  <!-- Papildomas slot'as — pvz. background elementai, scroll indicator -->
  <slot name="background" />
</section>
