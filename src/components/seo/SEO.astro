---
import config from '../../config';
import { getCanonicalUrl } from '../../lib/utils';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;   // ISO 8601, pvz. "2024-03-15"
  modifiedDate?: string;  // ISO 8601
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description = config.siteDescription,
  image = config.ogImage,
  canonical,
  type = 'website',
  publishDate,
  modifiedDate,
  author,
  noindex = false,
} = Astro.props;

// "Puslapis | Svetainė" — standartinis formatas, gerai matomas naršyklės tab'e ir Google'e
const pageTitle = title ? `${title} | ${config.siteName}` : config.siteName;

// Canonical URL: perduotas arba automatiškai generuotas iš siteUrl + kelias
// Svarbu: naudojame siteUrl (pvz. https://innomode.lt), ne localhost
const canonicalUrl = canonical ?? getCanonicalUrl(config.siteUrl, Astro.url.pathname);

// OG nuotrauka turi būti absoliutus URL — Facebook/LinkedIn reikalavimas
const ogImageUrl = image.startsWith('http') ? image : `${config.siteUrl}${image}`;

// OG locale formatas: "lt" → "lt_LT" (Facebook standarto reikalavimas)
const ogLocale = config.defaultLocale === 'lt' ? 'lt_LT' : config.defaultLocale;
---

<!-- Pagrindinis title ir description -->
<title>{pageTitle}</title>
<meta name="description" content={description} />

<!-- Robots: noindex naudok tik puslapiams, kurių nenorime Google'e (pvz. /thank-you) -->
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

<!-- Canonical — apsaugo nuo duplicate content problemų -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph — Facebook, LinkedIn, WhatsApp, Telegram peržiūra -->
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={description} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content={config.siteName} />

<!-- Twitter Card — veikia ir X.com. summary_large_image = didelė nuotrauka -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Article meta — tik blog straipsniams (type="article") -->
{type === 'article' && publishDate && (
  <meta property="article:published_time" content={publishDate} />
)}
{type === 'article' && modifiedDate && (
  <meta property="article:modified_time" content={modifiedDate} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}
