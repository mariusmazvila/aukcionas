---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  external?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  external = false,
  disabled = false,
  class: className,
} = Astro.props;

const variantClasses = {
  primary:   'bg-[#0344D3] text-white border-transparent hover:bg-[#0240C8]',
  secondary: 'bg-zinc-800 text-zinc-100 border-transparent hover:bg-zinc-700',
  outline:   'bg-transparent text-zinc-300 border-zinc-700 hover:border-zinc-500 hover:text-zinc-100',
  ghost:     'bg-transparent text-zinc-400 border-transparent hover:text-zinc-100 hover:bg-zinc-800',
} as const;

const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs gap-1.5',
  md: 'px-4 py-2 text-sm gap-2',
  lg: 'px-6 py-3 text-sm gap-2',
} as const;

const baseClasses = [
  'inline-flex items-center justify-center font-medium border',
  'transition-colors duration-100',
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0344D3] focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950',
  disabled && 'opacity-40 cursor-not-allowed pointer-events-none',
  variantClasses[variant],
  sizeClasses[size],
  className,
];
---

{href ? (
  <a href={href} class:list={baseClasses} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} aria-disabled={disabled}>
    <slot />
  </a>
) : (
  <button type={type} class:list={baseClasses} disabled={disabled}>
    <slot />
  </button>
)}
