---
// Breadcrumbs komponentas su automatišku BreadcrumbList JSON-LD generavimu.
// Paskutinis elementas yra current page — nerenderinamas kaip nuoroda.
import config from '../../config';

interface BreadcrumbItem {
  label: string;
  /** Santykinis kelias, pvz. '/paslaugos' */
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;

// BreadcrumbList JSON-LD schema.org — Google rodo breadcrumbs paieškos rezultatuose.
// Paskutinis elementas (current page) nerodo `item` URL — tai rekomenduojama praktika.
const schemaItems = items.map((item, i) => ({
  "@type": "ListItem",
  position: i + 1,
  name: item.label,
  ...(i < items.length - 1 ? { item: `${config.siteUrl}${item.href}` } : {}),
}));

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: schemaItems,
})
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<!-- JSON-LD — Google nuskaito net iš body, ne tik iš head -->
<script type="application/ld+json" set:html={jsonLd} />

<nav aria-label="Naršymo kelias" class:list={[className]}>
  <ol class="flex items-center flex-wrap gap-x-2 gap-y-1 text-sm text-gray-500">
    {items.map((item, i) => {
      const isLast = i === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 text-gray-300 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          )}
          {isLast ? (
            <span class="text-gray-900 font-medium truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="hover:text-gray-900 transition-colors whitespace-nowrap"
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
