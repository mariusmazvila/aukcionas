---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kaip veikia"
  description="AutoBid veikimo principas — kaip renkame duomenis iš aukcionų ir kaip tai padeda rasti geriausias mašinas."
  solidHeader={true}
>

  <!-- Pilno puslapio fonas — fixed, lieka vietoje scroll'inant -->
  <div class="fixed inset-0 -z-10 bg-cover bg-center" style="background-image:url('/images/lights2.webp');" aria-hidden="true"></div>
  <div class="fixed inset-0 -z-10 bg-zinc-950/70" aria-hidden="true"></div>

  <section class="px-6 pt-28 pb-16">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-5xl sm:text-6xl font-bold text-white tracking-tight leading-[1.1] mb-4">Kaip veikia<br />AutoBid</h1>
      <p class="text-lg text-white/70 leading-relaxed">
        Automatiškai renkame duomenis iš Lietuvos ir Europos automobilių aukcionų,
        apdorojame juos ir pateikiame vienoje vietoje — kad tu galėtum greičiau rasti geriausią sandorį.
      </p>
    </div>
  </section>

  <section class="px-6 pb-16">
    <div class="max-w-3xl mx-auto space-y-4">

      {[
        {
          num: '01',
          title: 'Duomenų rinkimas',
          description: 'Mūsų sistema nuolat tikrina visus prijungtus aukcionus — Autoplius.lt, Auto.lt, Autogidas.lt, Mobile.de, AutoScout24 ir kitus. Nauji skelbimai aptinkami per kelias minutes nuo publikavimo.',
          details: ['Automatinis tikrinimas kas 5 minučių', 'Kainų pokyčių sekimas', 'Archyvuoti skelbimai išsaugomi duomenų bazėje'],
        },
        {
          num: '02',
          title: 'Paieškos filtravimas',
          description: 'Nustatai norimas charakteristikas vieną kartą — sistema filtruoja visus naujus skelbimus automatiškai. Galima sukurti neribotą kiekį skirtingų paieškų.',
          details: ['Markė, modelis, metai, rida, kaina', 'Kėbulo tipas, degalai, pavarų dėžė', 'Specifiniai šaltiniai arba visi iš karto'],
        },
        {
          num: '03',
          title: 'Įspėjimai ir ataskaitos',
          description: 'Kai atsiranda atitinkantis skelbimas — gauni pranešimą iš karto. Nereikia kasdien tikrinti kiekvieną aukcioną rankiniu būdu.',
          details: ['El. pašto pranešimai', 'SMS žinutės (Pro planas)', 'Kasdienė santrauka arba realiu laiku'],
        },
        {
          num: '04',
          title: 'Analizė ir palyginimas',
          description: 'Lyginki skelbimus vienas su kitu, matyki kainų istoriją, sužinoki ar siūloma kaina yra virš ar žemiau rinkos vidurkio.',
          details: ['Kainų grafikas ir istorija', 'Rinkos vidurkis pagal modelį ir metus', 'Eksportas į CSV / Excel'],
        },
      ].map(({ num, title, description, details }) => (
        <div class="bg-white border border-zinc-100 rounded-xl p-8 hover:border-zinc-200 transition-colors">
          <div class="flex gap-6 items-start">
            <span class="text-3xl font-bold text-zinc-100 leading-none shrink-0 pt-0.5">{num}</span>
            <div>
              <h2 class="text-base font-semibold text-zinc-900 mb-2">{title}</h2>
              <p class="text-sm text-zinc-500 leading-relaxed mb-4">{description}</p>
              <ul class="space-y-1.5">
                {details.map(d => (
                  <li class="flex gap-2 items-center text-sm text-zinc-600">
                    <svg class="w-3.5 h-3.5 text-[#0344D3] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}

    </div>
  </section>

  <section class="px-6 py-12">
    <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur-sm">
      <div>
        <p class="text-base font-semibold text-white">Paruošta. Pradėk šiandien.</p>
        <p class="text-sm text-white/60 mt-0.5">Nemokamas planas prieinamas be kredito kortelės.</p>
      </div>
      <div class="flex gap-3 shrink-0">
        <a href="/registracija" class="px-5 py-2.5 bg-brand-gradient hover:opacity-90 text-white text-sm font-medium rounded-lg transition-colors">
          Registruotis nemokamai
        </a>
        <a href="/kainodara" class="px-5 py-2.5 border border-white/30 text-white hover:border-white/60 text-sm rounded-lg transition-colors">
          Kainodara
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
