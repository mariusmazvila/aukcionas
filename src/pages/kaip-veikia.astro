---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kaip veikia — Carbid"
  description="Carbid veikimo principas — kaip renkame duomenis iš aukcionų ir kaip tai padeda rasti geriausias mašinas."
>

  <!-- ══════ HERO ══════ -->
  <section class="bg-white border-b border-zinc-100 px-6 pt-36 pb-20">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row lg:items-end gap-12 lg:gap-24">

        <div class="flex-1">
          <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-400 mb-8">Kaip veikia</p>
          <h1 class="text-5xl sm:text-6xl xl:text-7xl text-zinc-900 leading-[1.02]">
            Aukcionų<br/>stebėjimas.<br/>Automatiškai.
          </h1>
        </div>

        <div class="lg:w-[400px]">
          <p class="text-sm text-zinc-500 leading-relaxed mb-8">
            Automatiškai renkame duomenis iš Lietuvos ir Europos automobilių
            aukcionų, apdorojame juos ir pateikiame vienoje vietoje — kad tu
            galėtum greičiau rasti geriausią sandorį.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="/registracija" class="px-5 py-2.5 bg-black hover:bg-zinc-800 text-white text-sm font-medium transition-colors">
              Pradėti nemokamai
            </a>
            <a href="/kainodara" class="px-5 py-2.5 border border-zinc-200 text-zinc-700 hover:border-zinc-400 text-sm transition-colors">
              Kainodara →
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════ 01 — tekst kairė, foto dešinė ══════ -->
  <section class="flex flex-col lg:flex-row min-h-[600px] border-b border-zinc-100">

    <div class="flex-1 flex flex-col justify-center px-8 lg:px-16 xl:px-24 py-16 bg-white order-2 lg:order-1">
      <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-300 mb-8">01 / 04</p>
      <h2 class="text-4xl xl:text-5xl text-zinc-900 leading-[1.05] mb-6">
        Automatinis<br/>duomenų<br/>rinkimas
      </h2>
      <p class="text-base text-zinc-500 leading-relaxed mb-8 max-w-[420px]">
        Mūsų sistema nuolat tikrina visus prijungtus aukcionus — Autoplius.lt,
        Auto.lt, Mobile.de, AutoScout24 ir kitus. Nauji skelbimai aptinkami per
        kelias minutes nuo publikavimo.
      </p>
      <ul class="space-y-4">
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Automatinis tikrinimas kas 5 minutės
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Kainų pokyčių sekimas realiuoju laiku
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Archyvuoti skelbimai išsaugomi duomenų bazėje
        </li>
      </ul>
    </div>

    <div class="lg:w-[52%] h-72 lg:h-auto bg-zinc-100 overflow-hidden order-1 lg:order-2">
      <img
        src="/images/automatine%20deze.jpg"
        alt="Automatinė pavarų dėžė"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>

  </section>

  <!-- ══════ 02 — foto kairė, tekstas dešinė ══════ -->
  <section class="flex flex-col lg:flex-row min-h-[600px] border-b border-zinc-100">

    <div class="lg:w-[52%] h-72 lg:h-auto bg-zinc-100 overflow-hidden">
      <img
        src="/images/bmw%20masinos.jpg"
        alt="BMW automobiliai"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>

    <div class="flex-1 flex flex-col justify-center px-8 lg:px-16 xl:px-24 py-16 bg-white">
      <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-300 mb-8">02 / 04</p>
      <h2 class="text-4xl xl:text-5xl text-zinc-900 leading-[1.05] mb-6">
        Tikslus<br/>filtravimas
      </h2>
      <p class="text-base text-zinc-500 leading-relaxed mb-8 max-w-[420px]">
        Nustatai norimas charakteristikas vieną kartą — sistema filtruoja visus
        naujus skelbimus automatiškai. Galima sukurti neribotą kiekį skirtingų
        paieškų.
      </p>
      <ul class="space-y-4">
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Markė, modelis, metai, rida, kaina
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Kėbulo tipas, degalai, pavarų dėžė
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Specifiniai šaltiniai arba visi iš karto
        </li>
      </ul>
    </div>

  </section>

  <!-- ══════ 03 — juodas tekstas kairė, foto dešinė ══════ -->
  <section class="flex flex-col lg:flex-row min-h-[600px] border-b border-zinc-100">

    <div class="flex-1 flex flex-col justify-center px-8 lg:px-16 xl:px-24 py-16 bg-zinc-950 order-2 lg:order-1">
      <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-700 mb-8">03 / 04</p>
      <h2 class="text-4xl xl:text-5xl text-white leading-[1.05] mb-6">
        AI rinkos<br/>analizė
      </h2>
      <p class="text-base text-zinc-400 leading-relaxed mb-8 max-w-[420px]">
        Kiekvienam skelbimui skaičiuojame rinkos vertę, remonto riziką ir
        maksimalų pelningą statymą — remiantis panašių automobilių duomenimis
        iš kelių aukcionų.
      </p>
      <ul class="space-y-4">
        <li class="flex gap-4 items-start text-base text-zinc-400">
          <span class="mt-[11px] w-5 border-t border-zinc-700 shrink-0"></span>
          Rinkos vertė pagal panašius skelbimus
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-400">
          <span class="mt-[11px] w-5 border-t border-zinc-700 shrink-0"></span>
          AI žalos analizė iš nuotraukų
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-400">
          <span class="mt-[11px] w-5 border-t border-zinc-700 shrink-0"></span>
          Pelno balas 0–100 kiekvienam automobiliui
        </li>
      </ul>
    </div>

    <div class="lg:w-[52%] h-72 lg:h-auto bg-zinc-100 overflow-hidden order-1 lg:order-2">
      <img
        src="/images/masinos%20grazios.jpg"
        alt="Automobiliai"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>

  </section>

  <!-- ══════ 04 — foto kairė, tekstas dešinė ══════ -->
  <section class="flex flex-col lg:flex-row min-h-[600px]">

    <div class="lg:w-[52%] h-72 lg:h-auto bg-zinc-100 overflow-hidden">
      <img
        src="/images/mercedes%20%20masina.jpg"
        alt="Mercedes automobilis"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>

    <div class="flex-1 flex flex-col justify-center px-8 lg:px-16 xl:px-24 py-16 bg-white">
      <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-300 mb-8">04 / 04</p>
      <h2 class="text-4xl xl:text-5xl text-zinc-900 leading-[1.05] mb-6">
        Pelno<br/>skaičiavimas
      </h2>
      <p class="text-base text-zinc-500 leading-relaxed mb-8 max-w-[420px]">
        Lyginki skelbimus vienas su kitu, matyki kainų istoriją, sužinoki ar
        siūloma kaina yra virš ar žemiau rinkos vidurkio. Apskaičiuojame
        maksimalų statymą, kuriame dar lieka pelnas.
      </p>
      <ul class="space-y-4">
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Kainų grafikas ir istorija
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Rinkos vidurkis pagal modelį ir metus
        </li>
        <li class="flex gap-4 items-start text-base text-zinc-500">
          <span class="mt-[11px] w-5 border-t border-zinc-300 shrink-0"></span>
          Eksportas į CSV / Excel
        </li>
      </ul>
    </div>

  </section>

  <!-- ══════ CTA ══════ -->
  <section class="bg-zinc-950 border-t border-zinc-900 px-6 py-20">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-start lg:items-center justify-between gap-10">
      <div>
        <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-600 mb-5">Pradėk šiandien</p>
        <h2 class="text-3xl xl:text-4xl text-white leading-[1.08]">
          Paruošta.<br/>Nemokama registracija.
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="/registracija" class="px-6 py-3 bg-white hover:bg-zinc-100 text-black text-sm font-medium transition-colors">
          Registruotis nemokamai
        </a>
        <a href="/kainodara" class="px-6 py-3 border border-zinc-700 hover:border-zinc-500 text-zinc-300 text-sm transition-colors">
          Kainodara
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
