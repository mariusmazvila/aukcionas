---
// Serverio klaidos puslapis.
// SSG (statiniame) režime tikros 500 klaidos nekyla tiesiai iš puslapių —
// jos gali atsirasti Netlify edge lygyje (pvz. CDN problemos).
//
// Netlify konfigūracija (netlify.toml) šiam puslapiui:
//   Jei norite naudoti kaip custom 5xx puslapį, pridėkite į netlify.toml:
//
//   [[redirects]]
//     from = "/*"
//     to = "/500"
//     status = 500
//     conditions = {Status = ["5xx"]}
//
// Pastaba: Netlify Pro/Enterprise planuose galima konfigūruoti Custom error pages
// per Netlify dashboard. Free plane naudokite redirect taisyklę aukščiau.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Serverio klaida"
  description="Įvyko nenumatyta klaida. Bandykite vėliau."
  noindex={true}
>
  <main class="min-h-[70vh] flex items-center py-20 px-4">
    <div class="max-w-lg mx-auto text-center">

      <!-- Vizualinis akcentas -->
      <div class="mb-8">
        <p
          class="text-[120px] sm:text-[160px] font-black text-gray-100 leading-none select-none"
          aria-hidden="true"
        >
          500
        </p>
        <div class="-mt-6">
          <!-- Klaidos ikona -->
          <div class="mx-auto w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-red-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">
            Serverio klaida
          </h1>
          <p class="mt-3 text-gray-600 leading-relaxed max-w-sm mx-auto">
            Įvyko nenumatyta techninė klaida. Atsiprašome už nepatogumus —
            mūsų komanda jau apie tai informuota.
          </p>
        </div>
      </div>

      <!-- Veiksmai -->
      <div class="space-y-3">
        <div class="flex flex-wrap justify-center gap-3">
          <Button variant="primary" href="/">
            Grįžti į pagrindinį
          </Button>
          <button
            type="button"
            onclick="window.location.reload()"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-gray-200
                   text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors
                   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Bandyti dar kartą
          </button>
        </div>
        <p class="text-sm text-gray-500">
          Problema tęsiasi?{' '}
          <a href="/kontaktai" class="text-blue-600 hover:underline">Susisiekite su mumis</a>.
        </p>
      </div>

    </div>
  </main>
</BaseLayout>
