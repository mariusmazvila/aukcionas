---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Registracija — Carbid" noindex={true}>

  <div class="min-h-screen flex flex-col lg:flex-row pt-14">

    <!-- ══ LEFT: Forma ══ -->
    <div class="w-full lg:w-[480px] xl:w-[540px] flex flex-col px-10 xl:px-16 pt-10 pb-10 bg-white border-r border-zinc-100">

      <div class="flex-1 flex flex-col justify-center py-8 max-w-sm">
        <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-400 mb-6">Registracija</p>
        <h1 class="text-3xl text-zinc-900 mb-2">Pradėk nemokamai.</h1>
        <p class="text-sm text-zinc-500 mb-10">
          Jau turi paskyrą?{' '}
          <a href="/prisijungti" class="text-zinc-900 underline underline-offset-2 hover:text-zinc-600 transition-colors">
            Prisijungti
          </a>
        </p>

        <form class="space-y-4" method="POST" action="#">

          <div>
            <label for="name" class="block text-[10px] uppercase tracking-[0.12em] text-zinc-500 mb-2">
              Vardas
            </label>
            <input
              id="name" type="text" name="name" autocomplete="name" required minlength="2"
              class="w-full px-4 py-3 bg-white border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition-colors"
              placeholder="Vardas Pavardė"
            />
          </div>

          <div>
            <label for="email" class="block text-[10px] uppercase tracking-[0.12em] text-zinc-500 mb-2">
              El. paštas
            </label>
            <input
              id="email" type="email" name="email" autocomplete="email" required
              class="w-full px-4 py-3 bg-white border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition-colors"
              placeholder="vardas@imone.lt"
            />
          </div>

          <div>
            <label for="password" class="block text-[10px] uppercase tracking-[0.12em] text-zinc-500 mb-2">
              Slaptažodis
            </label>
            <input
              id="password" type="password" name="password" autocomplete="new-password" required minlength="8"
              class="w-full px-4 py-3 bg-white border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition-colors"
              placeholder="Mažiausiai 8 simboliai"
            />
          </div>

          <button type="submit" class="w-full py-3 bg-zinc-shine hover:opacity-90 text-white text-sm font-medium transition-opacity mt-1">
            Registruotis nemokamai
          </button>

        </form>

        <p class="text-xs text-zinc-400 mt-6 leading-relaxed">
          Kurdamas paskyrą sutinki su{' '}
          <a href="/salygos" class="hover:text-zinc-600 transition-colors underline underline-offset-2">naudojimosi sąlygomis</a>.
        </p>
      </div>

      <p class="text-xs text-zinc-400">
        <a href="/privatumas" class="hover:text-zinc-600 transition-colors">Privatumo politika</a>
        {' · '}
        <a href="/salygos" class="hover:text-zinc-600 transition-colors">Sąlygos</a>
      </p>

    </div>

    <!-- ══ RIGHT: Besisukantys faktai ══ -->
    <div class="hidden lg:flex flex-1 bg-zinc-950 flex-col justify-center px-16 xl:px-24">

      <!-- Progress bar -->
      <div class="w-full h-px bg-zinc-800 mb-16 overflow-hidden">
        <div id="fact-progress" class="h-full bg-zinc-500" style="width:0%;"></div>
      </div>

      <!-- Rotating content -->
      <div id="fact-content" style="transition:opacity 0.45s ease;">
        <p id="fact-label" class="text-[10px] uppercase tracking-[0.22em] text-zinc-500 mb-8">
          Ar žinojai?
        </p>
        <h2 id="fact-heading" class="text-4xl xl:text-5xl text-white font-light leading-[1.2] max-w-xl">
          Pirkdamas iš užsienio aukciono sutaupi vidutiniškai 15–30%.
        </h2>
      </div>

      <!-- Dot indicators -->
      <div class="flex gap-2 mt-14" id="fact-dots">
        {[0,1,2,3,4].map(i => (
          <div class:list={['fact-dot w-1.5 h-1.5 transition-colors duration-300', i === 0 ? 'bg-zinc-400' : 'bg-zinc-700']}></div>
        ))}
      </div>

    </div>

  </div>

</BaseLayout>

<script>
  const INTERVAL = 4800;

  const facts: { label: string; heading: string }[] = [
    { label: 'Ar žinojai?',  heading: 'Perkant iš užsienio aukciono vidutiniškai sutaupoma 15–30%.' },
    { label: 'Greitis',      heading: 'Geriausi sandoriai aukcionuose dingsta vos per kelias minutes.' },
    { label: 'Pelnas',       heading: 'Vidutinis perpardavimo pelnas iš vieno automobilio — 2 000 €.' },
    { label: 'Rinka',        heading: 'Mobile.de vienu metu skelbiama per 1,4 mln. automobilių.' },
    { label: 'Sprendimas',   heading: 'Su Carbid žinai rinkos vertę dar prieš pradedant statyti.' },
  ];

  const content  = document.getElementById('fact-content') as HTMLElement | null;
  const label    = document.getElementById('fact-label')   as HTMLElement | null;
  const heading  = document.getElementById('fact-heading') as HTMLElement | null;
  const progress = document.getElementById('fact-progress') as HTMLElement | null;
  const dots     = document.querySelectorAll<HTMLElement>('.fact-dot');
  let idx = 0;

  function startProgress() {
    if (!progress) return;
    progress.style.transition = 'none';
    progress.style.width = '0%';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      progress.style.transition = `width ${INTERVAL}ms linear`;
      progress.style.width = '100%';
    }));
  }

  function updateDots(active: number) {
    dots.forEach((d, i) => {
      d.classList.toggle('bg-zinc-400', i === active);
      d.classList.toggle('bg-zinc-700', i !== active);
    });
  }

  function nextFact() {
    if (!content || !label || !heading) return;
    content.style.opacity = '0';
    setTimeout(() => {
      idx = (idx + 1) % facts.length;
      label.textContent   = facts[idx].label;
      heading.textContent = facts[idx].heading;
      content.style.opacity = '1';
      updateDots(idx);
      startProgress();
    }, 450);
  }

  startProgress();
  setInterval(nextFact, INTERVAL);
</script>
