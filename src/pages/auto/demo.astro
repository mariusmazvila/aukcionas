---
import BaseLayout from '../../layouts/BaseLayout.astro';

const car = {
  make: 'Volkswagen', model: 'Golf 1.6 TDI', year: 2018,
  km: 187000, fuel: 'Dyzelis', transmission: 'Automatinė',
  source: 'Mobile.de', currentBid: 8200, maxBid: 8900,
  endsIn: '2d 14val',
  profit: { min: 700, max: 1800 },
  profitScore: 72,
  status: 'maybe' as const,
};

const statusMap = {
  buy:   { label: 'PIRKTI',  bg: 'bg-emerald-100', text: 'text-emerald-700', accent: '#10b981', msg: 'Stiprus pirkimo signalas' },
  maybe: { label: 'GALBŪT', bg: 'bg-amber-100',   text: 'text-amber-700',   accent: '#f59e0b', msg: 'Vidutinis potencialas'   },
  avoid: { label: 'VENGTI',  bg: 'bg-red-100',     text: 'text-red-700',     accent: '#ef4444', msg: 'Didelė rizika'           },
};

const s = statusMap[car.status];
const r = 38;
const circ = +(2 * Math.PI * r).toFixed(1);
const dash = +((1 - car.profitScore / 100) * circ).toFixed(1);

const costs = [
  { label: 'Dabartinis statymas',           value: '€8,200',         type: 'item'  },
  { label: 'Aukciono mokesčiai',             value: '€420',           type: 'item'  },
  { label: 'Transportas į Lietuvą',          value: '€650',           type: 'item'  },
  { label: 'Remonto sąnaudos (est.)',         value: '€1,200–€2,400',  type: 'item'  },
  { label: 'Paruošimas / detailing',         value: '€250',           type: 'item'  },
  { label: 'Saugos rezervas',                value: '€500',           type: 'item'  },
  { label: 'Iš viso (landed cost)',           value: '€10,970–€12,170',type: 'total' },
  { label: 'Tikėtina pardavimo kaina LT',    value: '€12,500–€13,700',type: 'total' },
  { label: 'Apskaičiuotas pelnas',            value: '€700–€1,800',    type: 'profit'},
];

const scenarios = [
  { profit: 500,  maxBid: 9300, featured: false },
  { profit: 1000, maxBid: 8800, featured: true  },
  { profit: 1500, maxBid: 8300, featured: false },
];

const damage = [
  { title: 'Priekinio bamperio pažeidimai',         detail: 'Matomi susidūrimo žymiai, galimas plastiko ar metalo deformavimas.',         sev: 'high'   },
  { title: 'Kairiojo žibinto rizika',                detail: 'Galimai pažeistas žibinto korpusas arba tvirtinimas.',                        sev: 'medium' },
  { title: 'Galimas radiatoriaus atramų pažeidimas', detail: 'Stiprus priekinis smūgis gali paveikti radiatorius ir oro paėmimo mazgą.',     sev: 'medium' },
  { title: 'Parkavimo sensoriai / radaras',          detail: 'Bamperio keitimas gali reikalauti jutiklių ir radaro kalibravimo.',            sev: 'low'    },
  { title: 'Variklio dangčio ir sparno lygiavimas', detail: 'Rekomenduojama kėbulo tikrinimo paslauga prieš pirkimą.',                      sev: 'medium' },
];

const market = [
  { label: 'Min. rinkos kaina',   value: '€9,500',  pct: 54 },
  { label: 'Greitas pardavimas',  value: '€10,500', pct: 62 },
  { label: 'Rinkos mediana',      value: '€11,800', pct: 71 },
  { label: 'Optimistinė kaina',   value: '€13,700', pct: 83 },
];
---

<BaseLayout title={`${car.make} ${car.model} ${car.year} — AutoBid analizė`} noindex={true} solidHeader={true}>
<div class="min-h-screen bg-zinc-50">

  <!-- Top bar -->
  <div class="bg-white border-b border-zinc-200 px-6 py-3 sticky top-0 z-10">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-sm">
      <a id="back-btn" href="/rezultatai" class="text-zinc-500 hover:text-zinc-800 transition-colors flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Rezultatai
      </a>
      <span class="text-zinc-300">/</span>
      <span id="car-breadcrumb" class="text-zinc-700 font-medium">{car.make} {car.model} {car.year}</span>
      <span class="ml-auto text-xs text-zinc-400 bg-zinc-100 px-2 py-0.5 rounded-md">Demo</span>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">

    <!-- Vehicle photo — only the first image is shown (privacy); the "+N" badge
         links to the original auction listing for the rest. Filled by fillReal. -->
    <div id="car-photo-wrap" class="hidden relative mb-6 w-full sm:max-w-md rounded-2xl overflow-hidden border border-zinc-200 bg-zinc-100">
      <img id="car-photo" src="" alt="" class="w-full aspect-[4/3] object-cover" />
      <a id="car-photo-more" href="#" target="_blank" rel="noopener noreferrer"
         title="Visos nuotraukos originaliame skelbime"
         class="hidden absolute bottom-3 right-3 items-center gap-1.5 pl-2.5 pr-3 py-1.5 rounded-lg bg-black/60 hover:bg-black/75 text-white text-sm font-semibold backdrop-blur-sm transition-colors">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span id="car-photo-more-label">nuotraukos</span>
      </a>
    </div>

    <!-- ── HERO ROW ── -->
    <div class="flex flex-col lg:flex-row lg:items-start gap-6 mb-8">

      <!-- Left -->
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span id="car-source" class="bg-sky-100 text-sky-700 text-xs font-medium px-2 py-0.5 rounded-md">{car.source}</span>
          <span class="bg-zinc-100 text-zinc-600 text-xs font-medium px-2 py-0.5 rounded-md">Aukcionas</span>
          <span class:list={['text-xs font-bold px-2.5 py-0.5 rounded-md tracking-wide', s.bg, s.text]}>
            {s.label}
          </span>
        </div>

        <h1 id="car-title" class="text-3xl sm:text-4xl font-bold text-zinc-900 leading-tight mb-1">
          {car.make} {car.model}
        </h1>
        <p id="car-subtitle" class="text-zinc-400 text-sm mb-6">
          {car.year} · {car.km.toLocaleString('lt-LT')} km · {car.fuel} · {car.transmission} · DE → LT
        </p>

        <!-- Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
          <div class="bg-white border border-zinc-200 rounded-xl p-4">
            <p class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider mb-1">Dabar. kaina</p>
            <p id="car-price" class="text-xl font-bold text-zinc-900">€{car.currentBid.toLocaleString('lt-LT')}</p>
          </div>
          <div class="bg-brand-gradient rounded-xl p-4">
            <p class="text-[10px] text-blue-200 font-semibold uppercase tracking-wider mb-1">
              Maks. statymas <span id="demo-maxbid" class="ml-0.5 text-[8px] bg-white/20 text-white px-1 py-0.5 rounded align-middle">DEMO</span>
            </p>
            <p id="m-maxbid" class="text-xl font-bold text-white">€{car.maxBid.toLocaleString('lt-LT')}</p>
          </div>
          <div class="bg-white border border-zinc-200 rounded-xl p-4">
            <p class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider mb-1">
              Baigiasi per <span id="ends-demo" class="ml-0.5 text-[8px] bg-amber-100 text-amber-700 px-1 py-0.5 rounded align-middle">DEMO</span>
            </p>
            <p id="car-ends" class="text-xl font-bold text-zinc-900">{car.endsIn}</p>
          </div>
          <div class="bg-white border border-zinc-200 rounded-xl p-4">
            <p class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider mb-1">
              Est. pelnas <span id="demo-profit" class="ml-0.5 text-[8px] bg-amber-100 text-amber-700 px-1 py-0.5 rounded align-middle">DEMO</span>
            </p>
            <p id="m-profit" class="text-sm font-bold text-emerald-600">€{car.profit.min}–€{car.profit.max}</p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap gap-3">
          <a id="auction-link" href="#" target="_blank" rel="noopener noreferrer"
             class="hidden items-center gap-2 px-4 py-2.5 bg-brand-gradient hover:opacity-90 text-white text-sm font-medium rounded-lg transition-colors">
            Peržiūrėti aukcione
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
            </svg>
          </a>
          <button class="flex items-center gap-2 px-4 py-2.5 bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-medium rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
            Pridėti į stebėjimą
          </button>
          <button class="flex items-center gap-2 px-4 py-2.5 bg-white border border-zinc-300 hover:border-zinc-400 text-zinc-700 text-sm font-medium rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            Eksportuoti ataskaitą
          </button>
        </div>
      </div>

      <!-- Right: Profit score -->
      <div class="flex flex-col items-center shrink-0 lg:pt-6">
        <div class="relative w-36 h-36">
          <svg viewBox="0 0 100 100" class="w-full h-full" style="transform:rotate(-90deg)">
            <circle cx="50" cy="50" r={r} fill="none" stroke="#e4e4e7" stroke-width="9"/>
            <circle id="score-ring" cx="50" cy="50" r={r} fill="none" stroke={s.accent} stroke-width="9"
              stroke-dasharray={circ} stroke-dashoffset={dash} stroke-linecap="round"/>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span id="m-score" class="text-4xl font-bold text-zinc-900">{car.profitScore}</span>
            <span class="text-xs text-zinc-400">/ 100</span>
          </div>
        </div>
        <p class="text-xs text-zinc-500 mt-2 font-medium">
          Pelno balas <span id="demo-score" class="ml-0.5 text-[8px] bg-amber-100 text-amber-700 px-1 py-0.5 rounded align-middle">DEMO</span>
        </p>
        <p id="score-msg" class:list={['text-xs mt-0.5 font-medium', s.text]}>{s.msg}</p>
      </div>

    </div>

    <!-- ── SECTIONS ── -->
    <div class="space-y-5">

      <!-- 0. Real scraped vehicle data — filled client-side from Supabase by id.
           Hidden until a listing is loaded; everything here is real (no DEMO). -->
      <section id="real-specs" class="hidden bg-white border border-zinc-200 rounded-2xl p-6">
        <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-5">Automobilio duomenys</h2>
        <dl id="real-specs-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-4 text-sm"></dl>
      </section>

      <!-- Real on-demand profit analysis (A+B): market value from our own
           comparables + the reseller's own cost params (localStorage). -->
      <section class="bg-white border border-zinc-200 rounded-2xl p-6">
        <div class="flex items-center justify-between gap-4 mb-1">
          <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest">Pelno analizė</h2>
          <button id="toggle-costs" type="button" class="text-xs text-[#0344D3] hover:underline">Mano kaštai</button>
        </div>
        <p class="text-xs text-zinc-400 mb-4">Skaičiuojama iš panašių skelbimų mūsų bazėje ir tavo nurodytos savikainos.</p>

        <!-- Reseller cost params — saved to localStorage, used by the formula. -->
        <div id="cost-panel" class="hidden grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4 p-4 bg-zinc-50 border border-zinc-100 rounded-xl">
          <label class="text-[11px] text-zinc-500 font-medium">Aukciono mokestis, %
            <input id="p-fee" type="number" min="0" step="0.5" class="mt-1 w-full px-2.5 py-1.5 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:outline-none focus:border-[#0344D3]" />
          </label>
          <label class="text-[11px] text-zinc-500 font-medium">Transportas, €
            <input id="p-transport" type="number" min="0" step="50" class="mt-1 w-full px-2.5 py-1.5 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:outline-none focus:border-[#0344D3]" />
          </label>
          <label class="text-[11px] text-zinc-500 font-medium">Remontas, €
            <input id="p-repair" type="number" min="0" step="50" class="mt-1 w-full px-2.5 py-1.5 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:outline-none focus:border-[#0344D3]" />
          </label>
          <label class="text-[11px] text-zinc-500 font-medium">Paruošimas, €
            <input id="p-prep" type="number" min="0" step="50" class="mt-1 w-full px-2.5 py-1.5 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:outline-none focus:border-[#0344D3]" />
          </label>
          <label class="text-[11px] text-zinc-500 font-medium">Saugos rezervas, €
            <input id="p-reserve" type="number" min="0" step="50" class="mt-1 w-full px-2.5 py-1.5 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:outline-none focus:border-[#0344D3]" />
          </label>
          <label class="text-[11px] text-zinc-500 font-medium">Norimas pelnas, €
            <input id="p-target" type="number" min="0" step="100" class="mt-1 w-full px-2.5 py-1.5 border border-zinc-300 rounded-lg text-sm text-zinc-900 focus:outline-none focus:border-[#0344D3]" />
          </label>
          <div class="col-span-2 sm:col-span-3 flex justify-end">
            <button id="save-costs" type="button" class="px-3 py-1.5 text-xs font-semibold bg-zinc-900 hover:bg-zinc-800 text-white rounded-lg transition-colors">Išsaugoti kaštus</button>
          </div>
        </div>

        <button id="run-analysis" type="button" class="w-full py-3 bg-brand-gradient hover:opacity-90 text-white text-sm font-semibold rounded-xl transition-colors">
          Išsami analizė
        </button>

        <div id="analysis-results" class="hidden mt-5"></div>
        <p id="analysis-error" class="hidden mt-3 text-sm text-amber-700"></p>
      </section>

      <!-- 1. Summary recommendation -->
      <section class="bg-white border border-zinc-200 rounded-2xl p-6">
        <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-4">Rekomendacija <span class="ml-1.5 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded align-middle">DEMO</span></h2>
        <div class="border-l-4 border-amber-300 pl-4 py-1">
          <p class="text-base text-zinc-800 leading-relaxed">
            Potencialiai pelningas sandoris, tačiau verta statyti ne daugiau nei
            <strong class="text-zinc-900">€8,900</strong>. Priekinė kairė pusė su pažeidimais kelia vidutinę
            remonto riziką. Rekomenduojama tiksliai suplanuoti remonto biudžetą prieš dalyvaujant aukcione.
          </p>
        </div>
      </section>

      <!-- 2. Financial breakdown -->
      <section class="bg-white border border-zinc-200 rounded-2xl p-6">
        <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-5">Finansinė analizė <span class="ml-1.5 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded align-middle">DEMO</span></h2>
        <div>
          {costs.map(row => (
            <div class:list={[
              'flex items-center justify-between py-3',
              row.type !== 'profit' ? 'border-b' : '',
              row.type === 'item'   ? 'border-zinc-100' : 'border-zinc-200',
            ]}>
              <span class:list={[
                'text-sm',
                row.type === 'item'   ? 'text-zinc-600'         : '',
                row.type === 'total'  ? 'text-zinc-800 font-semibold' : '',
                row.type === 'profit' ? 'text-zinc-900 font-bold text-base mt-1 block' : '',
              ]}>{row.label}</span>
              <span class:list={[
                'text-sm font-medium tabular-nums',
                row.type === 'item'   ? 'text-zinc-700'         : '',
                row.type === 'total'  ? 'text-zinc-900 font-semibold' : '',
                row.type === 'profit' ? 'text-emerald-600 font-bold text-base' : '',
              ]}>{row.value}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. Max bid calculator -->
      <section class="bg-white border border-zinc-200 rounded-2xl p-6">
        <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-5">Maksimalaus statymo skaičiuoklė <span class="ml-1.5 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded align-middle">DEMO</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {scenarios.map(sc => (
            <div class:list={[
              'rounded-xl border-2 p-5 text-center transition-shadow',
              sc.featured ? 'border-[#0344D3] bg-blue-50' : 'border-zinc-200',
            ]}>
              <p class:list={[
                'text-[10px] font-bold uppercase tracking-widest mb-3',
                sc.featured ? 'text-[#0344D3]' : 'text-zinc-400',
              ]}>
                {sc.featured ? '★ Rekomenduojamas' : 'Scenarijus'}
              </p>
              <p class="text-[11px] text-zinc-500 mb-0.5">Norimas pelnas</p>
              <p class="text-3xl font-bold text-zinc-900 mb-4">€{sc.profit}</p>
              <div class:list={['rounded-xl p-3', sc.featured ? 'bg-brand-gradient' : 'bg-zinc-100']}>
                <p class:list={['text-[10px] mb-1', sc.featured ? 'text-blue-200' : 'text-zinc-500']}>Maks. statymas</p>
                <p class:list={['text-2xl font-bold', sc.featured ? 'text-white' : 'text-zinc-900']}>
                  €{sc.maxBid.toLocaleString('lt-LT')}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Damage analysis -->
      <section class="bg-white border border-zinc-200 rounded-2xl p-6">
        <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-5">
          Žalos analizė <span id="demo-damage" class="ml-1.5 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded align-middle">DEMO</span>
        </h2>

        <!-- Real AI results (filled by "Išsami analizė"); hidden until then -->
        <div id="damage-results" class="hidden"></div>
        <p id="damage-error" class="hidden text-sm text-amber-700 mb-3"></p>

        <!-- Demo placeholder — hidden once real analysis runs -->
        <div id="damage-demo" class="space-y-3">
          {damage.map(d => (
            <div class="flex items-start gap-4 p-4 border border-zinc-100 rounded-xl hover:border-zinc-200 transition-colors">
              <div class:list={[
                'mt-1 w-2.5 h-2.5 rounded-full shrink-0',
                d.sev === 'high' ? 'bg-red-500' : d.sev === 'medium' ? 'bg-amber-400' : 'bg-emerald-400',
              ]}/>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <p class="text-sm font-semibold text-zinc-800">{d.title}</p>
                  <span class:list={[
                    'text-xs font-semibold px-2 py-0.5 rounded-md',
                    d.sev === 'high'   ? 'bg-red-100 text-red-700'     :
                    d.sev === 'medium' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700',
                  ]}>
                    {d.sev === 'high' ? 'Didelė' : d.sev === 'medium' ? 'Vidutinė' : 'Maža'} rizika
                  </span>
                </div>
                <p class="text-xs text-zinc-500 leading-relaxed">{d.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. Market comparison -->
      <section class="bg-white border border-zinc-200 rounded-2xl p-6">
        <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-5">Rinkos palyginimas (LT) <span class="ml-1.5 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded align-middle">DEMO</span></h2>
        <div class="space-y-3 mb-4">
          {market.map(m => (
            <div class="flex items-center gap-3">
              <span class="text-xs text-zinc-500 w-36 shrink-0">{m.label}</span>
              <div class="flex-1 h-4 bg-zinc-100 rounded-full overflow-hidden">
                <div class="h-full rounded-full bg-brand-gradient opacity-75 transition-all" style={`width:${m.pct}%`}/>
              </div>
              <span class="text-xs font-semibold text-zinc-800 w-16 text-right tabular-nums">{m.value}</span>
            </div>
          ))}
        </div>
        <p class="text-xs text-zinc-400">Šaltinis: Autoplius.lt, Auto.lt · Panašūs modeliai ±20 000 km, ±2 metai</p>
      </section>

      <!-- 6. Liquidity / demand -->
      <section class="bg-white border border-zinc-200 rounded-2xl p-6">
        <h2 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-5">Paklausa ir likvidumas <span class="ml-1.5 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded align-middle">DEMO</span></h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
          <div>
            <p class="text-xs text-zinc-400 mb-1">Paklausa LT</p>
            <p class="text-sm font-bold text-emerald-600">Didelė ↑</p>
          </div>
          <div>
            <p class="text-xs text-zinc-400 mb-1">Vid. dienos rinkoje</p>
            <p class="text-sm font-bold text-zinc-800">21–35 d.</p>
          </div>
          <div>
            <p class="text-xs text-zinc-400 mb-1">Populiari konfigūracija</p>
            <p class="text-sm font-bold text-zinc-800">Dyzelis, 1.6</p>
          </div>
          <div>
            <p class="text-xs text-zinc-400 mb-1">Aktyvūs skelbimai LT</p>
            <p class="text-sm font-bold text-zinc-800">34</p>
          </div>
        </div>
      </section>

      <!-- 7. AI notes -->
      <section class="bg-zinc-900 rounded-2xl p-6">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-full bg-zinc-800 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8.25 7.5c0-2.485 1.686-4.5 3.75-4.5s3.75 2.015 3.75 4.5c0 1.74-.913 3.25-2.25 4.103V13.5a1.5 1.5 0 01-3 0v-1.897C8.913 10.75 8.25 9.24 8.25 7.5z"/>
            </svg>
          </div>
          <div>
            <p class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">DI pastabos <span class="ml-1.5 text-[9px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded align-middle">DEMO</span></p>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Ši analizė parengta remiantis aukciono duomenimis, matomais pažeidimais ir rinkos palyginimu.
              Prieš dalyvaudami aukcione visada apžiūrėkite transporto priemonę arba paprašykite profesionalios
              patikros. AutoBid neatsako už galutinius pirkimo sprendimus.
            </p>
          </div>
        </div>
      </section>

    </div>
  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { analyze, DEFAULT_PARAMS, defaultRepairForCondition, type CostParams, type AnalysisResult } from '../../lib/analysis';

  const p = new URLSearchParams(window.location.search);
  const make   = p.get('make')   || '';
  const model  = p.get('model')  || '';
  const year   = p.get('year')   || '';
  const km     = p.get('km')     || '';
  const price  = p.get('price')  || '';
  const source = p.get('source') || '';

  const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const sb = sbUrl && sbKey ? createClient(sbUrl, sbKey) : null;
  let currentListing: any = null;

  const backBtn = document.getElementById('back-btn') as HTMLAnchorElement | null;
  if (backBtn && document.referrer && new URL(document.referrer).pathname.startsWith('/rezultatai')) {
    backBtn.href = document.referrer;
  }

  // Real auction end date (scraped) → live countdown, replacing the demo value.
  const end = p.get('end') || '';
  const endDate = end ? new Date(end) : null;
  if (endDate && !isNaN(endDate.getTime())) {
    const endsEl = document.getElementById('car-ends');
    const ms = endDate.getTime() - Date.now();
    if (endsEl) {
      if (ms > 0) {
        const d = Math.floor(ms / 86400000);
        const h = Math.floor((ms % 86400000) / 3600000);
        endsEl.textContent = d > 0 ? `${d}d ${h}val` : `${h}val`;
      } else {
        endsEl.textContent = 'Pasibaigęs';
      }
    }
    // Real data now — drop the DEMO marker on this metric.
    document.getElementById('ends-demo')?.remove();
  }

  // Original auction link — only shown when the card passed a valid http(s) url.
  const auctionUrl = p.get('url') || '';
  if (/^https?:\/\//i.test(auctionUrl)) {
    const link = document.getElementById('auction-link') as HTMLAnchorElement | null;
    if (link) {
      link.href = auctionUrl;
      link.classList.remove('hidden');
      link.classList.add('inline-flex');
    }
  }

  if (make || model) {
    const title = [make, model].filter(Boolean).join(' ');
    const titleEl = document.getElementById('car-title');
    const breadEl = document.getElementById('car-breadcrumb');
    if (titleEl) titleEl.textContent = title;
    if (breadEl) breadEl.textContent = [title, year].filter(Boolean).join(' ');

    const subtitleParts: string[] = [];
    if (year) subtitleParts.push(year);
    if (km)   subtitleParts.push(Number(km).toLocaleString('lt-LT') + ' km');
    const subtitleEl = document.getElementById('car-subtitle');
    if (subtitleEl && subtitleParts.length) subtitleEl.textContent = subtitleParts.join(' · ');

    if (price) {
      const priceEl = document.getElementById('car-price');
      if (priceEl) priceEl.textContent = '€' + Number(price).toLocaleString('lt-LT');
    }

    if (source) {
      const sourceEl = document.getElementById('car-source');
      if (sourceEl) sourceEl.textContent = source;
    }

    document.title = [title, year, '— AutoBid analizė'].filter(Boolean).join(' ');
  }

  // ── Authoritative real data from Supabase (by listing id) ──────────────────
  const id = p.get('id');
  if (id && sb) {
    sb.from('listings').select('*').eq('id', id).single().then(({ data, error }) => {
      if (!error && data) { currentListing = data; fillReal(data); initRepairDefault(data); }
    });
  }

  function fillReal(r: any) {
    const fuelLabel: Record<string, string> = { diesel: 'Dyzelis', petrol: 'Benzinas', electric: 'Elektra', hybrid: 'Hibridas', lpg: 'Dujos (LPG)' };
    const gearLabel: Record<string, string> = { automatic: 'Automatinė', manual: 'Mechaninė' };
    const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '');
    const num = (n: any) => Number(n).toLocaleString('lt-LT');
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => (({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]));
    const fuel = fuelLabel[String(r.fuel_type).toLowerCase()] ?? r.fuel_type ?? null;
    const gear = gearLabel[String(r.transmission).toLowerCase()] ?? r.transmission ?? null;

    // Price with the real scraped currency.
    if (r.price != null) {
      const priceEl = document.getElementById('car-price');
      if (priceEl) {
        let txt: string;
        try { txt = new Intl.NumberFormat('lt-LT', { style: 'currency', currency: r.currency || 'EUR', maximumFractionDigits: 0 }).format(Number(r.price)); }
        catch { txt = num(r.price) + (r.currency ? ' ' + r.currency : ''); }
        priceEl.textContent = txt;
      }
    }

    const title = [r.make, r.model].filter(Boolean).join(' ').trim();
    if (title) {
      document.getElementById('car-title')!.textContent = title;
      document.getElementById('car-breadcrumb')!.textContent = [title, r.year].filter(Boolean).join(' ');
      document.title = [title, r.year, '— AutoBid analizė'].filter(Boolean).join(' ');
    }
    const loc = [r.location_city, r.location_country].filter(Boolean).join(', ');
    const sub = [r.year, r.mileage_km != null ? num(r.mileage_km) + ' km' : null, fuel, gear, loc || null].filter(Boolean).join(' · ');
    if (sub) document.getElementById('car-subtitle')!.textContent = sub;
    if (r.source) document.getElementById('car-source')!.textContent = cap(r.source);

    // Authoritative end-date countdown.
    if (r.auction_end_date) {
      const dt = new Date(r.auction_end_date);
      const endsEl = document.getElementById('car-ends');
      if (!isNaN(dt.getTime()) && endsEl) {
        const ms = dt.getTime() - Date.now();
        if (ms > 0) {
          const d = Math.floor(ms / 86400000), h = Math.floor((ms % 86400000) / 3600000);
          endsEl.textContent = d > 0 ? `${d}d ${h}val` : `${h}val`;
        } else {
          endsEl.textContent = 'Pasibaigęs';
        }
        document.getElementById('ends-demo')?.remove();
      }
    }

    // Auction link.
    if (typeof r.url === 'string' && /^https?:\/\//i.test(r.url)) {
      const link = document.getElementById('auction-link') as HTMLAnchorElement | null;
      if (link) { link.href = r.url; link.classList.remove('hidden'); link.classList.add('inline-flex'); }
    }

    // Full real spec list — only fields that are actually present.
    const fmtDate = (d: string) => { const x = new Date(d); return isNaN(x.getTime()) ? d : x.toLocaleDateString('lt-LT'); };
    const specs: [string, string | null][] = [
      ['Komplektacija', r.trim ?? null],
      ['Kuras', fuel],
      ['Pavarų dėžė', gear],
      ['Variklis', r.engine_cc != null ? num(r.engine_cc) + ' cm³' : null],
      ['CO₂', r.co2_g_km != null ? r.co2_g_km + ' g/km' : null],
      ['Spalva', r.color ?? null],
      ['Kėbulas', r.body_type ?? null],
      ['Būklė', r.condition ?? null],
      ['Pirma registracija', r.first_registration_date ? fmtDate(r.first_registration_date) : null],
      ['Registracija', r.registration ?? null],
      ['VIN', r.vin ?? null],
      ['Vieta', loc || null],
      ['PVM atskaitomas', r.vat_recoverable ?? null],
    ];
    const grid = document.getElementById('real-specs-grid');
    const rows = specs.filter(([, v]) => v != null && String(v).trim() !== '');
    if (grid && rows.length) {
      grid.innerHTML = rows.map(([k, v]) =>
        `<div><dt class="text-[11px] uppercase tracking-wide text-zinc-400 mb-0.5">${k}</dt><dd class="text-zinc-800 font-medium break-words">${esc(String(v))}</dd></div>`
      ).join('');
      document.getElementById('real-specs')?.classList.remove('hidden');
    }

    // Single photo + "+N" badge linking to the auction (we don't show the rest).
    const imgs = Array.isArray(r.image_urls) ? r.image_urls.filter((x: unknown) => typeof x === 'string') : [];
    if (imgs.length) {
      const wrap = document.getElementById('car-photo-wrap');
      const img = document.getElementById('car-photo') as HTMLImageElement | null;
      if (wrap && img) {
        img.alt = title || 'Automobilis';
        img.onerror = () => wrap.classList.add('hidden');
        img.src = imgs[0];
        wrap.classList.remove('hidden');

        const more = imgs.length - 1;
        const moreEl = document.getElementById('car-photo-more') as HTMLAnchorElement | null;
        const labelEl = document.getElementById('car-photo-more-label');
        if (more > 0 && moreEl && labelEl && typeof r.url === 'string' && /^https?:\/\//i.test(r.url)) {
          labelEl.textContent = `+${more} nuotraukos`;
          moreEl.href = r.url;
          moreEl.classList.remove('hidden');
          moreEl.classList.add('inline-flex');
        }
      }
    }
  }

  // ── Reseller cost params (localStorage) ────────────────────────────────────
  const PARAMS_KEY = 'autobid_costs';
  const $ = (id2: string) => document.getElementById(id2) as HTMLInputElement | null;

  function loadParams(): CostParams {
    try { return { ...DEFAULT_PARAMS, ...JSON.parse(localStorage.getItem(PARAMS_KEY) || '{}') }; }
    catch { return { ...DEFAULT_PARAMS }; }
  }
  function paramsToForm(v: CostParams) {
    if ($('p-fee'))       $('p-fee')!.value       = String(v.auctionFeePct);
    if ($('p-transport')) $('p-transport')!.value = String(v.transport);
    if ($('p-repair'))    $('p-repair')!.value    = String(v.repair);
    if ($('p-prep'))      $('p-prep')!.value      = String(v.prep);
    if ($('p-reserve'))   $('p-reserve')!.value   = String(v.reserve);
    if ($('p-target'))    $('p-target')!.value    = String(v.targetProfit);
  }
  function formToParams(): CostParams {
    const n = (id2: string, d: number) => { const v = Number($(id2)?.value); return isFinite(v) && v >= 0 ? v : d; };
    return {
      auctionFeePct: n('p-fee', DEFAULT_PARAMS.auctionFeePct),
      transport:     n('p-transport', DEFAULT_PARAMS.transport),
      repair:        n('p-repair', DEFAULT_PARAMS.repair),
      prep:          n('p-prep', DEFAULT_PARAMS.prep),
      reserve:       n('p-reserve', DEFAULT_PARAMS.reserve),
      targetProfit:  n('p-target', DEFAULT_PARAMS.targetProfit),
    };
  }
  let userParams = loadParams();
  paramsToForm(userParams);

  // Prefill repair estimate from the car's condition the first time only.
  function initRepairDefault(rec: any) {
    if (!localStorage.getItem(PARAMS_KEY) && rec?.condition && $('p-repair')) {
      const rep = defaultRepairForCondition(rec.condition);
      $('p-repair')!.value = String(rep);
      userParams.repair = rep;
    }
  }

  document.getElementById('toggle-costs')?.addEventListener('click', () => {
    document.getElementById('cost-panel')?.classList.toggle('hidden');
  });
  document.getElementById('save-costs')?.addEventListener('click', () => {
    userParams = formToParams();
    localStorage.setItem(PARAMS_KEY, JSON.stringify(userParams));
    document.getElementById('cost-panel')?.classList.add('hidden');
  });

  // ── Run analysis (A+B, client-side) ────────────────────────────────────────
  document.getElementById('run-analysis')?.addEventListener('click', async () => {
    document.getElementById('analysis-error')!.classList.add('hidden');

    const rec = currentListing || {};
    const mk  = rec.make ?? make;
    const md  = rec.model ?? model;
    const yr  = rec.year ?? (year ? Number(year) : null);
    const mil = rec.mileage_km ?? (km ? Number(km) : null);
    const prc = rec.price ?? (price ? Number(price) : null);

    if (!sb) return showErr('Nepavyko prisijungti prie duomenų bazės.');
    if (prc == null || !isFinite(Number(prc))) return showErr('Šis skelbimas neturi kainos — pelno analizė negalima.');
    if (!mk || !md) return showErr('Trūksta markės / modelio analizei.');

    const btn = document.getElementById('run-analysis') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Analizuojama…';

    // 1) AI damage analysis (if photos + key available). It renders the damage
    //    section and feeds the repair estimate into the cost params below.
    await runDamageAnalysis(rec);

    let q = sb.from('listings').select('price, mileage_km, year, source')
      .ilike('make', mk).ilike('model', `%${md}%`).not('price', 'is', null);
    if (yr != null) q = q.gte('year', yr - 1).lte('year', yr + 1);
    const { data: compsRaw, error } = await q.limit(300);

    btn.disabled = false; btn.textContent = 'Perskaičiuoti';
    if (error) return showErr('Nepavyko gauti palyginamų skelbimų.');

    let comps = (compsRaw || []) as any[];
    if (mil != null) comps = comps.filter((c) => c.mileage_km == null || Math.abs(c.mileage_km - mil) <= mil * 0.3);

    userParams = formToParams();
    const a = analyze({ price: Number(prc), mileage_km: mil, comps, params: userParams });
    renderAnalysis(a);
    updateMetrics(a);
  });

  function showErr(msg: string) {
    const errEl = document.getElementById('analysis-error')!;
    errEl.textContent = msg;
    errEl.classList.remove('hidden');
  }

  const eur = (n: number | null) => (n == null ? '—' : '€' + Math.round(n).toLocaleString('lt-LT'));

  function renderAnalysis(a: AnalysisResult) {
    const resEl = document.getElementById('analysis-results')!;
    if (a.resale == null) {
      resEl.innerHTML = `<div class="p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800">Per mažai palyginamų skelbimų rinkos vertei nustatyti. Reikia daugiau šio modelio duomenų bazėje.</div>`;
      resEl.classList.remove('hidden');
      return;
    }
    const confLabel = { low: 'žemas', medium: 'vidutinis', high: 'aukštas' }[a.confidence];
    const profitColor = (a.profit ?? 0) >= 0 ? 'text-emerald-600' : 'text-red-600';
    const rows = a.breakdown.map((b) =>
      `<div class="flex justify-between py-1.5 border-b border-zinc-100 text-sm"><span class="text-zinc-500">${b.label}</span><span class="text-zinc-800 font-medium">${eur(b.value)}</span></div>`
    ).join('');
    resEl.innerHTML = `
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
        <div class="bg-zinc-50 rounded-xl p-3"><p class="text-[10px] text-zinc-400 uppercase tracking-wider mb-1">Rinkos vertė (LT)</p><p class="text-lg font-bold text-zinc-900">${eur(a.resale)}</p></div>
        <div class="bg-zinc-50 rounded-xl p-3"><p class="text-[10px] text-zinc-400 uppercase tracking-wider mb-1">Savikaina</p><p class="text-lg font-bold text-zinc-900">${eur(a.landed)}</p></div>
        <div class="bg-zinc-50 rounded-xl p-3"><p class="text-[10px] text-zinc-400 uppercase tracking-wider mb-1">Pelnas</p><p class="text-lg font-bold ${profitColor}">${eur(a.profit)}</p></div>
        <div class="bg-zinc-50 rounded-xl p-3"><p class="text-[10px] text-zinc-400 uppercase tracking-wider mb-1">Maks. statymas</p><p class="text-lg font-bold text-zinc-900">${eur(a.maxBid)}</p></div>
      </div>
      <div class="mb-4">
        <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2">Savikainos išklotinė</p>
        ${rows}
        <div class="flex justify-between py-2 text-sm font-bold"><span class="text-zinc-700">Iš viso</span><span class="text-zinc-900">${eur(a.landed)}</span></div>
      </div>
      <p class="text-xs text-zinc-400">Pagrįsta ${a.compCount} panašiais skelbimais (${a.resaleBasis === 'LT' ? 'LT rinka' : 'visi šaltiniai'}) · pasitikėjimas: ${confLabel}${a.margin != null ? ` · marža ${(a.margin * 100).toFixed(0)}%` : ''}</p>
    `;
    resEl.classList.remove('hidden');
  }

  function updateMetrics(a: AnalysisResult) {
    if (a.maxBid != null) { const el = document.getElementById('m-maxbid'); if (el) el.textContent = '€' + a.maxBid.toLocaleString('lt-LT'); document.getElementById('demo-maxbid')?.remove(); }
    if (a.profit != null) { const el = document.getElementById('m-profit'); if (el) el.textContent = '€' + a.profit.toLocaleString('lt-LT'); document.getElementById('demo-profit')?.remove(); }
    if (a.score != null) {
      const el = document.getElementById('m-score'); if (el) el.textContent = String(a.score);
      const ring = document.getElementById('score-ring');
      if (ring) { const circ = 2 * Math.PI * 38; ring.setAttribute('stroke-dashoffset', String((1 - a.score / 100) * circ)); }
      document.getElementById('demo-score')?.remove();
      const msg = document.getElementById('score-msg'); if (msg) msg.textContent = a.score >= 70 ? 'Geras potencialas' : a.score >= 45 ? 'Vidutinis potencialas' : 'Didelė rizika';
    }
  }

  // ── AI damage analysis (Stage C) — part of "Išsami analizė" ─────────────────
  // Calls the Supabase Edge Function, renders the damage section, and writes the
  // repair midpoint into the cost params so the profit math includes it.
  // Failures are non-fatal: profit analysis still runs without it.
  async function runDamageAnalysis(rec: any): Promise<void> {
    const errEl = document.getElementById('damage-error')!;
    errEl.classList.add('hidden');
    const imgs = Array.isArray(rec?.image_urls)
      ? rec.image_urls.filter((x: any) => typeof x === 'string' && /^https?:\/\//i.test(x))
      : [];
    if (!sb || !sbUrl || !sbKey || !imgs.length) return; // can't / nothing to analyse — skip silently
    try {
      const resp = await fetch(`${sbUrl}/functions/v1/analyze-damage`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: sbKey, Authorization: `Bearer ${sbKey}` },
        body: JSON.stringify({ images: imgs, make: rec.make, model: rec.model, year: rec.year }),
      });
      const data = await resp.json();
      if (!resp.ok || !data.report) throw new Error(data.error || 'klaida');
      const rep = data.report;
      renderDamage(rep);
      // Feed the repair midpoint into the cost params (used by the profit math).
      const r0 = rep.estimated_repair_eur || {};
      const mid = Math.round(((Number(r0.min) || 0) + (Number(r0.max) || 0)) / 2);
      if (mid > 0 && $('p-repair')) {
        $('p-repair')!.value = String(mid);
        localStorage.setItem(PARAMS_KEY, JSON.stringify({ ...loadParams(), repair: mid }));
      }
    } catch (e: any) {
      errEl.textContent = 'Žalos analizė (DI) nepavyko — pelno analizė atlikta be jos.';
      errEl.classList.remove('hidden');
    }
  }

  function renderDamage(rep: any) {
    const sevLabel: Record<string, string> = { low: 'Maža', medium: 'Vidutinė', high: 'Didelė' };
    const sevDot: Record<string, string> = { low: 'bg-emerald-400', medium: 'bg-amber-400', high: 'bg-red-500' };
    const sevChip: Record<string, string> = { low: 'bg-emerald-100 text-emerald-700', medium: 'bg-amber-100 text-amber-700', high: 'bg-red-100 text-red-700' };
    const esc = (s: any) => String(s).replace(/[&<>"']/g, (c) => (({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]));
    const items = Array.isArray(rep.damages) ? rep.damages : [];
    const r0 = rep.estimated_repair_eur || {};
    const repMin = Number(r0.min) || 0, repMax = Number(r0.max) || 0;
    const rows = items.length
      ? items.map((d: any) => `
        <div class="flex items-start gap-4 p-4 border border-zinc-100 rounded-xl">
          <div class="mt-1 w-2.5 h-2.5 rounded-full shrink-0 ${sevDot[d.severity] || 'bg-zinc-300'}"></div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <p class="text-sm font-semibold text-zinc-800">${esc(d.area)}</p>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-md ${sevChip[d.severity] || 'bg-zinc-100 text-zinc-600'}">${sevLabel[d.severity] || '—'} rizika</span>
              ${d.estimated_cost_eur != null ? `<span class="text-xs text-zinc-500">~€${Number(d.estimated_cost_eur).toLocaleString('lt-LT')}</span>` : ''}
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">${esc(d.description)}</p>
          </div>
        </div>`).join('')
      : `<p class="text-sm text-zinc-500">Matomų pažeidimų nuotraukose nenustatyta.</p>`;
    const resEl = document.getElementById('damage-results')!;
    resEl.innerHTML = `
      ${rep.summary ? `<p class="text-sm text-zinc-700 mb-4 border-l-4 border-amber-300 pl-4 py-1">${esc(rep.summary)}</p>` : ''}
      <div class="space-y-3">${rows}</div>
      <div class="mt-4 pt-4 border-t border-zinc-100">
        <p class="text-sm"><span class="text-zinc-500">Numatoma remonto sąmata:</span> <span class="font-bold text-zinc-900">€${repMin.toLocaleString('lt-LT')}–€${repMax.toLocaleString('lt-LT')}</span> <span class="text-xs text-zinc-400">— įskaičiuota į pelno analizę</span></p>
      </div>`;
    resEl.classList.remove('hidden');
    document.getElementById('damage-demo')?.classList.add('hidden');
    document.getElementById('demo-damage')?.remove();
  }
</script>
</BaseLayout>
