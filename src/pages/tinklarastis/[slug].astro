---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import { formatDate, slugify } from '../../lib/utils';
import config from '../../config';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, heroImage } = post.data;

// render() — Astro 5+ Content Layer API (ne post.render())
const { Content, headings } = await render(post);

// Susiję straipsniai: daugiausia bendrų žymų, tuomet pagal datą
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => tags.includes(t)).length,
  }))
  .filter(({ score }) => score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 3)
  .map(({ post: p }) => p);

// Jei nėra susijusių pagal žymas — rodome naujausius
const relatedPosts =
  related.length > 0
    ? related
    : allPosts
        .filter((p) => p.id !== post.id)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .slice(0, 3);

const canonicalPath = `/tinklarastis/${post.id}`;
---

<BlogLayout
  title={title}
  description={description}
  image={heroImage?.src}
  publishDate={pubDate.toISOString()}
  modifiedDate={updatedDate?.toISOString()}
  author={author}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <Breadcrumbs
      items={[
        { label: 'Pagrindinis', href: '/' },
        { label: 'Tinklaraštis', href: '/tinklarastis' },
        { label: title, href: canonicalPath },
      ]}
      class="mb-8"
    />

    <!-- Hero nuotrauka -->
    {heroImage && (
      <Image
        src={heroImage}
        alt={title}
        width={900}
        height={450}
        class="w-full rounded-2xl mb-10 object-cover"
      />
    )}

    <!-- Antraštė ir meta -->
    <header class="mb-10">
      <!-- Žymos -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <a
              href={`/tinklarastis/zyma/${slugify(tag)}`}
              class="text-xs px-3 py-1 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      <h1 class="text-4xl font-bold text-gray-900 leading-tight mb-4">{title}</h1>
      <p class="text-xl text-gray-600 mb-6">{description}</p>

      <div class="flex items-center gap-4 text-sm text-gray-500 pb-6 border-b border-gray-200">
        <span class="font-medium text-gray-700">{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate.toISOString())}
        </time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Atnaujinta: {formatDate(updatedDate.toISOString())}</span>
          </>
        )}
      </div>
    </header>

    <!-- MDX turinys -->
    <!-- Prose stiliai: Tailwind Typography plugin bus pridėtas vėliau.
         Šiuo metu naudojame bazines utility klases. -->
    <div class="prose-content text-gray-800 leading-relaxed space-y-6
      [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-gray-900 [&_h2]:mt-10 [&_h2]:mb-4
      [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-gray-900 [&_h3]:mt-8 [&_h3]:mb-3
      [&_p]:text-gray-700 [&_p]:leading-relaxed
      [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ul>li]:text-gray-700
      [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2 [&_ol>li]:text-gray-700
      [&_strong]:font-semibold [&_strong]:text-gray-900
      [&_a]:text-blue-600 [&_a]:underline [&_a:hover]:text-blue-800
      [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm
      [&_th]:bg-gray-100 [&_th]:px-4 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold [&_th]:border [&_th]:border-gray-200
      [&_td]:px-4 [&_td]:py-2 [&_td]:border [&_td]:border-gray-200
      [&_hr]:border-gray-200 [&_hr]:my-8
      [&_blockquote]:border-l-4 [&_blockquote]:border-blue-400 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-gray-600
      [&_code]:bg-gray-100 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm [&_code]:font-mono">
      <Content />
    </div>

    <!-- Grįžimas -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <a href="/tinklarastis" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 transition-colors text-sm font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        Visi straipsniai
      </a>
    </div>

  </article>

  <!-- Susiję straipsniai -->
  {relatedPosts.length > 0 && (
    <aside class="border-t border-gray-200 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Susiję straipsniai</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((p) => <BlogCard post={p} />)}
        </div>
      </div>
    </aside>
  )}

</BlogLayout>
