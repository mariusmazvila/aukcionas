---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Ačiū už žinutę"
  description="Gavome jūsų žinutę ir susisieksime per 2 darbo dienas."
  noindex={true}
>
  <main class="min-h-[60vh] flex items-center justify-center py-20 px-4">
    <div class="text-center max-w-lg">

      <!-- Sėkmės ikonelė -->
      <div class="mx-auto w-20 h-20 rounded-full bg-green-50 flex items-center justify-center mb-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-10 w-10 text-green-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">
        Ačiū!
      </h1>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Gavome jūsų žinutę. Inžinierius susisieks per 2 darbo dienas ir
        paruoš techninę specifikaciją.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button variant="primary" href="/">
          Grįžti į pagrindinį
        </Button>
        <Button variant="outline" href="/paslaugos">
          Mūsų paslaugos
        </Button>
      </div>

    </div>
  </main>
</BaseLayout>
