---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Prisijungti" noindex={true}>
  <div class="min-h-screen bg-zinc-50 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">

      <div class="mb-8">
        <h1 class="text-2xl font-medium text-zinc-900">Prisijungti</h1>
        <p class="mt-1.5 text-sm text-zinc-500">
          Neturi paskyros?{' '}
          <a href="/registracija" class="text-[#0344D3] hover:text-[#0240C8] transition-colors">Registruotis nemokamai</a>
        </p>
      </div>

      <div class="bg-white border border-zinc-200 p-7">
        <form class="space-y-5" method="POST" action="#">
          <div>
            <label for="email" class="block text-xs text-zinc-500 uppercase tracking-wide mb-1.5">El. paštas</label>
            <input id="email" type="email" name="email" autocomplete="email" required
              class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-[#0344D3] transition-colors"
              placeholder="vardas@imone.lt" />
          </div>
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="password" class="block text-xs text-zinc-500 uppercase tracking-wide">Slaptažodis</label>
              <a href="/slaptazodis" class="text-xs text-zinc-400 hover:text-zinc-600 transition-colors">Pamiršai?</a>
            </div>
            <input id="password" type="password" name="password" autocomplete="current-password" required
              class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-[#0344D3] transition-colors"
              placeholder="••••••••" />
          </div>
          <button type="submit" class="w-full py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-medium transition-colors">
            Prisijungti
          </button>
        </form>
      </div>

      <p class="mt-4 text-xs text-center text-zinc-400">
        <a href="/privatumas" class="hover:text-zinc-600 transition-colors">Privatumo politika</a>
      </p>

    </div>
  </div>
</BaseLayout>
