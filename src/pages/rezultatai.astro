---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';

const fmtPrice = (n: number | null) => (n == null ? 'Kaina sutartinė' : '€' + n.toLocaleString('lt-LT'));
const fmtKm    = (n: number | null) => (n == null ? '—' : n.toLocaleString('lt-LT') + ' km');

// Scraper stores fuel/transmission in English — show Lithuanian labels.
const fuelLabel: Record<string,string> = {
  diesel: 'Dyzelis', petrol: 'Benzinas', electric: 'Elektra', hybrid: 'Hibridas',
};
const gearLabel: Record<string,string> = {
  automatic: 'Automatinė', manual: 'Mechaninė',
};

const sourceBadge: Record<string,string> = {
  'Autoplius.lt': 'bg-orange-100 text-orange-700',
  'Mobile.de':    'bg-sky-100 text-sky-700',
  'AutoScout24':  'bg-emerald-100 text-emerald-700',
  'Auto.lt':      'bg-violet-100 text-violet-700',
  'BCA':          'bg-rose-100 text-rose-700',
  'Copart':       'bg-amber-100 text-amber-700',
  'Alcopa':       'bg-indigo-100 text-indigo-700',
};

const statusMap = {
  buy:   { label: 'PIRKTI',  chip: 'bg-emerald-100 text-emerald-700', dot: 'bg-emerald-500' },
  maybe: { label: 'GALBŪT', chip: 'bg-amber-100   text-amber-700',   dot: 'bg-amber-400'   },
  avoid: { label: 'VENGTI',  chip: 'bg-red-100     text-red-700',     dot: 'bg-red-500'     },
  // No profit analysis yet — neutral badge so real listings render unchanged.
  none:  { label: 'NAUJAS',  chip: 'bg-zinc-100    text-zinc-500',    dot: 'bg-zinc-300'    },
};

const PAGE_SIZE = 60;
// Hide already-ended (sold) auctions: only surface listings whose auction date
// is today or later. NOTE: this date is fixed at build time on the static site,
// so rebuild when the data changes; the client also prunes cards that expire
// after the build (see the script at the bottom).
// Only active auctions: there is no sold/active flag in the schema, so the only
// signal is auction_end_date. Compare against the full current timestamp so
// auctions that already ended earlier today are excluded too. (Rows with no
// end date are excluded by gte — we only surface known-active auctions.)
const nowIso = new Date().toISOString();
const SELECT = '*';
const { data, count, error } = supabase
  ? await supabase
      .from('listings')
      .select(SELECT, { count: 'exact' })
      .not('make', 'is', null)
      .gte('auction_end_date', nowIso)
      .order('auction_end_date', { ascending: true, nullsFirst: false })
      .range(0, PAGE_SIZE - 1)
  : { data: [], count: 0, error: null };

if (error) console.error('Supabase listings query failed:', error.message);

const cap = (s: string | null) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '—');

// image_urls is a jsonb array of photo URLs; show the first as the card photo.
const firstImage = (v: unknown): string | null =>
  Array.isArray(v) && v.length > 0 && typeof v[0] === 'string' ? v[0] : null;

// The scraped listing's original auction URL — column name is backend-owned and
// unknown here, so we scan every field: a string field whose name hints a link
// wins; otherwise the first non-image http(s) value is used as a fallback.
const isImgUrl = (s: string) => /\.(jpe?g|png|webp|gif|avif|svg)(\?|$)/i.test(s);
const pickUrl = (r: Record<string, unknown>): string | null => {
  let fallback: string | null = null;
  for (const [k, v] of Object.entries(r)) {
    if (typeof v !== 'string' || !/^https?:\/\//i.test(v)) continue;
    if (/image|img|photo|thumb|avatar|logo/i.test(k) || isImgUrl(v)) continue;
    if (/url|link|href|listing|auction|source|skelb/i.test(k)) return v;
    fallback ??= v;
  }
  return fallback;
};

// Auction still running? Only signal in the schema is auction_end_date.
const isLive = (r: Record<string, unknown>): boolean => {
  const end = r.auction_end_date;
  return typeof end === 'string' && new Date(end).getTime() >= Date.now();
};

const results = (data ?? []).map((r) => ({
  id:     r.id,
  make:   r.make ?? '',
  model:  r.model ?? '',
  year:   r.year as number | null,
  km:     r.mileage_km as number | null,
  price:  r.price as number | null,
  source: cap(r.source),
  fuel:   fuelLabel[r.fuel_type as string] ?? null,
  gear:   gearLabel[r.transmission as string] ?? null,
  image:  firstImage(r.image_urls),
  end:    (r.auction_end_date as string | null) ?? null,
  url:    isLive(r) ? pickUrl(r) : null,
  score:  null as number | null,
  status: 'none' as const,
}));

const totalCount = count ?? results.length;
---

<BaseLayout title="Paieškos rezultatai — AutoBid" solidHeader={true}>
<div class="min-h-screen bg-zinc-50">

  <!-- Top bar -->
  <div class="bg-white border-b border-zinc-200 px-4 sm:px-6 py-3 sticky top-14 z-40">
    <div class="max-w-6xl mx-auto flex items-center gap-2 sm:gap-3">
      <a href="/" class="text-zinc-500 hover:text-zinc-800 transition-colors flex items-center gap-1.5 text-sm shrink-0">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span class="hidden sm:inline">Paieška</span>
      </a>
      <span class="text-zinc-200 shrink-0">|</span>
      <div id="filter-chips" class="flex flex-wrap gap-1.5 flex-1 min-w-0 overflow-hidden"></div>
      <a href="/" class="hidden sm:block shrink-0 text-xs text-zinc-400 hover:text-zinc-600 transition-colors">Keisti paiešką</a>
      <a href="/" class="sm:hidden shrink-0 p-1 text-zinc-400 hover:text-zinc-700" title="Keisti paiešką">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">

    <!-- Header row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-zinc-900">
          <span id="result-count">{totalCount.toLocaleString('lt-LT')}</span> rezultatai
        </h1>
        <p id="result-subtitle" class="text-sm text-zinc-500 mt-0.5">Visi skelbimai · Rikiuoti pagal pelno balą</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="relative">
          <select class="pl-3 pr-8 py-2 border border-zinc-300 text-sm text-zinc-700 bg-white focus:outline-none focus:border-zinc-900 appearance-none">
            <option>Pelno balas ↓</option>
            <option>Kaina ↑</option>
            <option>Kaina ↓</option>
            <option>Metai ↓</option>
            <option>Rida ↑</option>
          </select>
          <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-8">
      {results.map(({ id, make, model, year, km, price, source, fuel, gear, image, end, url, score, status }) => {
        const st = statusMap[status];
        const meta = [year ?? '—', fmtKm(km), fuel, gear].filter(Boolean).join(' · ');
        const href = `/auto/demo?id=${id ?? ''}&make=${encodeURIComponent(make)}&model=${encodeURIComponent(model)}&year=${year ?? ''}&km=${km ?? ''}&price=${price ?? ''}&source=${encodeURIComponent(source)}` + (end ? `&end=${encodeURIComponent(end)}` : '') + (url ? `&url=${encodeURIComponent(url)}` : '');
        return (
          <a data-end={end ?? ''} href={href} class="card group bg-white border border-zinc-200 overflow-hidden hover:border-zinc-900 transition-colors duration-200 flex flex-col">

            <!-- Photo -->
            <div class="relative h-44 bg-zinc-100 flex items-center justify-center shrink-0 overflow-hidden border-b border-zinc-200 group-hover:border-zinc-900 transition-colors duration-200">
              {image ? (
                <img src={image} alt={`${make} ${model}`} loading="lazy" decoding="async"
                     class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500"/>
              ) : (
                <svg class="w-12 h-12 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.75">
                  <circle cx="6" cy="17.5" r="1.75" stroke-width="1"/><circle cx="18" cy="17.5" r="1.75" stroke-width="1"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.25 17.5H3V13l2-5h14l2 5v4.5h-1.25M7.75 17.5h8.5M8 8l2-2.5h4l2 2.5"/>
                </svg>
              )}
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide bg-zinc-950 text-white">
                {source}
              </span>
              <span class:list={['absolute top-2.5 right-2.5 px-2 py-0.5 text-[10px] font-bold tracking-wide', st.chip]}>
                {st.label}
              </span>
            </div>

            <!-- Card body -->
            <div class="p-4 flex flex-col flex-1">
              <div class="flex items-start justify-between gap-2 mb-1">
                <h3 class="text-sm font-semibold text-zinc-900 leading-snug min-w-0 truncate">{make} {model}</h3>
                <div class="flex items-center gap-1 shrink-0">
                  <div class:list={['w-2 h-2 shrink-0', st.dot]}/>
                  <span class="text-xs font-bold text-zinc-700">{score ?? '—'}</span>
                </div>
              </div>
              <p class="text-xs text-zinc-400 mb-3">{meta}</p>
              <div class="mt-auto pt-3 flex items-center justify-between border-t border-zinc-100 group-hover:border-zinc-200 transition-colors">
                <span class="text-base font-bold text-zinc-900">{fmtPrice(price)}</span>
                <span class="text-xs text-zinc-500 font-medium group-hover:text-zinc-900 transition-colors">Analizė →</span>
              </div>
            </div>

          </a>
        );
      })}
    </div>

    <!-- Load more -->
    <div class="flex flex-col items-center gap-3 pb-8">
      <button id="load-more" data-total={totalCount} data-page-size={PAGE_SIZE} data-build-date={nowIso}
              style={results.length >= totalCount ? 'display:none' : ''}
              class="px-8 py-3 border border-zinc-300 hover:border-zinc-900 text-zinc-700 text-sm font-medium bg-white transition-colors disabled:opacity-50">
        Rodyti daugiau
      </button>
      <p class="text-xs text-zinc-400">Rodoma <span id="shown-count">{results.length}</span> iš <span id="total-count">{totalCount.toLocaleString('lt-LT')}</span> skelbimų</p>
    </div>

  </div>
</div>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const make      = params.get('make')      || '';
  const model     = params.get('model')     || '';
  const type      = params.get('type')      || 'auto';
  const metaiNuo  = params.get('metaiNuo')  || '';
  const metaiIki  = params.get('metaiIki')  || '';
  const kainaNuo  = params.get('kainaNuo')  || '';
  const kainaIki  = params.get('kainaIki')  || '';
  const kuras     = params.get('kuras')     || '';
  const ridaIki   = params.get('ridaIki')   || '';
  const saltiniai = params.get('saltiniai') || '';

  const typeLabels: Record<string,string> = { moto:'Motociklai', truck:'Sunkvežimiai' };
  const chips: string[] = [];
  if (typeLabels[type])             chips.push(typeLabels[type]);
  if (make)                         chips.push(make);
  if (model)                        chips.push(model);
  if (metaiNuo || metaiIki)         chips.push([metaiNuo, metaiIki].filter(Boolean).join('–'));
  if (kainaNuo || kainaIki) {
    const fmt = (v: string) => v ? '€' + Number(v).toLocaleString('lt-LT') : '';
    chips.push([fmt(kainaNuo), fmt(kainaIki)].filter(Boolean).join('–'));
  }
  if (kuras)     chips.push(kuras);
  if (ridaIki)   chips.push('Rida ≤ ' + Number(ridaIki).toLocaleString('lt-LT') + ' km');
  if (saltiniai) saltiniai.split(',').forEach(s => chips.push(s));

  const container = document.getElementById('filter-chips')!;
  if (chips.length) {
    container.innerHTML = chips.map(c =>
      `<span class="inline-flex items-center bg-zinc-100 text-zinc-700 text-xs font-medium px-2.5 py-1 rounded-full">${c}</span>`
    ).join('');
  }

  if (make || model) {
    document.getElementById('result-subtitle')!.textContent =
      [make, model].filter(Boolean).join(' ') + ' · Rikiuoti pagal pelno balą';
  }
</script>

<script>
  // "Rodyti daugiau" pagination + drop auctions that ended after the build.
  import { createClient } from '@supabase/supabase-js';

  const PAGE_SIZE = 60;
  const nowMs = () => Date.now();

  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const anon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const sb = url && anon ? createClient(url, anon) : null;

  const fuelLabel: Record<string,string> = { diesel:'Dyzelis', petrol:'Benzinas', electric:'Elektra', hybrid:'Hibridas' };
  const gearLabel: Record<string,string> = { automatic:'Automatinė', manual:'Mechaninė' };
  const sourceBadge: Record<string,string> = {
    'Autoplius.lt':'bg-orange-100 text-orange-700','Mobile.de':'bg-sky-100 text-sky-700',
    'AutoScout24':'bg-emerald-100 text-emerald-700','Auto.lt':'bg-violet-100 text-violet-700',
    'BCA':'bg-rose-100 text-rose-700','Copart':'bg-amber-100 text-amber-700','Alcopa':'bg-indigo-100 text-indigo-700',
  };

  const fmtPrice = (n: number | null) => (n == null ? 'Kaina sutartinė' : '€' + n.toLocaleString('lt-LT'));
  const fmtKm    = (n: number | null) => (n == null ? '—' : n.toLocaleString('lt-LT') + ' km');
  const cap = (s: string | null) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '—');
  const firstImage = (v: unknown) => (Array.isArray(v) && v.length > 0 && typeof v[0] === 'string' ? v[0] : null);
  const isImgUrl = (s: string) => /\.(jpe?g|png|webp|gif|avif|svg)(\?|$)/i.test(s);
  const pickUrl = (r: any): string | null => {
    let fallback: string | null = null;
    for (const [k, v] of Object.entries(r)) {
      if (typeof v !== 'string' || !/^https?:\/\//i.test(v)) continue;
      if (/image|img|photo|thumb|avatar|logo/i.test(k) || isImgUrl(v)) continue;
      if (/url|link|href|listing|auction|source|skelb/i.test(k)) return v;
      fallback ??= v;
    }
    return fallback;
  };
  const isLive = (r: any): boolean => {
    const end = r.auction_end_date;
    return typeof end === 'string' && new Date(end).getTime() >= nowMs();
  };
  const hasEnded = (r: any): boolean =>
    typeof r.auction_end_date === 'string' && new Date(r.auction_end_date).getTime() < nowMs();
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => (({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as Record<string,string>)[c]));

  const PLACEHOLDER = `<svg class="w-12 h-12 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.75"><circle cx="6" cy="17.5" r="1.75" stroke-width="1"></circle><circle cx="18" cy="17.5" r="1.75" stroke-width="1"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M4.25 17.5H3V13l2-5h14l2 5v4.5h-1.25M7.75 17.5h8.5M8 8l2-2.5h4l2 2.5"></path></svg>`;

  function cardHtml(r: any) {
    const make = r.make ?? '', model = r.model ?? '';
    const year = r.year, km = r.mileage_km, price = r.price;
    const source = cap(r.source);
    const fuel = fuelLabel[r.fuel_type] ?? null, gear = gearLabel[r.transmission] ?? null;
    const image = firstImage(r.image_urls);
    const meta = [year ?? '—', fmtKm(km), fuel, gear].filter(Boolean).join(' · ');
    const badge = sourceBadge[source] ?? 'bg-zinc-100 text-zinc-600';
    const title = esc(`${make} ${model}`.trim());
    const auctionUrl = isLive(r) ? pickUrl(r) : null;
    const href = `/auto/demo?id=${r.id ?? ''}&make=${encodeURIComponent(make)}&model=${encodeURIComponent(model)}&year=${year ?? ''}&km=${km ?? ''}&price=${price ?? ''}&source=${encodeURIComponent(source)}` + (r.auction_end_date ? `&end=${encodeURIComponent(r.auction_end_date)}` : '') + (auctionUrl ? `&url=${encodeURIComponent(auctionUrl)}` : '');
    const photo = image
      ? `<img src="${esc(image)}" alt="${title}" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-200">`
      : PLACEHOLDER;
    return `<a data-end="${esc(r.auction_end_date ?? '')}" href="${href}" class="card group bg-white border border-zinc-200 overflow-hidden hover:border-zinc-900 transition-colors duration-200 flex flex-col">
      <div class="relative h-44 bg-zinc-100 flex items-center justify-center shrink-0 overflow-hidden border-b border-zinc-200 group-hover:border-zinc-900 transition-colors duration-200">
        ${photo}
        <span class="absolute top-2.5 left-2.5 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide bg-zinc-950 text-white">${esc(source)}</span>
        <span class="absolute top-2.5 right-2.5 px-2 py-0.5 text-[10px] font-bold tracking-wide bg-zinc-100 text-zinc-500">NAUJAS</span>
      </div>
      <div class="p-4 flex flex-col flex-1">
        <div class="flex items-start justify-between gap-2 mb-1">
          <h3 class="text-sm font-semibold text-zinc-900 leading-snug min-w-0 truncate">${title}</h3>
          <div class="flex items-center gap-1 shrink-0"><div class="w-2 h-2 shrink-0 bg-zinc-300"></div><span class="text-xs font-bold text-zinc-700">—</span></div>
        </div>
        <p class="text-xs text-zinc-400 mb-3">${esc(meta)}</p>
        <div class="mt-auto pt-3 flex items-center justify-between border-t border-zinc-100 group-hover:border-zinc-200 transition-colors">
          <span class="text-base font-bold text-zinc-900">${fmtPrice(price)}</span>
          <span class="text-xs text-zinc-500 font-medium group-hover:text-zinc-900 transition-colors">Analizė →</span>
        </div>
      </div>
    </a>`;
  }

  const grid = document.getElementById('results-grid');
  const btn = document.getElementById('load-more') as HTMLButtonElement | null;
  const shownEl = document.getElementById('shown-count');
  // Use the build-time timestamp for the query so range() pagination stays
  // aligned with what the server already rendered; the live clock only prunes.
  const buildDate = btn?.dataset.buildDate || new Date().toISOString();
  let total = btn ? Number(btn.dataset.total ?? 0) : 0;

  const refreshShown = () => {
    if (shownEl && grid) shownEl.textContent = grid.querySelectorAll('.card').length.toLocaleString('lt-LT');
  };

  // ── URL filters ──────────────────────────────────────────────────────────
  // The site is static, so the server-rendered grid is unfiltered. When the
  // search sends params we re-query Supabase on the client with those filters
  // and rebuild the grid. The same filters are reused by "Rodyti daugiau".
  const fp = new URLSearchParams(location.search);
  const F = {
    make:  fp.get('make')     || '',
    model: fp.get('model')    || '',
    yFrom: fp.get('metaiNuo') || '',
    yTo:   fp.get('metaiIki') || '',
    pFrom: fp.get('kainaNuo') || '',
    pTo:   fp.get('kainaIki') || '',
    fuel:  fp.get('kuras')    || '',
    kmTo:  fp.get('ridaIki')  || '',
    srcs:  (fp.get('saltiniai') || '').split(',').filter(Boolean),
  };
  const hasFilters = !!(F.make || F.model || F.yFrom || F.yTo || F.pFrom || F.pTo || F.fuel || F.kmTo || F.srcs.length);
  // Search sends Lithuanian fuel labels; the DB stores English.
  const fuelToDb: Record<string,string> = { 'Dyzelis':'diesel', 'Benzinas':'petrol', 'Elektra':'electric', 'Hibridas':'hybrid' };

  const COLS = '*';  // include the auction URL column (name probed by pickUrl)
  function buildQuery(withCount: boolean) {
    let q = sb!
      .from('listings')
      .select(COLS, withCount ? { count: 'exact' } : undefined)
      .not('make', 'is', null)
      .gte('auction_end_date', buildDate);
    if (F.make)  q = q.ilike('make', F.make);                 // case-insensitive exact
    if (F.model) q = q.ilike('model', `%${F.model}%`);        // model often has trim suffixes
    if (F.yFrom) q = q.gte('year', Number(F.yFrom));
    if (F.yTo)   q = q.lte('year', Number(F.yTo));
    if (F.pFrom) q = q.gte('price', Number(F.pFrom));
    if (F.pTo)   q = q.lte('price', Number(F.pTo));
    if (F.kmTo)  q = q.lte('mileage_km', Number(F.kmTo));
    if (F.fuel && fuelToDb[F.fuel]) q = q.eq('fuel_type', fuelToDb[F.fuel]);
    if (F.srcs.length) q = q.in('source', F.srcs.map((s) => s.toLowerCase())); // DB source is lowercase
    return q.order('auction_end_date', { ascending: true, nullsFirst: false });
  }

  // DB cursor = how many rows the server already consumed (PAGE_SIZE), counted
  // before any visual pruning so the next range() doesn't skip/duplicate rows.
  let offset = grid ? grid.querySelectorAll('.card').length : 0;

  function setCounts() {
    document.getElementById('result-count')?.replaceChildren(total.toLocaleString('lt-LT'));
    document.getElementById('total-count')?.replaceChildren(total.toLocaleString('lt-LT'));
    refreshShown();
  }

  async function loadFiltered() {
    if (!sb || !grid) return;
    grid.innerHTML = '<p class="col-span-full text-sm text-zinc-400 py-10 text-center">Kraunama…</p>';
    const { data, count, error } = await buildQuery(true).range(0, PAGE_SIZE - 1);
    if (error) {
      console.error('filtered query failed:', error.message);
      grid.innerHTML = '<p class="col-span-full text-sm text-red-500 py-10 text-center">Nepavyko įkelti rezultatų.</p>';
      return;
    }
    const all = data ?? [];
    offset = all.length;
    total = count ?? all.length;
    const fresh = all.filter((r: any) => !hasEnded(r));
    grid.innerHTML = fresh.length
      ? fresh.map(cardHtml).join('')
      : '<p class="col-span-full text-sm text-zinc-400 py-10 text-center">Pagal pasirinktus filtrus rezultatų nerasta.</p>';
    setCounts();
    if (btn) btn.style.display = offset >= total ? 'none' : '';
  }

  async function loadMore() {
    if (!sb || !btn || !grid) return;
    btn.disabled = true;
    btn.textContent = 'Kraunama…';
    const { data, error } = await buildQuery(false).range(offset, offset + PAGE_SIZE - 1);
    if (error) {
      console.error('load more failed:', error.message);
      btn.textContent = 'Bandyti dar kartą';
      btn.disabled = false;
      return;
    }
    const rows = data ?? [];
    offset += rows.length;  // advance the DB cursor by everything fetched
    const fresh = rows.filter((r: any) => !hasEnded(r));
    grid.insertAdjacentHTML('beforeend', fresh.map(cardHtml).join(''));
    refreshShown();
    if (rows.length < PAGE_SIZE || offset >= total) {
      btn.style.display = 'none';
    } else {
      btn.disabled = false;
      btn.textContent = 'Rodyti daugiau';
    }
  }

  if (hasFilters) {
    // Replace the unfiltered server-rendered grid with filtered results.
    loadFiltered();
  } else {
    // No filters: keep server-rendered cards, just prune ones that ended
    // between the build time and now.
    grid?.querySelectorAll<HTMLElement>('.card').forEach((el) => {
      const end = el.dataset.end;
      if (end && new Date(end).getTime() < nowMs()) el.remove();
    });
    refreshShown();
    if (btn && offset >= total) btn.style.display = 'none';
  }

  btn?.addEventListener('click', loadMore);
</script>
