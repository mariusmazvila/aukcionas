---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import config from '../config';

// Google Maps embed URL — gauk iš: Google Maps → Bendrinti → Įdėti žemėlapį → Kopijuoti HTML.
// Pakeisk tuščią eilutę tikru embed URL kai turėsi tikslų adresą.
const MAPS_EMBED_URL = '';

// Darbo laikas (redaguok pagal kliento poreikius arba perkelk į config.ts)
const workingHours = [
  { days: 'Pirmadienis – penktadienis', hours: '8:00 – 17:00' },
  { days: 'Šeštadienis – sekmadienis', hours: 'Nedirbame' },
];
---

<BaseLayout
  title="Kontaktai"
  description={`Susisiekite su ${config.companyName}. ${config.companyPhone ?? ''} · ${config.companyEmail ?? ''}`}
>
  <!-- Puslapio antraštė -->
  <section class="bg-gray-50 border-b border-gray-100 py-10 lg:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav aria-label="Naršymo kelias" class="mb-4">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-gray-900 transition-colors">Pagrindinis</a></li>
          <li aria-hidden="true" class="text-gray-300">›</li>
          <li class="text-gray-900 font-medium" aria-current="page">Kontaktai</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">
        Susisiekite su mumis
      </h1>
      <p class="mt-3 text-lg text-gray-600 max-w-2xl">
        Papasakokite apie savo projektą — inžinierius įvertins poreikius ir
        paruoš techninę specifikaciją per 2 darbo dienas.
      </p>
    </div>
  </section>

  <!-- Pagrindinis turinys: info kairėje, forma dešinėje -->
  <section class="py-12 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-start">

        <!-- ── Kairė: kontaktų informacija ── -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Kontaktai iš config.ts -->
          <div class="space-y-5">
            {config.companyEmail && (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-0.5">El. paštas</p>
                  <a
                    href={`mailto:${config.companyEmail}`}
                    class="text-gray-900 hover:text-blue-600 font-medium transition-colors"
                  >
                    {config.companyEmail}
                  </a>
                </div>
              </div>
            )}

            {config.companyPhone && (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-0.5">Telefonas</p>
                  <a
                    href={`tel:${config.companyPhone.replace(/\s/g, '')}`}
                    class="text-gray-900 hover:text-blue-600 font-medium transition-colors"
                  >
                    {config.companyPhone}
                  </a>
                </div>
              </div>
            )}

            {config.companyAddress && (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-0.5">Adresas</p>
                  <p class="text-gray-900 font-medium">{config.companyAddress}</p>
                </div>
              </div>
            )}
          </div>

          <!-- Darbo laikas -->
          <div>
            <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">
              Darbo laikas
            </h2>
            <dl class="space-y-1.5">
              {workingHours.map(({ days, hours }) => (
                <div class="flex justify-between text-sm gap-4">
                  <dt class="text-gray-600">{days}</dt>
                  <dd class="text-gray-900 font-medium shrink-0">{hours}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Socialiniai tinklai (jei yra) -->
          {Object.values(config.socialLinks).some(Boolean) && (
            <div>
              <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">
                Socialiniai tinklai
              </h2>
              <div class="flex items-center gap-2">
                {config.socialLinks.facebook && (
                  <a
                    href={config.socialLinks.facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Facebook"
                    class="p-2 rounded-lg text-gray-500 hover:text-blue-600 hover:bg-blue-50 transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                  </a>
                )}
                {config.socialLinks.linkedin && (
                  <a
                    href={config.socialLinks.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn"
                    class="p-2 rounded-lg text-gray-500 hover:text-blue-700 hover:bg-blue-50 transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
                {config.socialLinks.instagram && (
                  <a
                    href={config.socialLinks.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                    class="p-2 rounded-lg text-gray-500 hover:text-pink-600 hover:bg-pink-50 transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          )}

        </div>

        <!-- ── Dešinė: Netlify Forms kontaktų forma ── -->
        <div class="lg:col-span-3 bg-white rounded-2xl border border-gray-100 shadow-sm p-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-6">Parašykite žinutę</h2>
          <ContactForm formName="contact" successUrl="/aciu" />
        </div>

      </div>
    </div>
  </section>

  <!-- Google Maps sekcija -->
  <section class="pb-12 lg:pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl overflow-hidden border border-gray-200 bg-gray-50">
        {MAPS_EMBED_URL ? (
          <!--
            Tikras Google Maps embed.
            loading="lazy" — neblokuoja puslapio render'inimo.
            referrerpolicy — sumažina siunčiamą informaciją Google.
          -->
          <iframe
            src={MAPS_EMBED_URL}
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`${config.companyName} vieta žemėlapyje`}
            class="block w-full"
          ></iframe>
        ) : (
          <!--
            PLACEHOLDER — pakeisk tikru embed URL:
            1. Atidaryti Google Maps → rasti adresą
            2. Spausti „Bendrinti" → „Įdėti žemėlapį"
            3. Nukopijuoti src URL iš <iframe> kodo
            4. Įrašyti į MAPS_EMBED_URL kintamąjį šio failo viršuje
          -->
          <div class="h-72 lg:h-96 flex flex-col items-center justify-center gap-3 text-gray-400 p-8">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-10 w-10 text-gray-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <p class="font-medium text-gray-600 text-center">{config.companyAddress}</p>
            <p class="text-sm text-center max-w-xs">
              Įdėkite Google Maps embed URL į <code class="bg-gray-100 px-1 rounded text-xs">MAPS_EMBED_URL</code>
              kintamąjį failo viršuje
            </p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
