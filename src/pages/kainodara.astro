---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Kainodara"
  description="AutoBid kainodara — pradėk nemokamai, mokėk tik kai reikia daugiau."
>

  <div class="min-h-screen bg-white px-6 py-16">
    <div class="max-w-5xl mx-auto">

      <div class="mb-12">
        <h1 class="text-3xl font-medium text-zinc-900 tracking-tight">Kainodara</h1>
        <p class="mt-2 text-zinc-500">Pradėk nemokamai. Plėsk kai reikia.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-zinc-200">

        <!-- Free -->
        <div class="bg-white p-8">
          <p class="text-xs font-medium text-zinc-400 uppercase tracking-widest mb-4">Nemokamas</p>
          <p class="text-4xl font-medium text-zinc-900 mb-1">0 €</p>
          <p class="text-xs text-zinc-400 mb-7">per mėnesį, visada</p>
          <Button variant="outline" href="/registracija" size="md">Pradėti nemokamai</Button>
          <div class="mt-7 pt-7 border-t border-zinc-100 space-y-3">
            {['3 aktyvios paieškos', '2 aukcionų šaltiniai', 'Atnaujinimas kas valandą', 'El. pašto įspėjimai', '30 dienų istorija'].map(f => (
              <div class="flex gap-3 items-start text-sm text-zinc-600">
                <svg class="w-4 h-4 text-[#0344D3] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {f}
              </div>
            ))}
          </div>
        </div>

        <!-- Pro -->
        <div class="bg-white p-8 border-t-2 border-[#0344D3]">
          <p class="text-xs font-medium text-[#0344D3] uppercase tracking-widest mb-4">Pro — Populiariausias</p>
          <p class="text-4xl font-medium text-zinc-900 mb-1">19 €</p>
          <p class="text-xs text-zinc-400 mb-7">per mėnesį</p>
          <Button variant="primary" href="/registracija" size="md">Pradėti Pro</Button>
          <div class="mt-7 pt-7 border-t border-zinc-100 space-y-3">
            {['Neribotai paieškų', 'Visi 7+ šaltiniai', 'Atnaujinimas kas 5 min.', 'SMS + el. pašto įspėjimai', '12 mėn. istorija', 'Kainų grafikai', 'CSV / Excel eksportas'].map(f => (
              <div class="flex gap-3 items-start text-sm text-zinc-600">
                <svg class="w-4 h-4 text-[#0344D3] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {f}
              </div>
            ))}
          </div>
        </div>

        <!-- Verslo -->
        <div class="bg-white p-8">
          <p class="text-xs font-medium text-zinc-400 uppercase tracking-widest mb-4">Verslo</p>
          <p class="text-4xl font-medium text-zinc-900 mb-1">49 €</p>
          <p class="text-xs text-zinc-400 mb-7">per mėnesį</p>
          <Button variant="outline" href="mailto:info@autobid.lt" size="md">Susisiekti</Button>
          <div class="mt-7 pt-7 border-t border-zinc-100 space-y-3">
            {['Viskas iš Pro', 'Iki 10 vartotojų', 'Bendros paieškos', 'API prieiga', 'Prioritetinis palaikymas'].map(f => (
              <div class="flex gap-3 items-start text-sm text-zinc-600">
                <svg class="w-4 h-4 text-[#0344D3] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {f}
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- DUK -->
      <div class="mt-16 max-w-2xl">
        <h2 class="text-base font-medium text-zinc-900 mb-8">Dažni klausimai</h2>
        <dl class="space-y-6">
          {[
            { q: 'Ar tikrai nereikia kredito kortelės?', a: 'Taip. Nemokamas planas prieinamas be jokios mokėjimo informacijos.' },
            { q: 'Kaip veikia mokėjimas?', a: 'Mėnesinis arba metinis planas. Kortelė arba banko pervedimas. Atšaukti galima bet kada.' },
            { q: 'Kokius aukcionus stebite?', a: 'Autoplius.lt, Auto.lt, Autogidas.lt, Mobile.de, AutoScout24, BCA, Copart. Nuolat diegiame naujus šaltinius.' },
            { q: 'Ar galima pakeisti planą?', a: 'Taip, bet kada. Aukštesnio plano keitimas įsigalioja iš karto, žemesnio — nuo kito atsiskaitymo periodo.' },
          ].map(({ q, a }) => (
            <div class="border-b border-zinc-200 pb-6">
              <dt class="text-sm font-medium text-zinc-800 mb-2">{q}</dt>
              <dd class="text-sm text-zinc-500 leading-relaxed">{a}</dd>
            </div>
          ))}
        </dl>
      </div>

    </div>
  </div>

</BaseLayout>
