---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kainodara"
  description="AutoBid kainodara — pradėk nemokamai, mokėk tik kai reikia daugiau."
>

  <section class="bg-white border-b border-zinc-100 px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-5xl sm:text-6xl font-bold text-zinc-900 tracking-tight leading-[1.1] mb-4">Kainodara</h1>
      <p class="text-lg text-zinc-500">Pradėk nemokamai. Plėsk kai reikia.</p>
    </div>
  </section>

  <section class="bg-white px-6 py-14">
    <div class="max-w-5xl mx-auto">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <!-- Free -->
        <div class="bg-white border border-zinc-200 rounded-xl p-8 hover:border-zinc-300 transition-colors">
          <p class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-4">Nemokamas</p>
          <p class="text-4xl font-bold text-zinc-900 mb-1">0 €</p>
          <p class="text-xs text-zinc-400 mb-7">per mėnesį, visada</p>
          <a href="/registracija" class="block w-full text-center px-4 py-2.5 border border-zinc-300 text-zinc-700 hover:border-zinc-400 hover:text-zinc-900 text-sm font-medium rounded-lg transition-colors">
            Pradėti nemokamai
          </a>
          <div class="mt-7 pt-7 border-t border-zinc-100 space-y-3">
            {['3 aktyvios paieškos', '2 aukcionų šaltiniai', 'Atnaujinimas kas valandą', 'El. pašto įspėjimai', '30 dienų istorija'].map(f => (
              <div class="flex gap-3 items-start text-sm text-zinc-600">
                <svg class="w-4 h-4 text-[#0344D3] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {f}
              </div>
            ))}
          </div>
        </div>

        <!-- Pro -->
        <div class="bg-white border-2 border-[#0344D3] rounded-xl p-8 relative shadow-lg shadow-[#0344D3]/10">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
            <span class="px-3 py-1 bg-[#0344D3] text-white text-xs font-semibold rounded-full">Populiariausias</span>
          </div>
          <p class="text-xs font-semibold text-[#0344D3] uppercase tracking-widest mb-4">Pro</p>
          <p class="text-4xl font-bold text-zinc-900 mb-1">19 €</p>
          <p class="text-xs text-zinc-400 mb-7">per mėnesį</p>
          <a href="/registracija" class="block w-full text-center px-4 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-semibold rounded-lg transition-colors">
            Pradėti Pro
          </a>
          <div class="mt-7 pt-7 border-t border-zinc-100 space-y-3">
            {['Neribotai paieškų', 'Visi 7+ šaltiniai', 'Atnaujinimas kas 5 min.', 'SMS + el. pašto įspėjimai', '12 mėn. istorija', 'Kainų grafikai', 'CSV / Excel eksportas'].map(f => (
              <div class="flex gap-3 items-start text-sm text-zinc-600">
                <svg class="w-4 h-4 text-[#0344D3] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {f}
              </div>
            ))}
          </div>
        </div>

        <!-- Business -->
        <div class="bg-white border border-zinc-200 rounded-xl p-8 hover:border-zinc-300 transition-colors">
          <p class="text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-4">Verslo</p>
          <p class="text-4xl font-bold text-zinc-900 mb-1">49 €</p>
          <p class="text-xs text-zinc-400 mb-7">per mėnesį</p>
          <a href="mailto:info@autobid.lt" class="block w-full text-center px-4 py-2.5 border border-zinc-300 text-zinc-700 hover:border-zinc-400 hover:text-zinc-900 text-sm font-medium rounded-lg transition-colors">
            Susisiekti
          </a>
          <div class="mt-7 pt-7 border-t border-zinc-100 space-y-3">
            {['Viskas iš Pro', 'Iki 10 vartotojų', 'Bendros paieškos', 'API prieiga', 'Prioritetinis palaikymas'].map(f => (
              <div class="flex gap-3 items-start text-sm text-zinc-600">
                <svg class="w-4 h-4 text-[#0344D3] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {f}
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-zinc-50 border-t border-zinc-200 px-6 py-14">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-xl font-bold text-zinc-900 mb-6">Dažni klausimai</h2>
      <div id="faq" class="space-y-2">
        {[
          { q: 'Ar tikrai nereikia kredito kortelės?', a: 'Taip. Nemokamas planas prieinamas be jokios mokėjimo informacijos.' },
          { q: 'Kaip veikia mokėjimas?', a: 'Mėnesinis arba metinis planas. Kortelė arba banko pervedimas. Atšaukti galima bet kada.' },
          { q: 'Kokius aukcionus stebite?', a: 'Autoplius.lt, Auto.lt, Autogidas.lt, Mobile.de, AutoScout24, BCA, Copart. Nuolat diegiame naujus šaltinius.' },
          { q: 'Ar galima pakeisti planą?', a: 'Taip, bet kada. Aukštesnio plano keitimas įsigalioja iš karto, žemesnio — nuo kito atsiskaitymo periodo.' },
        ].map(({ q, a }) => (
          <div class="faq-item bg-white border border-zinc-200 rounded-xl overflow-hidden">
            <button class="faq-btn w-full flex items-center justify-between gap-4 px-6 py-4 text-left text-sm font-semibold text-zinc-800 hover:text-zinc-900 transition-colors">
              {q}
              <svg class="faq-icon w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-body hidden px-6 pb-5">
              <p class="text-sm text-zinc-500 leading-relaxed">{a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const body = item.querySelector('.faq-body')!;
      const icon = btn.querySelector('.faq-icon')!;
      const open = !body.classList.contains('hidden');
      body.classList.toggle('hidden', open);
      icon.classList.toggle('rotate-180', !open);
    });
  });
</script>
