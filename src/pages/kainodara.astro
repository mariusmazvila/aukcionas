---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kainodara — Carbid"
  description="Carbid kainodara — pradėk nemokamai, mokėk tik kai reikia daugiau."
>

  <!-- ══════ HERO — centruota antraštė ══════ -->
  <section class="bg-white border-b border-zinc-100 px-6 pt-24 sm:pt-36 pb-14 sm:pb-20">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-400 mb-8">Kainodara</p>
      <h1 class="text-5xl sm:text-6xl xl:text-7xl text-zinc-900 leading-[1.05]">
        Pradėk dabar. Plėsk kai <span class="word-underline">reikia.</span>
      </h1>
    </div>
  </section>

  <!-- ══════ PLANŲ LENTELĖ ══════ -->
  <section class="bg-zinc-100 px-6 pt-16 pb-0">
    <div class="max-w-7xl mx-auto">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-zinc-300">

        <!-- ── NEMOKAMAS ── -->
        <div class="bg-white flex flex-col p-6 sm:p-10">
          <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-400 mb-10">Nemokamas</p>
          <div class="mb-10">
            <p class="text-6xl font-light text-zinc-900 leading-none mb-2">0 €</p>
            <p class="text-xs text-zinc-400">per mėnesį, visada</p>
          </div>
          <a href="/registracija" class="block w-full text-center px-4 py-3 border border-zinc-300 text-zinc-700 hover:border-zinc-900 hover:text-zinc-900 text-sm transition-colors mb-10">
            Pradėti nemokamai
          </a>
          <div class="border-t border-zinc-100 pt-8 space-y-4 mt-auto">
            {['3 aktyvios paieškos', '2 aukcionų šaltiniai', 'Atnaujinimas kas valandą', 'El. pašto įspėjimai', '30 dienų istorija'].map(f => (
              <div class="flex gap-4 items-start text-sm text-zinc-500">
                <span class="mt-[8px] w-4 border-t border-zinc-300 shrink-0"></span>
                {f}
              </div>
            ))}
          </div>
        </div>

        <!-- ── PRO (inversed) ── -->
        <div class="bg-zinc-950 flex flex-col p-6 sm:p-10">
          <div class="flex items-center gap-3 mb-10">
            <p class="text-[10px] uppercase tracking-[0.22em] text-white">Pro</p>
            <span class="text-[9px] uppercase tracking-[0.15em] text-zinc-500 border border-zinc-700 px-2 py-0.5">Populiariausias</span>
          </div>
          <div class="mb-10">
            <p class="text-6xl font-light text-white leading-none mb-2">19 €</p>
            <p class="text-xs text-zinc-600">per mėnesį</p>
          </div>
          <a href="/registracija" class="block w-full text-center px-4 py-3 bg-white hover:bg-zinc-100 text-black text-sm font-medium transition-colors mb-10">
            Pradėti Pro
          </a>
          <div class="border-t border-zinc-800 pt-8 space-y-4 mt-auto">
            {['Neribotai paieškų', 'Visi 7+ šaltiniai', 'Atnaujinimas kas 5 min.', 'SMS + el. pašto įspėjimai', '12 mėn. istorija', 'Kainų grafikai', 'CSV / Excel eksportas'].map(f => (
              <div class="flex gap-4 items-start text-sm text-zinc-400">
                <span class="mt-[8px] w-4 border-t border-zinc-700 shrink-0"></span>
                {f}
              </div>
            ))}
          </div>
        </div>

        <!-- ── VERSLO ── -->
        <div class="bg-white flex flex-col p-6 sm:p-10">
          <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-400 mb-10">Verslo</p>
          <div class="mb-10">
            <p class="text-6xl font-light text-zinc-900 leading-none mb-2">49 €</p>
            <p class="text-xs text-zinc-400">per mėnesį</p>
          </div>
          <a href="mailto:info@carbid.lt" class="block w-full text-center px-4 py-3 border border-zinc-300 text-zinc-700 hover:border-zinc-900 hover:text-zinc-900 text-sm transition-colors mb-10">
            Susisiekti
          </a>
          <div class="border-t border-zinc-100 pt-8 space-y-4 mt-auto">
            {['Viskas iš Pro', 'Iki 10 vartotojų', 'Bendros paieškos', 'API prieiga', 'Prioritetinis palaikymas'].map(f => (
              <div class="flex gap-4 items-start text-sm text-zinc-500">
                <span class="mt-[8px] w-4 border-t border-zinc-300 shrink-0"></span>
                {f}
              </div>
            ))}
          </div>
        </div>

      </div>

      <p class="text-xs text-zinc-400 text-center mt-6 pb-6">
        Visi kainų planai be įsipareigojimų. Atšaukti galima bet kada.
      </p>

    </div>
  </section>

  <!-- ══════ SUBTEKSTAS + MYGTUKAI (po planais) ══════ -->
  <section class="bg-zinc-100 border-t border-zinc-200 px-6 py-14 sm:py-20">
    <div class="max-w-xl mx-auto text-center">
      <p class="text-base text-zinc-500 leading-relaxed mb-8">
        Nemokamas planas visada prieinamas be kreditinės kortelės.
        Kai prireiks daugiau aukcionų, greitesnių atnaujinimų ar
        komandos prieigos — pereik prie Pro arba Verslo plano.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/registracija" class="px-5 py-2.5 bg-zinc-shine hover:opacity-90 text-white text-sm font-medium transition-opacity">
          Pradėti nemokamai
        </a>
        <a href="/kontaktai" class="px-5 py-2.5 border border-zinc-300 text-zinc-700 hover:border-zinc-500 text-sm transition-colors">
          Susisiekti →
        </a>
      </div>
    </div>
  </section>

  <!-- ══════ PALYGINIMAS — juosta ══════ -->
  <section class="bg-white border-y border-zinc-100 px-6 py-16">
    <div class="max-w-7xl mx-auto">

      <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-400 mb-12">Ko tikėtis kiekviename plane</p>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-zinc-200">

        <div class="bg-white pr-0 lg:pr-12 py-8 lg:py-0">
          <p class="text-[10px] uppercase tracking-[0.15em] text-zinc-300 mb-5">01</p>
          <h3 class="text-xl text-zinc-900 leading-[1.1] mb-4">Realaus laiko duomenys</h3>
          <p class="text-sm text-zinc-500 leading-relaxed">
            Nauji skelbimai iš visų šaltinių — vienoje vietoje. Nemokamame plane
            atnaujinimas kas valandą, Pro — kas 5 minutės.
          </p>
        </div>

        <div class="bg-white px-0 lg:px-12 py-8 lg:py-0">
          <p class="text-[10px] uppercase tracking-[0.15em] text-zinc-300 mb-5">02</p>
          <h3 class="text-xl text-zinc-900 leading-[1.1] mb-4">AI pelno analizė</h3>
          <p class="text-sm text-zinc-500 leading-relaxed">
            Kiekvienas skelbimas įvertinamas pagal rinkos duomenis — nuotraukų
            žalos analizė, remonto sąmata ir maksimalus pelningas statymas.
          </p>
        </div>

        <div class="bg-white pl-0 lg:pl-12 py-8 lg:py-0">
          <p class="text-[10px] uppercase tracking-[0.15em] text-zinc-300 mb-5">03</p>
          <h3 class="text-xl text-zinc-900 leading-[1.1] mb-4">Komandos prieiga</h3>
          <p class="text-sm text-zinc-500 leading-relaxed">
            Verslo plane — iki 10 vartotojų, bendros paieškos ir API prieiga
            integracijoms su jūsų sistemomis.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════ CTA ══════ -->
  <section class="bg-zinc-950 px-6 py-20">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-start lg:items-center justify-between gap-10">
      <div>
        <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-600 mb-5">Pradėk šiandien</p>
        <h2 class="text-3xl xl:text-4xl text-white leading-[1.08]">
          Klausimų?<br/>Rašyk mums.
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="/registracija" class="px-6 py-3 bg-white hover:bg-zinc-100 text-black text-sm font-medium transition-colors">
          Registruotis nemokamai
        </a>
        <a href="mailto:info@carbid.lt" class="px-6 py-3 border border-zinc-700 hover:border-zinc-500 text-zinc-300 text-sm transition-colors">
          info@carbid.lt
        </a>
      </div>
    </div>
  </section>

  <!-- ══════ DUK (puslapio pabaiga) ══════ -->
  <section class="bg-white px-6 py-20">
    <div class="max-w-3xl mx-auto">

      <p class="text-[10px] uppercase tracking-[0.22em] text-zinc-400 mb-12">Dažni klausimai</p>

      <div id="faq" class="border-t border-zinc-200">
        {[
          { q: 'Ar tikrai nereikia kredito kortelės?', a: 'Taip. Nemokamas planas prieinamas be jokios mokėjimo informacijos.' },
          { q: 'Kaip veikia mokėjimas?', a: 'Mėnesinis arba metinis planas. Kortelė arba banko pervedimas. Atšaukti galima bet kada.' },
          { q: 'Kokius aukcionus stebite?', a: 'Autoplius.lt, Auto.lt, Autogidas.lt, Mobile.de, AutoScout24, BCA, Copart. Nuolat diegiame naujus šaltinius.' },
          { q: 'Ar galima pakeisti planą?', a: 'Taip, bet kada. Aukštesnio plano keitimas įsigalioja iš karto, žemesnio — nuo kito atsiskaitymo periodo.' },
          { q: 'Ar AI analizė veikia automatiškai?', a: 'Išsami AI analizė (žalos vertinimas iš nuotraukų) suaktyvinama rankiniu būdu ant kiekvieno skelbimo. Pelno skaičiavimas veikia automatiškai visiems skelbimams.' },
        ].map(({ q, a }) => (
          <div class="faq-item border-b border-zinc-200">
            <button class="faq-btn w-full flex items-center justify-between gap-6 py-5 text-left text-sm font-medium text-zinc-800 hover:text-zinc-900 transition-colors">
              <span>{q}</span>
              <svg class="faq-icon w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-body hidden pb-5">
              <p class="text-sm text-zinc-500 leading-relaxed">{a}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const body = item.querySelector('.faq-body')!;
      const icon = btn.querySelector('.faq-icon')!;
      const open = !body.classList.contains('hidden');
      body.classList.toggle('hidden', open);
      icon.classList.toggle('rotate-180', !open);
    });
  });
</script>
