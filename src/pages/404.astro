---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Puslapis nerastas" noindex={true} solidHeader={true}>
  <div class="min-h-screen bg-white flex items-center justify-center px-6">
    <div class="text-center">
      <p class="text-8xl font-bold text-zinc-100 leading-none mb-6">404</p>
      <h1 class="text-xl font-bold text-zinc-900 mb-2">Puslapis nerastas</h1>
      <p class="text-sm text-zinc-500 mb-8">Galbūt URL buvo pakeistas arba puslapis ištrintas.</p>
      <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-medium rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Grįžti į pradžią
      </a>
    </div>
  </div>
</BaseLayout>
