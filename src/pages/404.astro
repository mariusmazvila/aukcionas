---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import config from '../config';

// Paieška tik svetainės turinyje naudojant Google site: operatorių
const siteDomain = new URL(config.siteUrl).hostname;

const quickLinks = [
  { label: 'Pagrindinis', href: '/' },
  { label: 'Paslaugos', href: '/paslaugos' },
  { label: 'Mūsų darbai', href: '/darbai' },
  { label: 'Tinklaraštis', href: '/tinklarastis' },
  { label: 'Kontaktai', href: '/kontaktai' },
];
---

<BaseLayout
  title="Puslapis nerastas"
  description="Ieškomas puslapis neegzistuoja arba buvo perkeltas."
  noindex={true}
>
  <main class="min-h-[70vh] flex items-center py-20 px-4">
    <div class="max-w-xl mx-auto w-full">

      <!-- Vizualinis akcentas -->
      <div class="text-center mb-8">
        <p
          class="text-[120px] sm:text-[160px] font-black text-gray-100 leading-none select-none"
          aria-hidden="true"
        >
          404
        </p>
        <div class="-mt-6 relative">
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">
            Puslapis nerastas
          </h1>
          <p class="mt-3 text-gray-600 leading-relaxed">
            Galbūt URL buvo pakeistas arba puslapis ištrintas.
            Pabandykite paieškos arba grįžkite į pagrindinį puslapį.
          </p>
        </div>
      </div>

      <!-- Paieška (Google site search) -->
      <form
        action="https://www.google.com/search"
        method="GET"
        class="flex gap-2 mb-8"
        aria-label="Paieška svetainėje"
      >
        <input type="hidden" name="as_sitesearch" value={siteDomain} />
        <input
          type="search"
          name="q"
          placeholder={`Ieškoti ${siteDomain}…`}
          class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 text-sm text-gray-900
                 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500
                 focus:border-transparent"
          aria-label="Paieškos užklausa"
        />
        <button
          type="submit"
          class="px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-xl
                 hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2
                 focus:ring-blue-500 focus:ring-offset-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="sr-only">Ieškoti</span>
        </button>
      </form>

      <!-- Greitos nuorodos -->
      <div class="border-t border-gray-100 pt-6">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">
          Populiarūs puslapiai
        </p>
        <ul class="flex flex-wrap gap-2">
          {quickLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="inline-block px-3 py-1.5 text-sm text-gray-700 bg-gray-100
                       rounded-lg hover:bg-blue-50 hover:text-blue-700 transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Pagrindiniai mygtukai -->
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <Button variant="primary" href="/">
          Grįžti į pagrindinį
        </Button>
        <Button variant="outline" href="/kontaktai">
          Susisiekti
        </Button>
      </div>

    </div>
  </main>
</BaseLayout>
