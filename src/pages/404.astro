---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Puslapis nerastas" noindex={true}>
  <div class="min-h-screen bg-white flex items-center justify-center px-6">
    <div class="text-center">
      <p class="text-8xl font-medium text-zinc-200 leading-none mb-6">404</p>
      <h1 class="text-xl font-medium text-zinc-900 mb-2">Puslapis nerastas</h1>
      <p class="text-sm text-zinc-500 mb-8">Galbūt URL buvo pakeistas arba puslapis ištrintas.</p>
      <a href="/" class="px-5 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-medium transition-colors">
        Grįžti į pradžią
      </a>
    </div>
  </div>
</BaseLayout>
