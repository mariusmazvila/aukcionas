  <!-- ══════════ STRAIPSNIAI ══════════ -->
  <section id="straipsniai" class="bg-zinc-50 border-t border-zinc-200 px-6 py-14">
    <div class="max-w-7xl mx-auto">

      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="text-[10px] text-zinc-400 uppercase tracking-[0.15em] mb-1" data-anim="up">Resursai</p>
          <h2 class="text-xl font-medium text-zinc-900" data-anim="up" data-anim-delay="80">Straipsniai</h2>
        </div>
        <a href="/straipsniai" class="text-xs text-zinc-500 hover:text-zinc-800 transition-colors">Visi →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-zinc-200" data-anim-stagger>
        {articles.map(({ slug, title, excerpt, date, readMin }) => (
          <article class="bg-white p-6 hover:bg-zinc-50 transition-colors">
            <h3 class="text-sm font-medium text-zinc-800 leading-snug mb-3">
              <a href={`/straipsniai/${slug}`} class="hover:text-zinc-900 transition-colors">{title}</a>
            </h3>
            <p class="text-xs text-zinc-500 leading-relaxed mb-4">{excerpt}</p>
            <div class="flex items-center justify-between text-xs text-zinc-400">
              <span>{new Date(date).toLocaleDateString('lt-LT',{year:'numeric',month:'short',day:'numeric'})}</span>
              <span>{readMin} min</span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  // ── Models per make ──────────────────────────────────────────────────────
  const modelsByMake: Record<string, Record<string, string[]>> = {
    auto: {
      'Alfa Romeo':    ['Giulia','Giulietta','Stelvio','Tonale','156','147','159','Mito'],
      'Audi':          ['A1','A3','A4','A5','A6','A7','A8','Q2','Q3','Q5','Q7','Q8','TT','e-tron','RS3','RS6'],
      'BMW':           ['1 Series','2 Series','3 Series','4 Series','5 Series','7 Series','X1','X2','X3','X4','X5','X6','X7','M3','M5','iX'],
      'Chevrolet':     ['Aveo','Cruze','Captiva','Trax','Camaro','Corvette','Suburban','Spark'],
      'Chrysler':      ['300','Pacifica','Voyager','Town & Country'],
      'Citroën':       ['C1','C3','C4','C5','C5 X','Berlingo','C-Elysée','Dispatch','Jumpy'],
      'Dacia':         ['Sandero','Duster','Logan','Jogger','Spring','Dokker','Lodgy'],
      'Dodge':         ['Challenger','Charger','Durango','Journey','RAM 1500'],
      'Fiat':          ['500','500X','500L','Panda','Tipo','Punto','Bravo','Doblo','Ducato'],
      'Ford':          ['Fiesta','Focus','Mondeo','Kuga','Puma','EcoSport','Galaxy','S-Max','Ranger','Mustang','Transit'],
      'Honda':         ['Civic','Accord','CR-V','HR-V','Jazz','Pilot','e:Ny1','FR-V'],
      'Hyundai':       ['i10','i20','i30','i40','Tucson','Santa Fe','Kona','Ioniq 5','Ioniq 6','ix35','ix55'],
      'Infiniti':      ['Q30','Q50','Q60','QX30','QX50','QX60','QX70','QX80'],
      'Jaguar':        ['XE','XF','XJ','E-Pace','F-Pace','F-Type','I-Pace'],
      'Jeep':          ['Renegade','Compass','Cherokee','Grand Cherokee','Wrangler','Gladiator'],
      'Kia':           ['Picanto','Rio','Ceed','Stonic','Sportage','Sorento','EV6','Niro','ProCeed'],
      'Land Rover':    ['Defender','Discovery','Discovery Sport','Range Rover','Range Rover Sport','Range Rover Evoque','Range Rover Velar','Freelander'],
      'Lexus':         ['IS','ES','GS','LS','NX','RX','UX','LX','LC'],
      'Maserati':      ['Ghibli','Quattroporte','Levante','GranTurismo','GranCabrio','Grecale'],
      'Mazda':         ['Mazda2','Mazda3','Mazda6','CX-3','CX-5','CX-7','CX-9','CX-30','MX-5','CX-60'],
      'Mercedes-Benz': ['A-Klasė','B-Klasė','C-Klasė','E-Klasė','S-Klasė','GLA','GLB','GLC','GLE','GLS','CLA','AMG GT','EQC','EQS'],
      'MINI':          ['Hatch','Clubman','Countryman','Cabrio','Paceman','Roadster','Coupe','Aceman'],
      'Mitsubishi':    ['Colt','Lancer','Outlander','ASX','Eclipse Cross','L200','Pajero','Space Star'],
      'Nissan':        ['Micra','Note','Leaf','Juke','Qashqai','X-Trail','Navara','370Z','GT-R','Ariya'],
      'Opel':          ['Astra','Corsa','Insignia','Mokka','Grandland','Crossland','Zafira','Combo','Vivaro'],
      'Peugeot':       ['108','208','308','508','2008','3008','5008','Partner','Expert','e-208'],
      'Porsche':       ['911','Cayenne','Macan','Panamera','Taycan','Boxster','Cayman'],
      'Renault':       ['Clio','Megane','Laguna','Kadjar','Captur','Koleos','Zoe','Talisman','Twingo','Arkana'],
      'SEAT':          ['Ibiza','Leon','Arona','Ateca','Tarraco','Alhambra','Mii'],
      'Skoda':         ['Fabia','Octavia','Superb','Kodiaq','Karoq','Scala','Enyaq','Rapid','Kamiq'],
      'Smart':         ['fortwo','forfour','EQ fortwo','EQ forfour'],
      'Subaru':        ['Impreza','Legacy','Outback','Forester','XV','BRZ','WRX','Levorg'],
      'Suzuki':        ['Swift','Baleno','Vitara','SX4','Jimny','S-Cross','Ignis','Alto'],
      'Tesla':         ['Model 3','Model S','Model X','Model Y','Cybertruck'],
      'Toyota':        ['Yaris','Corolla','Camry','RAV4','Land Cruiser','Prius','Hilux','C-HR','Aygo','Supra','bZ4X'],
      'Volkswagen':    ['Polo','Golf','Passat','Tiguan','T-Roc','T-Cross','ID.3','ID.4','Touareg','Arteon','Sharan','Touran','Caddy','Transporter'],
      'Volvo':         ['V40','V60','V90','S60','S90','XC40','XC60','XC90','C40','EX30'],
    },
    moto: {
      'Aprilia':         ['RSV4','Tuono V4','RS 660','Shiver 900','Dorsoduro','Caponord','Mana'],
      'BMW':             ['R 1250 GS','F 850 GS','S 1000 RR','R 1200 RT','K 1600 GT','G 310 R','M 1000 RR','F 900 R'],
      'Ducati':          ['Panigale V4','Monster','Multistrada V4','Supersport','Scrambler','Streetfighter','Hypermotard','Diavel'],
      'Harley-Davidson': ['Sportster','Softail','Touring','Dyna','Street Glide','Road King','Fat Boy','LiveWire'],
      'Honda':           ['CBR600RR','CBR1000RR','CB500F','CB750','Africa Twin','VFR800','NC750X','X-ADV','CB125R'],
      'Husqvarna':       ['Vitpilen 401','Svartpilen 401','TE 300','FE 450','Norden 901','701 Enduro'],
      'Kawasaki':        ['Z900','Z650','Ninja 400','Ninja 650','Ninja H2','Versys 650','ZX-10R','Z1000','Z125'],
      'KTM':             ['Duke 390','Duke 790','1290 Super Duke','890 Adventure','RC390','EXC 300','250 Duke'],
      'Suzuki':          ['GSX-R600','GSX-R1000','SV650','GSR750','V-Strom 650','Hayabusa','Katana','GSX-S1000'],
      'Triumph':         ['Speed Triple','Tiger 900','Bonneville','Street Triple','Rocket 3','Scrambler 1200','Daytona'],
      'Yamaha':          ['MT-07','MT-09','YZF-R6','YZF-R1','Tracer 9','Ténéré 700','XMAX 300','XSR900','TMAX'],
    },
    truck: {
      'DAF':           ['XF','CF','LF','XG','XG+','LF Electric'],
      'Iveco':         ['Daily','Stralis','Eurocargo','Trakker','S-WAY','X-WAY','Hi-Way'],
      'MAN':           ['TGX','TGS','TGM','TGL','TGE','Lion\'s Coach'],
      'Mercedes-Benz': ['Actros','Atego','Antos','Arocs','Sprinter','Vito','Citan','eActros'],
      'Renault':       ['Range T','Range C','Range K','Range D','Master','Traffic','Kangoo'],
      'Scania':        ['R Series','S Series','P Series','G Series','XT Series','Streamline'],
      'Volvo':         ['FH','FM','FMX','FL','FE','VNL','VNR'],
    },
  };

  // ── State ────────────────────────────────────────────────────────────────
  let currentTab = 'auto';

  const tabs        = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const makeSelect  = document.getElementById('make-select')  as HTMLSelectElement;
  const modelSelect = document.getElementById('model-select') as HTMLSelectElement;
  const searchFieldsWrap = document.getElementById('search-fields-wrap') as HTMLDivElement;
  const savedPanel       = document.getElementById('saved-panel')        as HTMLDivElement;

  const makesByTab: Record<string, string[]> = {
    auto:  ['Alfa Romeo','Audi','BMW','Chevrolet','Chrysler','Citroën','Dacia','Dodge','Fiat','Ford','Honda','Hyundai','Infiniti','Jaguar','Jeep','Kia','Land Rover','Lexus','Maserati','Mazda','Mercedes-Benz','MINI','Mitsubishi','Nissan','Opel','Peugeot','Porsche','Renault','SEAT','Skoda','Smart','Subaru','Suzuki','Tesla','Toyota','Volkswagen','Volvo'],
    moto:  ['Aprilia','BMW','Ducati','Harley-Davidson','Honda','Husqvarna','Kawasaki','KTM','Suzuki','Triumph','Yamaha'],
    truck: ['DAF','Iveco','MAN','Mercedes-Benz','Renault','Scania','Volvo'],
  };
  const labelsByTab: Record<string, string> = {
    auto: 'Visos markės', moto: 'Visos markės', truck: 'Visi gamintojai',
  };

  function populateModels(make: string) {
    const models = modelsByMake[currentTab]?.[make] ?? [];
    if (!models.length) {
      modelSelect.innerHTML = '<option value="">Visi modeliai</option>';
      modelSelect.disabled = true;
    } else {
      modelSelect.innerHTML = '<option value="">Visi modeliai</option>' +
        models.map(m => `<option value="${m}">${m}</option>`).join('');
      modelSelect.disabled = false;
    }
  }

  makeSelect.addEventListener('change', () => populateModels(makeSelect.value));

  function switchTab(tab: string) {
    currentTab = tab;
    tabs.forEach(btn => {
      const active = btn.dataset.tab === tab;
      btn.classList.toggle('bg-white', active);
      btn.classList.toggle('text-black', active);
      btn.classList.toggle('text-zinc-500', !active);
      btn.classList.toggle('hover:text-white', !active);
      btn.classList.toggle('hover:bg-zinc-800', !active);
    });

    if (tab === 'saved') {
      searchFieldsWrap.classList.add('hidden');
      savedPanel.classList.remove('hidden');
    } else {
      searchFieldsWrap.classList.remove('hidden');
      savedPanel.classList.add('hidden');
      const makes = makesByTab[tab] ?? makesByTab.auto;
      makeSelect.innerHTML = `<option value="">${labelsByTab[tab] ?? 'Visos markės'}</option>` +
        makes.map(m => `<option value="${m}">${m}</option>`).join('');
      populateModels('');
    }
  }

  tabs.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab ?? 'auto')));

  // ── Search button → navigate to /rezultatai ──────────────────────────────
  document.getElementById('search-btn')!.addEventListener('click', () => {
    const p = new URLSearchParams();
    p.set('type', currentTab);
    const make = makeSelect.value;
    if (make)  p.set('make',  make);
    const model = modelSelect.value;
    if (model) p.set('model', model);
    const yearFrom  = (document.getElementById('year-from')  as HTMLSelectElement).value;
    const yearTo    = (document.getElementById('year-to')    as HTMLSelectElement).value;
    const priceFrom = (document.getElementById('price-from') as HTMLSelectElement).value;
    const priceTo   = (document.getElementById('price-to')   as HTMLSelectElement).value;
    const fuel      = (document.getElementById('fuel-select') as HTMLSelectElement).value;
    const kmTo      = (document.getElementById('km-to')      as HTMLSelectElement).value;
    if (yearFrom)  p.set('metaiNuo',  yearFrom);
    if (yearTo)    p.set('metaiIki',  yearTo);
    if (priceFrom) p.set('kainaNuo',  priceFrom);
    if (priceTo)   p.set('kainaIki',  priceTo);
    if (fuel)      p.set('kuras',     fuel);
    if (kmTo)      p.set('ridaIki',   kmTo);
    const activeSources = [...document.querySelectorAll<HTMLButtonElement>('.source-btn')]
      .filter(b => b.dataset.source !== 'all' && b.classList.contains('bg-white'))
      .map(b => b.dataset.source!);
    if (activeSources.length) p.set('saltiniai', activeSources.join(','));
    window.location.href = `/rezultatai?${p.toString()}`;
  });

  // ── Source filter pills ──────────────────────────────────────────────────
  const sourceBtns = document.querySelectorAll<HTMLButtonElement>('.source-btn');
  sourceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.source === 'all') {
        sourceBtns.forEach(b => {
          const isAll = b.dataset.source === 'all';
          b.classList.toggle('bg-white', isAll);
          b.classList.toggle('text-black', isAll);
          b.classList.toggle('bg-transparent', !isAll);
          b.classList.toggle('text-zinc-400', !isAll);
          b.classList.toggle('border', !isAll);
          b.classList.toggle('border-zinc-700', !isAll);
        });
      } else {
        const allBtn = document.querySelector<HTMLButtonElement>('[data-source="all"]')!;
        allBtn.classList.remove('bg-white','text-black');
        allBtn.classList.add('bg-transparent','text-zinc-400','border','border-zinc-700');
        btn.classList.toggle('bg-white');
        btn.classList.toggle('text-black');
        btn.classList.toggle('bg-transparent');
        btn.classList.toggle('text-zinc-400');
        btn.classList.toggle('border');
        btn.classList.toggle('border-zinc-700');
      }
    });
  });

  // ── Save toggle ──────────────────────────────────────────────────────────
  const saveLabel   = document.getElementById('save-search-label') as HTMLLabelElement;
  const toggleTrack = document.getElementById('toggle-track')      as HTMLDivElement;
  const toggleThumb = document.getElementById('toggle-thumb')      as HTMLDivElement;
  const toggleText  = document.getElementById('toggle-text')       as HTMLSpanElement;
  let saveEnabled = false;

  saveLabel.addEventListener('click', () => {
    saveEnabled = !saveEnabled;
    toggleTrack.style.backgroundColor = saveEnabled ? '#ffffff' : '';
    toggleTrack.style.borderColor     = saveEnabled ? '#6b7280' : '';
    toggleTrack.classList.toggle('bg-zinc-800',    !saveEnabled);
    toggleTrack.classList.toggle('border-zinc-700', !saveEnabled);
    toggleThumb.style.transform       = saveEnabled ? 'translateX(18px)' : '';
    toggleThumb.style.backgroundColor = saveEnabled ? '#000000' : '';
    toggleText.style.color            = saveEnabled ? '#a1a1aa' : '';
  });

  // ── FAQ accordion ────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const body = item.querySelector('.faq-body')!;
      const icon = btn.querySelector('.faq-icon')!;
      const open = !body.classList.contains('hidden');
      body.classList.toggle('hidden', open);
      icon.classList.toggle('rotate-180', !open);
    });
  });

  // ── Count-up animation ───────────────────────────────────────────────────
  function countUp(
    el: HTMLElement,
    from: number,
    to: number,
    suffix: string,
    useLocale: boolean,
    duration: number = 1800
  ) {
    const diff = to - from;
    const startTime = performance.now();

    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(from + diff * ease);
      el.textContent = useLocale
        ? current.toLocaleString('lt-LT') + suffix
        : current + suffix;
      if (progress < 1) requestAnimationFrame(update);
    }

    requestAnimationFrame(update);
  }

  const statObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const from      = parseInt(el.dataset.from   ?? '0', 10);
        const to        = parseInt(el.dataset.to     ?? '0', 10);
        const suffix    = el.dataset.suffix ?? '';
        const useLocale = el.dataset.format === 'locale';
        countUp(el, from, to, suffix, useLocale);
        statObserver.unobserve(el);
      });
    },
    { threshold: 0.4 }
  );

  document.querySelectorAll<HTMLElement>('.stat-number[data-to]').forEach((el) =>
    statObserver.observe(el)
  );

  // ── Scroll-driven BMW animacija ──────────────────────────────────────────
  const flWrapper = document.getElementById('fl-wrapper');
  const flCar     = document.getElementById('fl-car')  as HTMLElement | null;
  const flText    = document.getElementById('fl-text') as HTMLElement | null;

  const flPhrases: string[] = [
    'Šimtai aukcionų.<br/>Vienas ekranas.',
    'AI analizė.<br/>Per sekundes.',
    'Rask pelną.<br/>Anksčiau nei kiti.',
  ];
  let flCurrentPhrase = 0;

  function onFlScroll() {
    if (!flWrapper || !flCar || !flText) return;
    const scrolled       = window.scrollY - flWrapper.offsetTop;
    const totalScrollable = flWrapper.offsetHeight - window.innerHeight;
    const progress       = Math.max(0, Math.min(1, scrolled / totalScrollable));

    // Mašina: nuo -55% (kairė, nepastebima) iki 120% (dešinė, nepastebima)
    const carX = -55 + progress * 175;
    flCar.style.left = `${carX}%`;

    // Blur: stipresnis kraštais, silpnesnis per vidurį
    const centerDist = Math.abs(progress - 0.5) * 2; // 0 centre, 1 edge
    const blurPx = 2 + centerDist * 10;
    flCar.style.filter = `blur(${blurPx.toFixed(1)}px)`;

    // Tekstas: keičiasi pagal progresą
    const phraseIdx = Math.min(flPhrases.length - 1, Math.floor(progress * flPhrases.length));
    if (phraseIdx !== flCurrentPhrase) {
      flCurrentPhrase = phraseIdx;
      flText.style.opacity = '0';
      setTimeout(() => {
        flText.innerHTML = flPhrases[phraseIdx];
        (flText as HTMLElement).style.opacity = '1';
      }, 220);
    }
  }

  window.addEventListener('scroll', onFlScroll, { passive: true });
  onFlScroll();

  // ── Scroll-triggered animations ──────────────────────────────────────────
  const animObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const delay = parseInt(el.dataset.animDelay ?? '0');
      setTimeout(() => el.classList.add('anim-in'), delay);
      animObs.unobserve(el);
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -48px 0px' });

  // Stagger children of [data-anim-stagger] grids
  document.querySelectorAll<HTMLElement>('[data-anim-stagger]').forEach(parent => {
    Array.from(parent.children).forEach((child, i) => {
      const el = child as HTMLElement;
      el.dataset.anim = el.dataset.anim ?? 'up';
      el.dataset.animDelay = String(i * 90);
      animObs.observe(el);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-anim]').forEach(el => animObs.observe(el));

  // ── Kaip veikia scroll timeline ──────────────────────────────────────────
  const kvTimeline = document.getElementById('kv-timeline');
  const kvProg     = document.getElementById('kv-prog') as HTMLElement | null;
  const kvTrack    = document.getElementById('kv-track') as HTMLElement | null;
  const kvImgs     = document.querySelectorAll<HTMLElement>('.kv-img');
  const kvSteps    = document.querySelectorAll<HTMLElement>('.kv-step');

  function onKvScroll() {
    if (!kvTimeline || !kvProg || !kvTrack) return;
    const rect           = kvTimeline.getBoundingClientRect();
    const navH           = 56;
    const totalScrollable = kvTimeline.offsetHeight - (window.innerHeight - navH);
    const scrolled       = Math.max(0, -(rect.top - navH));
    const pct            = Math.min(1, scrolled / totalScrollable); // 0→1

    // Pildo progress linija
    kvProg.style.height = (pct * kvTrack.offsetHeight) + 'px';

    // Aktyvus žingsnis (0-3)
    const active = Math.min(3, Math.floor(pct * 4));

    // Keičia nuotraukas
    kvImgs.forEach(img => {
      const n = parseInt(img.dataset.kvImg ?? '0');
      img.style.opacity = n === active + 1 ? '1' : '0';
    });

    // Paryškina aktyvų žingsnį
    kvSteps.forEach((step, i) => {
      step.style.opacity = i === active ? '1' : '0.3';
    });
  }

  if (kvTimeline) {
    window.addEventListener('scroll', onKvScroll, { passive: true });
    onKvScroll();
  }

  // ── "Apie mus" reveal — opacity + translateY (no layout shift) ───────────
  const apieEl = document.getElementById('apie-reveal');
  if (apieEl) {
    apieEl.style.opacity = '0';
    apieEl.style.transform = 'translateY(56px)';
    apieEl.style.transition = 'opacity 0.9s cubic-bezier(0.22,1,0.36,1), transform 0.9s cubic-bezier(0.22,1,0.36,1)';
    const apieObs = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        apieEl.style.opacity = '1';
        apieEl.style.transform = 'translateY(0)';
        apieObs.disconnect();
      }
    }, { threshold: 0.05 });
    apieObs.observe(apieEl);
  }
</script>
