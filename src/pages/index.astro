          <div class="lg:w-[42%] bg-zinc-100 overflow-hidden" style="min-height:360px;" data-anim="right">
            <img src="/images/old-car-2.webp" alt="Klasikinis automobilis" class="w-full h-full object-cover" loading="lazy"/>
