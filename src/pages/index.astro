---
import BaseLayout from '../layouts/BaseLayout.astro';

const deals = [
  { make: 'Volkswagen', model: 'Golf 1.6 TDI', year: 2018, km: 187000, price: 8900,  source: 'Autoplius.lt'  },
  { make: 'BMW',        model: '320d xDrive',   year: 2016, km: 211000, price: 12500, source: 'Mobile.de'     },
  { make: 'Toyota',     model: 'Yaris Hybrid',  year: 2021, km: 44000,  price: 16900, source: 'AutoScout24'   },
  { make: 'Skoda',      model: 'Octavia 2.0',   year: 2019, km: 155000, price: 10400, source: 'Auto.lt'       },
  { make: 'Audi',       model: 'A4 2.0 TDI',    year: 2017, km: 193000, price: 11200, source: 'Autoplius.lt'  },
  { make: 'Volvo',      model: 'XC40 D3',        year: 2020, km: 72000,  price: 24900, source: 'AutoScout24'   },
];

const articles = [
  {
    slug: 'kaip-patikrinti-naudota-automobili',
    title: '5 dalykai, kuriuos reikia patikrinti prieš perkant naudotą automobilį',
    excerpt: 'Kilometražas, avarijų istorija, techninė apžiūra — ką svarbu sužinoti ir kaip to nedaryti per tarpininkus.',
    date: '2026-06-05',
    readMin: 5,
  },
  {
    slug: 'mobile-de-vs-autoplius',
    title: 'Mobile.de vs Autoplius.lt: kur geresnės kainos 2026 m.',
    excerpt: 'Palyginome 500+ skelbimų ir išsiaiškinome, kuriame aukcione rasti geresnius sandorius pagal automobilių klasę.',
    date: '2026-06-01',
    readMin: 7,
  },
  {
    slug: 'kaip-veikia-autobid',
    title: 'Kaip AutoBid sutaupo 5+ valandas per savaitę automobilių pardavėjui',
    excerpt: 'Realus use case: kaip suderinti 4 aukcionų monitoringą vienu dashboardu ir nebepraleidinėti gerų pasiūlymų.',
    date: '2026-05-28',
    readMin: 4,
  },
];

function fmtPrice(p: number) { return p.toLocaleString('lt-LT') + ' €'; }
function fmtKm(km: number)    { return km.toLocaleString('lt-LT') + ' km'; }
---

<BaseLayout
  title="Automobilių aukcionų stebėjimas"
  description="AutoBid — rask geriausias mašinas iš Autoplius, Mobile.de, AutoScout24 ir kitų aukcionų. Vienas ekranas, realus laikas."
>

  <!-- ══════════ HERO + SEARCH ══════════ -->
  <section class="bg-white px-6 pt-12 pb-10 border-b border-zinc-200">
    <div class="max-w-3xl mx-auto">

      <div class="mb-6">
        <h1 class="text-4xl sm:text-5xl font-medium text-zinc-900 tracking-tight leading-[1.15]">
          Visi aukcionai. Vienas ekranas.
        </h1>
        <p class="mt-2.5 text-zinc-500 text-base">
          Ieškoki vienu metu Autoplius.lt, Mobile.de, AutoScout24 ir kituose.
        </p>
      </div>

      <!-- Search block -->
      <div class="bg-zinc-100 border border-zinc-200">

        <!-- Tabs -->
        <div class="flex border-b border-zinc-200">
          {['Automobiliai', 'Motociklai', 'Sunkvežimiai'].map((tab, i) => (
            <button
              class:list={[
                'px-5 py-3 text-sm font-medium transition-colors',
                i === 0
                  ? 'text-zinc-900 border-b-2 border-[#0344D3] -mb-px bg-zinc-100'
                  : 'text-zinc-400 hover:text-zinc-600 bg-zinc-50',
              ]}
            >
              {tab}
            </button>
          ))}
        </div>

        <div class="p-5 space-y-3">

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-zinc-500 mb-1.5">Markė</label>
              <div class="relative">
                <select class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 focus:outline-none focus:border-[#0344D3] appearance-none transition-colors">
                  <option value="">Visos markės</option>
                  <option>Audi</option><option>BMW</option><option>Mercedes-Benz</option>
                  <option>Skoda</option><option>Toyota</option><option>Volkswagen</option><option>Volvo</option>
                </select>
                <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
            <div>
              <label class="block text-xs text-zinc-500 mb-1.5">Modelis</label>
              <input type="text" placeholder="pvz. Golf, 3 Series" class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 placeholder-zinc-400 focus:outline-none focus:border-[#0344D3] transition-colors" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-zinc-500 mb-1.5">Metai</label>
              <div class="flex gap-2">
                <div class="relative flex-1">
                  <select class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 focus:outline-none focus:border-[#0344D3] appearance-none">
                    <option value="">Nuo</option>
                    {Array.from({length:15},(_,i)=>2025-i).map(y=><option>{y}</option>)}
                  </select>
                  <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div class="relative flex-1">
                  <select class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 focus:outline-none focus:border-[#0344D3] appearance-none">
                    <option value="">Iki</option>
                    {Array.from({length:15},(_,i)=>2025-i).map(y=><option>{y}</option>)}
                  </select>
                  <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </div>
            </div>
            <div>
              <label class="block text-xs text-zinc-500 mb-1.5">Kaina, €</label>
              <div class="flex gap-2">
                <input type="number" placeholder="Nuo" min="0" class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 placeholder-zinc-400 focus:outline-none focus:border-[#0344D3]" />
                <input type="number" placeholder="Iki"  min="0" class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 placeholder-zinc-400 focus:outline-none focus:border-[#0344D3]" />
              </div>
            </div>
          </div>

          <div class="flex gap-3 items-end">
            <div class="flex-1">
              <label class="block text-xs text-zinc-500 mb-1.5">Kuras</label>
              <div class="relative">
                <select class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 focus:outline-none focus:border-[#0344D3] appearance-none">
                  <option value="">Visi</option><option>Dyzelis</option><option>Benzinas</option><option>Hibridas</option><option>Elektra</option>
                </select>
                <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
            <div class="flex-1">
              <label class="block text-xs text-zinc-500 mb-1.5">Kėbulas</label>
              <div class="relative">
                <select class="w-full px-3 py-2.5 bg-white border border-zinc-300 text-sm text-zinc-800 focus:outline-none focus:border-[#0344D3] appearance-none">
                  <option value="">Visi</option><option>Sedanas</option><option>Universalas</option><option>Hečbekas</option><option>Visureigis</option>
                </select>
                <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
            <button class="px-6 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-medium transition-colors flex items-center gap-2 shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              Ieškoti
            </button>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ══════════ DIENOS PASIŪLYMAI ══════════ -->
  <section class="bg-white px-6 py-12">
    <div class="max-w-6xl mx-auto">

      <div class="flex items-center justify-between mb-6">
        <h2 class="text-base font-medium text-zinc-900">Dienos pasiūlymai</h2>
        <a href="/registracija" class="text-xs text-[#0344D3] hover:text-[#0240C8] transition-colors">
          Visi skelbimai →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-zinc-200">
        {deals.map(({ make, model, year, km, price, source }) => (
          <a href="/registracija" class="group bg-white hover:bg-zinc-50 transition-colors p-5 flex flex-col">

            <div class="w-full h-32 bg-zinc-100 mb-4 flex items-center justify-center">
              <svg class="w-8 h-8 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
              </svg>
            </div>

            <p class="text-xs text-zinc-400 mb-1">{source}</p>
            <h3 class="text-sm font-medium text-zinc-800 group-hover:text-zinc-900 transition-colors">{make} {model}</h3>
            <p class="text-xs text-zinc-500 mt-0.5">{year} · {fmtKm(km)}</p>

            <div class="mt-auto pt-4 flex items-center justify-between">
              <span class="text-sm font-medium text-zinc-900">{fmtPrice(price)}</span>
              <span class="text-xs text-[#0344D3]">Žiūrėti →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6 flex items-center gap-4">
        <a href="/registracija" class="px-5 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-medium transition-colors">
          Matyti visus 47 000+ skelbimų
        </a>
        <span class="text-xs text-zinc-400">Nemokama registracija</span>
      </div>

    </div>
  </section>

  <!-- ══════════ STRAIPSNIAI ══════════ -->
  <section class="bg-zinc-50 border-t border-zinc-200 px-6 py-12">
    <div class="max-w-6xl mx-auto">

      <div class="flex items-center justify-between mb-6">
        <h2 class="text-base font-medium text-zinc-900">Straipsniai</h2>
        <a href="/straipsniai" class="text-xs text-[#0344D3] hover:text-[#0240C8] transition-colors">Visi →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-zinc-200">
        {articles.map(({ slug, title, excerpt, date, readMin }) => (
          <article class="bg-white hover:bg-zinc-50 transition-colors p-6">
            <h3 class="text-sm font-medium text-zinc-800 leading-snug mb-3">
              <a href={`/straipsniai/${slug}`} class="hover:text-zinc-900 transition-colors">{title}</a>
            </h3>
            <p class="text-xs text-zinc-500 leading-relaxed mb-4">{excerpt}</p>
            <div class="flex items-center justify-between text-xs text-zinc-400">
              <span>{new Date(date).toLocaleDateString('lt-LT', { year:'numeric', month:'short', day:'numeric' })}</span>
              <span>{readMin} min</span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>


</BaseLayout>
