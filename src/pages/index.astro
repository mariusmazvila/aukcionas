---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';

const carMakes = [
  'Alfa Romeo','Audi','BMW','Chevrolet','Chrysler','Citroën','Dacia','Dodge',
  'Fiat','Ford','Honda','Hyundai','Infiniti','Jaguar','Jeep','Kia',
  'Land Rover','Lexus','Maserati','Mazda','Mercedes-Benz','MINI','Mitsubishi',
  'Nissan','Opel','Peugeot','Porsche','Renault','SEAT','Skoda','Smart',
  'Subaru','Suzuki','Tesla','Toyota','Volkswagen','Volvo',
];
const motoMakes = [
  'Aprilia','BMW','Ducati','Harley-Davidson','Honda','Husqvarna',
  'Kawasaki','KTM','Suzuki','Triumph','Yamaha',
];
const truckMakes = ['DAF','Iveco','MAN','Mercedes-Benz','Renault','Scania','Volvo'];

const priceOpts = [1000,2000,3000,5000,7000,10000,12000,15000,20000,25000,30000,40000,50000,75000,100000];
const kmOpts    = [30000,50000,75000,100000,125000,150000,175000,200000,250000,300000,400000,500000];
const years     = Array.from({length:36},(_,i)=>2025-i);

const sources = ['Autoplius.lt','Auto.lt','Autogidas.lt','Mobile.de','AutoScout24','BCA','Copart'];

const cap = (s: string | null) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '—');
const { data: dealRows } = supabase
  ? await supabase
      .from('listings')
      .select('*')
      .not('make', 'is', null)
      .not('price', 'is', null)
      .gte('auction_end_date', new Date().toISOString())
      .order('auction_end_date', { ascending: true, nullsFirst: false })
      .limit(6)
  : { data: [] };

const firstImage = (v: unknown): string | null =>
  Array.isArray(v) && v.length > 0 && typeof v[0] === 'string' ? v[0] : null;

const isImgUrl = (s: string) => /\.(jpe?g|png|webp|gif|avif|svg)(\?|$)/i.test(s);
const pickUrl = (r: Record<string, unknown>): string | null => {
  let fallback: string | null = null;
  for (const [k, v] of Object.entries(r)) {
    if (typeof v !== 'string' || !/^https?:\/\//i.test(v)) continue;
    if (/image|img|photo|thumb|avatar|logo/i.test(k) || isImgUrl(v)) continue;
    if (/url|link|href|listing|auction|source|skelb/i.test(k)) return v;
    fallback ??= v;
  }
  return fallback;
};

const isLive = (r: Record<string, unknown>): boolean => {
  const end = r.auction_end_date;
  return typeof end === 'string' && new Date(end).getTime() >= Date.now();
};

const deals = (dealRows ?? []).map((r) => ({
  id:     r.id,
  make:   r.make ?? '',
  model:  r.model ?? '',
  year:   r.year as number | null,
  km:     r.mileage_km as number | null,
  price:  r.price as number | null,
  source: cap(r.source),
  image:  firstImage(r.image_urls),
  end:    (r.auction_end_date as string | null) ?? null,
  url:    isLive(r) ? pickUrl(r) : null,
}));

const articles = [
  {
    slug:'kaip-patikrinti-naudota-automobili',
    title:'5 dalykai, kuriuos reikia patikrinti prieš perkant naudotą automobilį',
    excerpt:'Kilometražas, avarijų istorija, techninė apžiūra — ką svarbu sužinoti ir kaip to nedaryti per tarpininkus.',
    date:'2026-06-05', readMin:5,
  },
  {
    slug:'mobile-de-vs-autoplius',
    title:'Mobile.de vs Autoplius.lt: kur geresnės kainos 2026 m.',
    excerpt:'Palyginome 500+ skelbimų ir išsiaiškinome, kuriame aukcione rasti geresnius sandorius pagal automobilių klasę.',
    date:'2026-06-01', readMin:7,
  },
  {
    slug:'kaip-veikia-carbid',
    title:'Kaip Carbid sutaupo 5+ valandas per savaitę automobilių pardavėjui',
    excerpt:'Realus use case: kaip suderinti 4 aukcionų monitoringą vienu dashboardu ir nebepraleidinėti gerų pasiūlymų.',
    date:'2026-05-28', readMin:4,
  },
];

const sourceBadge: Record<string,string> = {
  'Autoplius.lt':'bg-zinc-100 text-zinc-600',
  'Mobile.de':   'bg-zinc-100 text-zinc-600',
  'AutoScout24': 'bg-zinc-100 text-zinc-600',
  'Auto.lt':     'bg-zinc-100 text-zinc-600',
  'Alcopa':      'bg-zinc-100 text-zinc-600',
};

function fmtPrice(p:number|null){ return p==null ? 'Kaina sutartinė' : p.toLocaleString('lt-LT')+' €'; }
function fmtKm(km:number|null)  { return km==null ? '—' : km.toLocaleString('lt-LT')+' km'; }
function fmtOpt(n:number)  { return n.toLocaleString('lt-LT'); }
---

<BaseLayout
  title="Carbid — automobilių aukcionų stebėjimas"
  description="Carbid — rask geriausias mašinas iš Autoplius, Mobile.de, AutoScout24 ir kitų aukcionų. Vienas ekranas, realus laikas."
>

  <!-- ══════════ HERO + SEARCH ══════════ -->
  <section id="hero" class="relative flex flex-col lg:flex-row min-h-screen overflow-hidden" style="background-image:url('/images/sports-car-1.webp');background-size:cover;background-position:center;">
    <div class="absolute inset-0 bg-zinc-950/75" aria-hidden="true"></div>

    <!-- LEFT: Search panel -->
    <div class="relative z-10 w-full lg:w-[500px] xl:w-[560px] bg-black/70 backdrop-blur-sm lg:border-r border-white/10 flex flex-col pt-20 px-8 pb-8">

      <!-- Vehicle type tabs -->
      <div id="vehicle-tabs" class="flex gap-0.5 mt-4 mb-6 pb-5 border-b border-zinc-800">
        <button data-tab="auto" class="tab-btn active flex items-center gap-2 px-3 py-2 text-sm font-medium bg-white text-black transition-colors">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <circle cx="6" cy="17.5" r="1.75"/>
            <circle cx="18" cy="17.5" r="1.75"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.25 17.5H3V13l2-5h14l2 5v4.5h-1.25M7.75 17.5h8.5M8 8l2-2.5h4l2 2.5"/>
          </svg>
          Automobiliai
        </button>
        <button data-tab="moto" class="tab-btn flex items-center gap-2 px-3 py-2 text-sm font-medium text-zinc-500 hover:text-white hover:bg-zinc-800 transition-colors">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <circle cx="5.5" cy="17" r="2.25"/><circle cx="18.5" cy="17" r="2.25"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.75 17h9M13 8h3l2.5 4h-4m-1 0l1 5M10 8l-1 4h2.5"/>
          </svg>
          Motociklai
        </button>
        <button data-tab="truck" class="tab-btn flex items-center gap-2 px-3 py-2 text-sm font-medium text-zinc-500 hover:text-white hover:bg-zinc-800 transition-colors">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
          </svg>
          Sunkvežimiai
        </button>
        <button data-tab="saved" class="tab-btn ml-auto flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-zinc-500 hover:text-white hover:bg-zinc-800 transition-colors">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/>
          </svg>
          Išsaugoti
        </button>
      </div>

      <div id="search-fields-wrap">
      <!-- Row 1: Make + Model -->
      <div class="grid grid-cols-2 gap-3 mb-3">
        <div>
          <label class="block text-[10px] text-zinc-500 uppercase tracking-[0.12em] mb-1.5">Markė</label>
          <div class="relative">
            <select id="make-select" class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none transition-colors">
              <option value="">Visos markės</option>
              {carMakes.map(m => <option>{m}</option>)}
            </select>
            <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </div>
        <div>
          <label class="block text-[10px] text-zinc-500 uppercase tracking-[0.12em] mb-1.5">Modelis</label>
          <div class="relative">
            <select id="model-select" disabled class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
              <option value="">Pasirink markę</option>
            </select>
            <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </div>
      </div>

      <!-- Row 2: Year + Price -->
      <div class="grid grid-cols-2 gap-3 mb-3">
        <div>
          <label class="block text-[10px] text-zinc-500 uppercase tracking-[0.12em] mb-1.5">Metai</label>
          <div class="flex gap-2">
            <div class="relative flex-1">
              <select id="year-from" class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none">
                <option value="">Nuo</option>
                {years.map(y=><option>{y}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div class="relative flex-1">
              <select id="year-to" class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none">
                <option value="">Iki</option>
                {years.map(y=><option>{y}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>
        <div>
          <label class="block text-[10px] text-zinc-500 uppercase tracking-[0.12em] mb-1.5">Kaina, €</label>
          <div class="flex gap-2">
            <div class="relative flex-1">
              <select id="price-from" class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none">
                <option value="">Nuo</option>
                {priceOpts.map(p=><option value={p}>{fmtOpt(p)}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div class="relative flex-1">
              <select id="price-to" class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none">
                <option value="">Iki</option>
                {priceOpts.map(p=><option value={p}>{fmtOpt(p)}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 3: Fuel + KM -->
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div>
          <label class="block text-[10px] text-zinc-500 uppercase tracking-[0.12em] mb-1.5">Kuras</label>
          <div class="relative">
            <select id="fuel-select" class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none">
              <option value="">Visi</option>
              <option>Dyzelis</option><option>Benzinas</option>
              <option>Hibridas</option><option>Elektra</option><option>Dujos (LPG)</option>
            </select>
            <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </div>
        <div>
          <label class="block text-[10px] text-zinc-500 uppercase tracking-[0.12em] mb-1.5">Rida iki, km</label>
          <div class="relative">
            <select id="km-to" class="w-full px-3 py-2.5 bg-zinc-900 border border-zinc-800 text-sm text-white focus:outline-none focus:border-zinc-500 appearance-none">
              <option value="">Neribota</option>
              {kmOpts.map(k=><option value={k}>{fmtOpt(k)}</option>)}
            </select>
            <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </div>
      </div>

      <!-- Row 4: Sources -->
      <div class="mb-5">
        <label class="block text-[10px] text-zinc-500 uppercase tracking-[0.12em] mb-2">Šaltiniai</label>
        <div id="source-filters" class="flex flex-wrap gap-1.5">
          <button data-source="all" class="source-btn active px-3 py-1.5 text-xs font-medium bg-white text-black transition-colors">
            Visi
          </button>
          {sources.map(s => (
            <button data-source={s} class="source-btn px-3 py-1.5 text-xs font-medium bg-transparent text-zinc-400 hover:text-white border border-zinc-700 hover:border-zinc-500 transition-colors">
              {s}
            </button>
          ))}
        </div>
      </div>

      <!-- Save search toggle -->
      <div class="flex items-center justify-between mb-4">
        <label id="save-search-label" class="flex items-center gap-2.5 cursor-pointer select-none">
          <div id="toggle-track" class="relative w-10 h-[22px] bg-zinc-800 border border-zinc-700 transition-all duration-200 shrink-0">
            <div id="toggle-thumb" class="absolute top-[3px] left-[3px] w-4 h-4 bg-zinc-500 shadow-sm transition-transform duration-200"></div>
          </div>
          <span id="toggle-text" class="text-xs text-zinc-500 select-none">Išsaugoti paiešką</span>
        </label>
      </div>

      <button id="search-btn" class="w-full py-3 bg-white hover:bg-zinc-100 text-black text-sm font-semibold flex items-center justify-center gap-2.5 transition-colors">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        Ieškoti · 47 000+ skelbimų
      </button>
      </div>

      <!-- Saved searches panel -->
      <div id="saved-panel" class="hidden py-2">
        <div class="flex flex-col items-center justify-center py-10 text-center">
          <div class="w-12 h-12 bg-zinc-800 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-zinc-200 mb-1">Išsaugotos paieškos</p>
          <p class="text-xs text-zinc-500 leading-relaxed mb-5">Prisijunk norėdamas matyti<br>ir valdyti savo išsaugotas paieškas</p>
          <a href="/prisijungti" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white hover:bg-zinc-100 text-black text-xs font-semibold transition-colors">
            Prisijungti
          </a>
        </div>
      </div>
    </div>

    <!-- RIGHT: Hero text -->
    <div class="relative z-10 flex-1 flex flex-col justify-center px-10 lg:px-16 xl:px-20 py-16 lg:py-0">
      <p class="text-[10px] text-zinc-400 uppercase tracking-[0.2em] mb-6">Automobilių aukcionų platforma</p>
      <h1 class="text-5xl sm:text-6xl xl:text-7xl text-white leading-[1.05] mb-6">
        Rask.<br/>Įvertink.<br/>Laimėk.
      </h1>
      <p class="text-base text-zinc-300 leading-relaxed mb-10 max-w-md">
        3 aukcionai, rinkos vertė, remonto rizika, maksimalus statymas ir pelno įvertinimas — kiekvienam skelbimui per sekundes.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/registracija" class="inline-flex items-center gap-2 px-6 py-3 bg-white hover:bg-zinc-100 text-black text-sm font-semibold transition-colors">
          Išbandyti nemokamai
        </a>
        <a href="/analizuoti" class="inline-flex items-center gap-2 px-6 py-3 border border-zinc-600 hover:border-zinc-400 text-white text-sm font-medium transition-colors">
          Analizuoti automobilį
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════ KARŠČIAUSI ══════════ -->
  <section id="karsciausi" class="bg-white px-6 py-14">
    <div class="max-w-7xl mx-auto">

      <div class="flex items-center justify-between mb-8">
        <div>
          <p class="text-[10px] text-zinc-400 uppercase tracking-[0.15em] mb-1" data-anim="up">Aktyvūs aukcionai</p>
          <h2 class="text-xl font-medium text-zinc-900" data-anim="up" data-anim-delay="80">Karščiausia</h2>
        </div>
        <a href="/registracija" class="text-xs text-zinc-500 hover:text-zinc-800 transition-colors" data-anim="up" data-anim-delay="120">Visi skelbimai →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-zinc-100" data-anim-stagger>
        {deals.map(({ id, make, model, year, km, price, source, image, end, url }) => (
          <a href={`/auto/demo?id=${id ?? ''}&make=${encodeURIComponent(make)}&model=${encodeURIComponent(model)}&year=${year ?? ''}&km=${km ?? ''}&price=${price ?? ''}&source=${encodeURIComponent(source)}` + (end ? `&end=${encodeURIComponent(end)}` : '') + (url ? `&url=${encodeURIComponent(url)}` : '')} class="group bg-white hover:bg-zinc-50 transition-colors flex flex-col">
            <div class="relative w-full h-40 bg-zinc-100 flex items-center justify-center overflow-hidden">
              {image ? (
                <img src={image} alt={`${make} ${model}`} loading="lazy" decoding="async"
                     class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"/>
              ) : (
                <svg class="w-10 h-10 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                </svg>
              )}
              <span class:list={['absolute top-2.5 left-2.5 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide', sourceBadge[source] ?? 'bg-zinc-100 text-zinc-600']}>
                {source}
              </span>
            </div>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-sm font-medium text-zinc-800 group-hover:text-zinc-900 transition-colors">{make} {model}</h3>
              <p class="text-xs text-zinc-400 mt-0.5">{year} · {fmtKm(km)}</p>
              <div class="mt-auto pt-4 flex items-center justify-between">
                <span class="text-base font-semibold text-zinc-900">{fmtPrice(price)}</span>
                <span class="text-xs text-zinc-400 group-hover:text-zinc-700 transition-colors">Žiūrėti →</span>
              </div>
            </div>
