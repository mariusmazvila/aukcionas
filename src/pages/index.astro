      'Jeep':          ['Renegade','Compass','Cherokee','Grand Cherokee','Wrangler','Gladiator'],
      'Kia':           ['Picanto','Rio','Ceed','Stonic','Sportage','Sorento','EV6','Niro','ProCeed'],
      'Land Rover':    ['Defender','Discovery','Discovery Sport','Range Rover','Range Rover Sport','Range Rover Evoque','Range Rover Velar','Freelander'],
      'Lexus':         ['IS','ES','GS','LS','NX','RX','UX','LX','LC'],
      'Maserati':      ['Ghibli','Quattroporte','Levante','GranTurismo','GranCabrio','Grecale'],
      'Mazda':         ['Mazda2','Mazda3','Mazda6','CX-3','CX-5','CX-7','CX-9','CX-30','MX-5','CX-60'],
      'Mercedes-Benz': ['A-Klasė','B-Klasė','C-Klasė','E-Klasė','S-Klasė','GLA','GLB','GLC','GLE','GLS','CLA','AMG GT','EQC','EQS'],
      'MINI':          ['Hatch','Clubman','Countryman','Cabrio','Paceman','Roadster','Coupe','Aceman'],
