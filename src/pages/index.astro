---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';

const carMakes = [
  'Alfa Romeo','Audi','BMW','Chevrolet','Chrysler','Citroën','Dacia','Dodge',
  'Fiat','Ford','Honda','Hyundai','Infiniti','Jaguar','Jeep','Kia',
  'Land Rover','Lexus','Maserati','Mazda','Mercedes-Benz','MINI','Mitsubishi',
  'Nissan','Opel','Peugeot','Porsche','Renault','SEAT','Skoda','Smart',
  'Subaru','Suzuki','Tesla','Toyota','Volkswagen','Volvo',
];
const motoMakes = [
  'Aprilia','BMW','Ducati','Harley-Davidson','Honda','Husqvarna',
  'Kawasaki','KTM','Suzuki','Triumph','Yamaha',
];
const truckMakes = ['DAF','Iveco','MAN','Mercedes-Benz','Renault','Scania','Volvo'];

const priceOpts = [1000,2000,3000,5000,7000,10000,12000,15000,20000,25000,30000,40000,50000,75000,100000];
const kmOpts    = [30000,50000,75000,100000,125000,150000,175000,200000,250000,300000,400000,500000];
const years     = Array.from({length:36},(_,i)=>2025-i);

const sources = ['Autoplius.lt','Auto.lt','Autogidas.lt','Mobile.de','AutoScout24','BCA','Copart'];


// Featured cars: live from Supabase, pick ones with a real price so the
// homepage cards look complete. Runs server-side on each request in dev.
const cap = (s: string | null) => (s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : '—');
const { data: dealRows } = supabase
  ? await supabase
      .from('listings')
      .select('make, model, year, mileage_km, price, source, image_urls')
      .not('make', 'is', null)
      .not('price', 'is', null)
      .order('auction_end_date', { ascending: true, nullsFirst: false })
      .limit(6)
  : { data: [] };

const firstImage = (v: unknown): string | null =>
  Array.isArray(v) && v.length > 0 && typeof v[0] === 'string' ? v[0] : null;

const deals = (dealRows ?? []).map((r) => ({
  make:   r.make ?? '',
  model:  r.model ?? '',
  year:   r.year as number | null,
  km:     r.mileage_km as number | null,
  price:  r.price as number | null,
  source: cap(r.source),
  image:  firstImage(r.image_urls),
}));

const articles = [
  {
    slug:'kaip-patikrinti-naudota-automobili',
    title:'5 dalykai, kuriuos reikia patikrinti prieš perkant naudotą automobilį',
    excerpt:'Kilometražas, avarijų istorija, techninė apžiūra — ką svarbu sužinoti ir kaip to nedaryti per tarpininkus.',
    date:'2026-06-05', readMin:5,
  },
  {
    slug:'mobile-de-vs-autoplius',
    title:'Mobile.de vs Autoplius.lt: kur geresnės kainos 2026 m.',
    excerpt:'Palyginome 500+ skelbimų ir išsiaiškinome, kuriame aukcione rasti geresnius sandorius pagal automobilių klasę.',
    date:'2026-06-01', readMin:7,
  },
  {
    slug:'kaip-veikia-autobid',
    title:'Kaip AutoBid sutaupo 5+ valandas per savaitę automobilių pardavėjui',
    excerpt:'Realus use case: kaip suderinti 4 aukcionų monitoringą vienu dashboardu ir nebepraleidinėti gerų pasiūlymų.',
    date:'2026-05-28', readMin:4,
  },
];

const sourceBadge: Record<string,string> = {
  'Autoplius.lt':'bg-orange-100 text-orange-700',
  'Mobile.de':   'bg-sky-100 text-sky-700',
  'AutoScout24': 'bg-emerald-100 text-emerald-700',
  'Auto.lt':     'bg-violet-100 text-violet-700',
  'Alcopa':      'bg-indigo-100 text-indigo-700',
};

function fmtPrice(p:number|null){ return p==null ? 'Kaina sutartinė' : p.toLocaleString('lt-LT')+' €'; }
function fmtKm(km:number|null)  { return km==null ? '—' : km.toLocaleString('lt-LT')+' km'; }
function fmtOpt(n:number)  { return n.toLocaleString('lt-LT'); }
---

<BaseLayout
  title="Automobilių aukcionų stebėjimas"
  description="AutoBid — rask geriausias mašinas iš Autoplius, Mobile.de, AutoScout24 ir kitų aukcionų. Vienas ekranas, realus laikas."
>

  <!-- ══════════ HERO + SEARCH ══════════ -->
  <section class="bg-white px-6 pt-16 pb-14 border-b border-zinc-100 relative overflow-hidden">

    <!-- Car silhouettes background -->
    <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">

      <!-- Sedan -->
      <div class="absolute left-0" style="top:22%;width:54px;height:22px;will-change:transform;backface-visibility:hidden;animation:rush 12s linear 0s backwards infinite;filter:drop-shadow(-16px 0 4px rgba(3,68,211,0.22)) drop-shadow(-36px 0 9px rgba(3,68,211,0.1)) drop-shadow(-60px 0 16px rgba(3,68,211,0.04));">
        <svg fill="none" stroke="#18181b" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 100 40" class="w-full h-full" style="opacity:0.55">
          <path stroke-width="3" d="M4,30 L4,22 L13,22 L22,8 Q28,2 38,2 L66,2 Q74,2 78,8 L86,22 L96,22 L96,30 Q94,37 86,37 Q78,37 76,30 L24,30 Q22,37 14,37 Q6,37 4,30Z"/>
          <path stroke-width="2" d="M15,22 L25,5 L64,5 L77,22"/>
          <line x1="48" y1="22" x2="46" y2="5" stroke-width="2"/>
          <circle cx="86" cy="32" r="5" stroke-width="2.5"/>
          <circle cx="14" cy="32" r="5" stroke-width="2.5"/>
        </svg>
      </div>

      <!-- SUV -->
      <div class="absolute left-0" style="top:62%;width:48px;height:20px;will-change:transform;backface-visibility:hidden;animation:rush 17s linear 5s backwards infinite;filter:drop-shadow(-16px 0 4px rgba(3,68,211,0.22)) drop-shadow(-36px 0 9px rgba(3,68,211,0.1)) drop-shadow(-60px 0 16px rgba(3,68,211,0.04));">
        <svg fill="none" stroke="#18181b" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 100 42" class="w-full h-full" style="opacity:0.5">
          <path stroke-width="3" d="M4,32 L4,22 L10,22 L14,6 Q18,2 24,2 L76,2 Q82,2 86,6 L90,22 L96,22 L96,32 Q94,40 86,40 Q78,40 76,32 L24,32 Q22,40 14,40 Q6,40 4,32Z"/>
          <path stroke-width="2" d="M16,22 L20,4 L50,4 L50,22"/>
          <path stroke-width="2" d="M54,22 L54,4 L80,4 L88,22"/>
          <circle cx="86" cy="34" r="6" stroke-width="2.5"/>
          <circle cx="14" cy="34" r="6" stroke-width="2.5"/>
        </svg>
      </div>

      <!-- Motorcycle (sport bike) -->
      <div class="absolute left-0" style="top:42%;width:60px;height:26px;will-change:transform;backface-visibility:hidden;animation:rush 8s linear 2.5s backwards infinite;filter:drop-shadow(-16px 0 4px rgba(3,68,211,0.22)) drop-shadow(-36px 0 9px rgba(3,68,211,0.1)) drop-shadow(-60px 0 16px rgba(3,68,211,0.04));">
        <svg fill="none" stroke="#18181b" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 120 52" class="w-full h-full" style="opacity:0.52">
          <!-- Rear wheel + 3-spoke rim -->
          <circle cx="90" cy="42" r="12" stroke-width="2.5"/>
          <circle cx="90" cy="42" r="5" stroke-width="2"/>
          <line x1="90" y1="30" x2="90" y2="37" stroke-width="1.5"/>
          <line x1="79.6" y1="48" x2="84.6" y2="45" stroke-width="1.5"/>
          <line x1="100.4" y1="48" x2="95.4" y2="45" stroke-width="1.5"/>
          <!-- Front wheel + 3-spoke rim -->
          <circle cx="22" cy="42" r="11" stroke-width="2.5"/>
          <circle cx="22" cy="42" r="4.5" stroke-width="2"/>
          <line x1="22" y1="31" x2="22" y2="37.5" stroke-width="1.5"/>
          <line x1="12.5" y1="47.5" x2="17.5" y2="44.5" stroke-width="1.5"/>
          <line x1="31.5" y1="47.5" x2="26.5" y2="44.5" stroke-width="1.5"/>
          <!-- Engine block (fat stroke = mass between wheels) -->
          <path stroke-width="7" stroke-linejoin="round" d="M46,42 L50,28 L68,24 L74,34 L74,42"/>
          <!-- Tank + upper frame -->
          <path stroke-width="2.5" d="M50,26 L54,12 L74,10 L78,18 L74,34 L68,24 L50,28 L46,28Z"/>
          <!-- Tail/seat unit -->
          <path stroke-width="2" d="M74,10 L82,8 L88,16 L88,28 L78,32 L74,34"/>
          <!-- Front fork x2 (aggressive forward angle) -->
          <path stroke-width="3.5" d="M46,28 L34,36 L22,42"/>
          <path stroke-width="2.5" d="M44,26 L32,34 L22,42"/>
          <!-- Front fairing (pointed nose) -->
          <path stroke-width="2" d="M46,28 L38,18 L30,22 L34,36"/>
          <!-- Clip-on handlebars (low, sport style) -->
          <line x1="50" y1="26" x2="52" y2="20" stroke-width="2"/>
          <line x1="52" y1="20" x2="58" y2="21" stroke-width="2"/>
          <!-- Swingarm -->
          <line x1="74" y1="42" x2="90" y2="42" stroke-width="2"/>
          <!-- Exhaust under bike -->
          <path stroke-width="2" d="M58,43 L76,48 L90,48"/>
        </svg>
      </div>

    </div>
    <div class="max-w-3xl mx-auto">

      <h1 class="text-5xl sm:text-6xl font-bold text-zinc-900 tracking-tight leading-[1.1] mb-4">
        Kiti prekeiviai skaito skelbimus.<br class="hidden sm:block"/> Tu matai pelną.
      </h1>
      <p class="text-lg text-zinc-500 mb-7 leading-relaxed">
        Rinkos vertė, remonto rizika, maksimalus statymas ir pelno įvertis — kiekvienam skelbimui iš 6 aukcionų, per sekundes.
      </p>

      <div class="flex flex-wrap items-center gap-3 mb-8">
        <a href="/registracija" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-semibold rounded-lg transition-colors">
          Išbandyti demo
        </a>
        <a href="/analizuoti" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-zinc-300 hover:border-zinc-400 text-zinc-800 text-sm font-medium rounded-lg transition-colors">
          Analizuoti automobilį
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>

      <!-- Search panel -->
      <div class="bg-zinc-900 rounded-2xl p-6">

        <!-- Vehicle type tabs -->
        <div id="vehicle-tabs" class="flex gap-1.5 mb-5 pb-5 border-b border-zinc-800">
          <button data-tab="auto" class="tab-btn active flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium bg-zinc-700 text-white transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <circle cx="6" cy="17.5" r="1.75"/>
              <circle cx="18" cy="17.5" r="1.75"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.25 17.5H3V13l2-5h14l2 5v4.5h-1.25M7.75 17.5h8.5M8 8l2-2.5h4l2 2.5"/>
            </svg>
            Automobiliai
          </button>
          <button data-tab="moto" class="tab-btn flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <circle cx="5.5" cy="17" r="2.25"/><circle cx="18.5" cy="17" r="2.25"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.75 17h9M13 8h3l2.5 4h-4m-1 0l1 5M10 8l-1 4h2.5"/>
            </svg>
            Motociklai
          </button>
          <button data-tab="truck" class="tab-btn flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
            </svg>
            Sunkvežimiai
          </button>
          <button data-tab="saved" class="tab-btn ml-auto flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/>
            </svg>
            Mano paieškos
          </button>
        </div>

        <div id="search-fields-wrap">
        <!-- Row 1: Make + Model -->
        <div class="grid grid-cols-2 gap-3 mb-3">
          <div>
            <label class="block text-xs text-zinc-400 mb-1.5">Markė</label>
            <div class="relative">
              <select id="make-select" class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none transition-colors">
                <option value="">Visos markės</option>
                {carMakes.map(m => <option>{m}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
          <div>
            <label class="block text-xs text-zinc-400 mb-1.5">Modelis</label>
            <div class="relative">
              <select id="model-select" disabled class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                <option value="">Pasirink markę</option>
              </select>
              <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>

        <!-- Row 2: Year + Price -->
        <div class="grid grid-cols-2 gap-3 mb-3">
          <div>
            <label class="block text-xs text-zinc-400 mb-1.5">Metai</label>
            <div class="flex gap-2">
              <div class="relative flex-1">
                <select id="year-from" class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none">
                  <option value="">Nuo</option>
                  {years.map(y=><option>{y}</option>)}
                </select>
                <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
              <div class="relative flex-1">
                <select id="year-to" class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none">
                  <option value="">Iki</option>
                  {years.map(y=><option>{y}</option>)}
                </select>
                <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-xs text-zinc-400 mb-1.5">Kaina, €</label>
            <div class="flex gap-2">
              <div class="relative flex-1">
                <select id="price-from" class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none">
                  <option value="">Nuo</option>
                  {priceOpts.map(p=><option value={p}>{fmtOpt(p)}</option>)}
                </select>
                <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
              <div class="relative flex-1">
                <select id="price-to" class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none">
                  <option value="">Iki</option>
                  {priceOpts.map(p=><option value={p}>{fmtOpt(p)}</option>)}
                </select>
                <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Row 3: Fuel + KM -->
        <div class="grid grid-cols-2 gap-3 mb-4">
          <div>
            <label class="block text-xs text-zinc-400 mb-1.5">Kuras</label>
            <div class="relative">
              <select id="fuel-select" class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none">
                <option value="">Visi</option>
                <option>Dyzelis</option><option>Benzinas</option>
                <option>Hibridas</option><option>Elektra</option><option>Dujos (LPG)</option>
              </select>
              <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
          <div>
            <label class="block text-xs text-zinc-400 mb-1.5">Rida iki, km</label>
            <div class="relative">
              <select id="km-to" class="w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 text-sm text-white rounded-lg focus:outline-none focus:border-[#0344D3] appearance-none">
                <option value="">Neribota</option>
                {kmOpts.map(k=><option value={k}>{fmtOpt(k)}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>

        <!-- Row 4: Sources (AutoBid unique) -->
        <div class="mb-5">
          <label class="block text-xs text-zinc-400 mb-2">Šaltiniai</label>
          <div id="source-filters" class="flex flex-wrap gap-2">
            <button data-source="all" class="source-btn active px-3 py-1.5 rounded-lg text-xs font-medium bg-[#0344D3] text-white transition-colors">
              Visi šaltiniai
            </button>
            {sources.map(s => (
              <button data-source={s} class="source-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-800 text-zinc-300 hover:bg-zinc-700 hover:text-white border border-zinc-700 transition-colors">
                {s}
              </button>
            ))}
          </div>
        </div>

        <!-- Save search toggle -->
        <div class="flex items-center justify-between mb-3">
          <label id="save-search-label" class="flex items-center gap-2.5 cursor-pointer select-none">
            <div id="toggle-track" class="relative w-10 h-[22px] bg-zinc-700 border border-zinc-600 rounded-full transition-all duration-200 shrink-0">
              <div id="toggle-thumb" class="absolute top-[3px] left-[3px] w-4 h-4 bg-zinc-400 rounded-full shadow-sm transition-transform duration-200"></div>
            </div>
            <span id="toggle-text" class="text-xs text-zinc-500 select-none">Išsaugoti paiešką</span>
          </label>
        </div>

        <button id="search-btn" class="w-full py-3 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-semibold rounded-xl flex items-center justify-center gap-2.5 transition-colors">
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Ieškoti · 47 000+ skelbimų
        </button>
        </div>

        <!-- Saved searches panel (shown when "Mano paieškos" tab active) -->
        <div id="saved-panel" class="hidden py-2">
          <div class="flex flex-col items-center justify-center py-10 text-center">
            <div class="w-12 h-12 rounded-full bg-zinc-800 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/>
              </svg>
            </div>
            <p class="text-sm font-semibold text-zinc-200 mb-1">Išsaugotos paieškos</p>
            <p class="text-xs text-zinc-500 leading-relaxed mb-5">Prisijunk norėdamas matyti<br>ir valdyti savo išsaugotas paieškas</p>
            <a href="/prisijungti" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-xs font-semibold rounded-lg transition-colors">
              Prisijungti
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ DIENOS PASIŪLYMAI ══════════ -->
  <section class="bg-white px-6 py-12">
    <div class="max-w-6xl mx-auto">

      <div class="flex items-center justify-between mb-6">
        <h2 class="flex items-center gap-2 text-base font-semibold text-zinc-900">
          <svg class="w-4 h-4 text-orange-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2c0 0-4 4-4 8a4 4 0 008 0c0-1.5-.5-2.5-.5-2.5s-.5 1.5-2 2c0 0 1-2 1-4S12 2 12 2zm-2 10c0 1.1.9 2 2 2s2-.9 2-2c0-.8-.4-1.5-.4-1.5S13 11.5 12 12c0 0 .5-1 .5-2S12 8 12 8s-2 2-2 4z"/>
          </svg>
          Karščiausia
        </h2>
        <a href="/registracija" class="text-xs text-[#0344D3] hover:text-[#0240C8] transition-colors">Visi skelbimai →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {deals.map(({ make, model, year, km, price, source, image }) => (
          <a href="/auto/demo" class="group bg-white border border-zinc-100 rounded-xl overflow-hidden hover:border-zinc-200 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex flex-col">
            <div class="relative w-full h-36 bg-gradient-to-br from-zinc-100 to-zinc-200 flex items-center justify-center overflow-hidden">
              {image ? (
                <img src={image} alt={`${make} ${model}`} loading="lazy" decoding="async"
                     class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-200"/>
              ) : (
                <svg class="w-10 h-10 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                </svg>
              )}
              <span class:list={['absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md text-xs font-medium', sourceBadge[source] ?? 'bg-zinc-100 text-zinc-600']}>
                {source}
              </span>
            </div>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-sm font-semibold text-zinc-800 group-hover:text-zinc-900 transition-colors">{make} {model}</h3>
              <p class="text-xs text-zinc-400 mt-0.5">{year} · {fmtKm(km)}</p>
              <div class="mt-auto pt-4 flex items-center justify-between">
                <span class="text-base font-bold text-zinc-900">{fmtPrice(price)}</span>
                <span class="text-xs text-[#0344D3] font-medium">Žiūrėti →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6 flex items-center gap-4">
        <a href="/registracija" class="px-5 py-2.5 bg-[#0344D3] hover:bg-[#0240C8] text-white text-sm font-medium rounded-lg transition-colors">
          Matyti visus 47 000+ skelbimų
        </a>
        <span class="text-xs text-zinc-400">Nemokama registracija</span>
      </div>

    </div>
  </section>

  <!-- ══════════ STRAIPSNIAI ══════════ -->
  <section class="bg-zinc-50 border-t border-zinc-200 px-6 py-12">
    <div class="max-w-6xl mx-auto">

      <div class="flex items-center justify-between mb-6">
        <h2 class="text-base font-semibold text-zinc-900">Straipsniai</h2>
        <a href="/straipsniai" class="text-xs text-[#0344D3] hover:text-[#0240C8] transition-colors">Visi →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {articles.map(({ slug, title, excerpt, date, readMin }) => (
          <article class="bg-white border border-zinc-100 rounded-xl p-6 hover:border-zinc-200 hover:shadow-sm transition-all">
            <h3 class="text-sm font-semibold text-zinc-800 leading-snug mb-3">
              <a href={`/straipsniai/${slug}`} class="hover:text-zinc-900 transition-colors">{title}</a>
            </h3>
            <p class="text-xs text-zinc-500 leading-relaxed mb-4">{excerpt}</p>
            <div class="flex items-center justify-between text-xs text-zinc-400">
              <span>{new Date(date).toLocaleDateString('lt-LT',{year:'numeric',month:'short',day:'numeric'})}</span>
              <span>{readMin} min</span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  @keyframes rush {
    0%   { transform: translate3d(-150px, 0, 0); opacity: 0; }
    3%   { opacity: 1; }
    20%  { opacity: 1; }
    24%  { transform: translate3d(calc(100vw + 150px), 0, 0); opacity: 0; }
    100% { transform: translate3d(calc(100vw + 150px), 0, 0); opacity: 0; }
  }
</style>

<script>
  // ── Models per make ──────────────────────────────────────────────────────
  const modelsByMake: Record<string, Record<string, string[]>> = {
    auto: {
      'Alfa Romeo':    ['Giulia','Giulietta','Stelvio','Tonale','156','147','159','Mito'],
      'Audi':          ['A1','A3','A4','A5','A6','A7','A8','Q2','Q3','Q5','Q7','Q8','TT','e-tron','RS3','RS6'],
      'BMW':           ['1 Series','2 Series','3 Series','4 Series','5 Series','7 Series','X1','X2','X3','X4','X5','X6','X7','M3','M5','iX'],
      'Chevrolet':     ['Aveo','Cruze','Captiva','Trax','Camaro','Corvette','Suburban','Spark'],
      'Chrysler':      ['300','Pacifica','Voyager','Town & Country'],
      'Citroën':       ['C1','C3','C4','C5','C5 X','Berlingo','C-Elysée','Dispatch','Jumpy'],
      'Dacia':         ['Sandero','Duster','Logan','Jogger','Spring','Dokker','Lodgy'],
      'Dodge':         ['Challenger','Charger','Durango','Journey','RAM 1500'],
      'Fiat':          ['500','500X','500L','Panda','Tipo','Punto','Bravo','Doblo','Ducato'],
      'Ford':          ['Fiesta','Focus','Mondeo','Kuga','Puma','EcoSport','Galaxy','S-Max','Ranger','Mustang','Transit'],
      'Honda':         ['Civic','Accord','CR-V','HR-V','Jazz','Pilot','e:Ny1','FR-V'],
      'Hyundai':       ['i10','i20','i30','i40','Tucson','Santa Fe','Kona','Ioniq 5','Ioniq 6','ix35','ix55'],
      'Infiniti':      ['Q30','Q50','Q60','QX30','QX50','QX60','QX70','QX80'],
      'Jaguar':        ['XE','XF','XJ','E-Pace','F-Pace','F-Type','I-Pace'],
      'Jeep':          ['Renegade','Compass','Cherokee','Grand Cherokee','Wrangler','Gladiator'],
      'Kia':           ['Picanto','Rio','Ceed','Stonic','Sportage','Sorento','EV6','Niro','ProCeed'],
      'Land Rover':    ['Defender','Discovery','Discovery Sport','Range Rover','Range Rover Sport','Range Rover Evoque','Range Rover Velar','Freelander'],
      'Lexus':         ['IS','ES','GS','LS','NX','RX','UX','LX','LC'],
      'Maserati':      ['Ghibli','Quattroporte','Levante','GranTurismo','GranCabrio','Grecale'],
      'Mazda':         ['Mazda2','Mazda3','Mazda6','CX-3','CX-5','CX-7','CX-9','CX-30','MX-5','CX-60'],
      'Mercedes-Benz': ['A-Klasė','B-Klasė','C-Klasė','E-Klasė','S-Klasė','GLA','GLB','GLC','GLE','GLS','CLA','AMG GT','EQC','EQS'],
      'MINI':          ['Hatch','Clubman','Countryman','Cabrio','Paceman','Roadster','Coupe','Aceman'],
      'Mitsubishi':    ['Colt','Lancer','Outlander','ASX','Eclipse Cross','L200','Pajero','Space Star'],
      'Nissan':        ['Micra','Note','Leaf','Juke','Qashqai','X-Trail','Navara','370Z','GT-R','Ariya'],
      'Opel':          ['Astra','Corsa','Insignia','Mokka','Grandland','Crossland','Zafira','Combo','Vivaro'],
      'Peugeot':       ['108','208','308','508','2008','3008','5008','Partner','Expert','e-208'],
      'Porsche':       ['911','Cayenne','Macan','Panamera','Taycan','Boxster','Cayman'],
      'Renault':       ['Clio','Megane','Laguna','Kadjar','Captur','Koleos','Zoe','Talisman','Twingo','Arkana'],
      'SEAT':          ['Ibiza','Leon','Arona','Ateca','Tarraco','Alhambra','Mii'],
      'Skoda':         ['Fabia','Octavia','Superb','Kodiaq','Karoq','Scala','Enyaq','Rapid','Kamiq'],
      'Smart':         ['fortwo','forfour','EQ fortwo','EQ forfour'],
      'Subaru':        ['Impreza','Legacy','Outback','Forester','XV','BRZ','WRX','Levorg'],
      'Suzuki':        ['Swift','Baleno','Vitara','SX4','Jimny','S-Cross','Ignis','Alto'],
      'Tesla':         ['Model 3','Model S','Model X','Model Y','Cybertruck'],
      'Toyota':        ['Yaris','Corolla','Camry','RAV4','Land Cruiser','Prius','Hilux','C-HR','Aygo','Supra','bZ4X'],
      'Volkswagen':    ['Polo','Golf','Passat','Tiguan','T-Roc','T-Cross','ID.3','ID.4','Touareg','Arteon','Sharan','Touran','Caddy','Transporter'],
      'Volvo':         ['V40','V60','V90','S60','S90','XC40','XC60','XC90','C40','EX30'],
    },
    moto: {
      'Aprilia':         ['RSV4','Tuono V4','RS 660','Shiver 900','Dorsoduro','Caponord','Mana'],
      'BMW':             ['R 1250 GS','F 850 GS','S 1000 RR','R 1200 RT','K 1600 GT','G 310 R','M 1000 RR','F 900 R'],
      'Ducati':          ['Panigale V4','Monster','Multistrada V4','Supersport','Scrambler','Streetfighter','Hypermotard','Diavel'],
      'Harley-Davidson': ['Sportster','Softail','Touring','Dyna','Street Glide','Road King','Fat Boy','LiveWire'],
      'Honda':           ['CBR600RR','CBR1000RR','CB500F','CB750','Africa Twin','VFR800','NC750X','X-ADV','CB125R'],
      'Husqvarna':       ['Vitpilen 401','Svartpilen 401','TE 300','FE 450','Norden 901','701 Enduro'],
      'Kawasaki':        ['Z900','Z650','Ninja 400','Ninja 650','Ninja H2','Versys 650','ZX-10R','Z1000','Z125'],
      'KTM':             ['Duke 390','Duke 790','1290 Super Duke','890 Adventure','RC390','EXC 300','250 Duke'],
      'Suzuki':          ['GSX-R600','GSX-R1000','SV650','GSR750','V-Strom 650','Hayabusa','Katana','GSX-S1000'],
      'Triumph':         ['Speed Triple','Tiger 900','Bonneville','Street Triple','Rocket 3','Scrambler 1200','Daytona'],
      'Yamaha':          ['MT-07','MT-09','YZF-R6','YZF-R1','Tracer 9','Ténéré 700','XMAX 300','XSR900','TMAX'],
    },
    truck: {
      'DAF':           ['XF','CF','LF','XG','XG+','LF Electric'],
      'Iveco':         ['Daily','Stralis','Eurocargo','Trakker','S-WAY','X-WAY','Hi-Way'],
      'MAN':           ['TGX','TGS','TGM','TGL','TGE','Lion\'s Coach'],
      'Mercedes-Benz': ['Actros','Atego','Antos','Arocs','Sprinter','Vito','Citan','eActros'],
      'Renault':       ['Range T','Range C','Range K','Range D','Master','Traffic','Kangoo'],
      'Scania':        ['R Series','S Series','P Series','G Series','XT Series','Streamline'],
      'Volvo':         ['FH','FM','FMX','FL','FE','VNL','VNR'],
    },
  };

  // ── State ────────────────────────────────────────────────────────────────
  let currentTab = 'auto';

  const tabs        = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const makeSelect  = document.getElementById('make-select')  as HTMLSelectElement;
  const modelSelect = document.getElementById('model-select') as HTMLSelectElement;
  const searchFieldsWrap = document.getElementById('search-fields-wrap') as HTMLDivElement;
  const savedPanel       = document.getElementById('saved-panel')        as HTMLDivElement;

  const makesByTab: Record<string, string[]> = {
    auto:  ['Alfa Romeo','Audi','BMW','Chevrolet','Chrysler','Citroën','Dacia','Dodge','Fiat','Ford','Honda','Hyundai','Infiniti','Jaguar','Jeep','Kia','Land Rover','Lexus','Maserati','Mazda','Mercedes-Benz','MINI','Mitsubishi','Nissan','Opel','Peugeot','Porsche','Renault','SEAT','Skoda','Smart','Subaru','Suzuki','Tesla','Toyota','Volkswagen','Volvo'],
    moto:  ['Aprilia','BMW','Ducati','Harley-Davidson','Honda','Husqvarna','Kawasaki','KTM','Suzuki','Triumph','Yamaha'],
    truck: ['DAF','Iveco','MAN','Mercedes-Benz','Renault','Scania','Volvo'],
  };
  const labelsByTab: Record<string, string> = {
    auto: 'Visos markės', moto: 'Visos markės', truck: 'Visi gamintojai',
  };

  function populateModels(make: string) {
    const models = modelsByMake[currentTab]?.[make] ?? [];
    if (!models.length) {
      modelSelect.innerHTML = '<option value="">Visi modeliai</option>';
      modelSelect.disabled = true;
    } else {
      modelSelect.innerHTML = '<option value="">Visi modeliai</option>' +
        models.map(m => `<option value="${m}">${m}</option>`).join('');
      modelSelect.disabled = false;
    }
  }

  makeSelect.addEventListener('change', () => populateModels(makeSelect.value));

  function switchTab(tab: string) {
    currentTab = tab;
    tabs.forEach(btn => {
      const active = btn.dataset.tab === tab;
      btn.classList.toggle('bg-zinc-700', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('text-zinc-400', !active);
      btn.classList.toggle('hover:text-zinc-200', !active);
      btn.classList.toggle('hover:bg-zinc-800', !active);
    });

    if (tab === 'saved') {
      searchFieldsWrap.classList.add('hidden');
      savedPanel.classList.remove('hidden');
    } else {
      searchFieldsWrap.classList.remove('hidden');
      savedPanel.classList.add('hidden');
      const makes = makesByTab[tab] ?? makesByTab.auto;
      makeSelect.innerHTML = `<option value="">${labelsByTab[tab] ?? 'Visos markės'}</option>` +
        makes.map(m => `<option value="${m}">${m}</option>`).join('');
      populateModels('');
    }
  }

  tabs.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab ?? 'auto')));

  // ── Search button → navigate to /rezultatai ──────────────────────────────
  document.getElementById('search-btn')!.addEventListener('click', () => {
    const p = new URLSearchParams();
    p.set('type', currentTab);
    const make = makeSelect.value;
    if (make)  p.set('make',  make);
    const model = modelSelect.value;
    if (model) p.set('model', model);
    const yearFrom  = (document.getElementById('year-from')  as HTMLSelectElement).value;
    const yearTo    = (document.getElementById('year-to')    as HTMLSelectElement).value;
    const priceFrom = (document.getElementById('price-from') as HTMLSelectElement).value;
    const priceTo   = (document.getElementById('price-to')   as HTMLSelectElement).value;
    const fuel      = (document.getElementById('fuel-select') as HTMLSelectElement).value;
    const kmTo      = (document.getElementById('km-to')      as HTMLSelectElement).value;
    if (yearFrom)  p.set('metaiNuo',  yearFrom);
    if (yearTo)    p.set('metaiIki',  yearTo);
    if (priceFrom) p.set('kainaNuo',  priceFrom);
    if (priceTo)   p.set('kainaIki',  priceTo);
    if (fuel)      p.set('kuras',     fuel);
    if (kmTo)      p.set('ridaIki',   kmTo);
    const activeSources = [...document.querySelectorAll<HTMLButtonElement>('.source-btn')]
      .filter(b => b.dataset.source !== 'all' && b.classList.contains('bg-[#0344D3]'))
      .map(b => b.dataset.source!);
    if (activeSources.length) p.set('saltiniai', activeSources.join(','));
    window.location.href = `/rezultatai?${p.toString()}`;
  });

  // ── Source filter pills ──────────────────────────────────────────────────
  const sourceBtns = document.querySelectorAll<HTMLButtonElement>('.source-btn');
  sourceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.source === 'all') {
        sourceBtns.forEach(b => {
          const isAll = b.dataset.source === 'all';
          b.classList.toggle('bg-[#0344D3]', isAll);
          b.classList.toggle('text-white', isAll);
          b.classList.toggle('bg-zinc-800', !isAll);
          b.classList.toggle('text-zinc-300', !isAll);
          b.classList.toggle('border', !isAll);
          b.classList.toggle('border-zinc-700', !isAll);
        });
      } else {
        const allBtn = document.querySelector<HTMLButtonElement>('[data-source="all"]')!;
        allBtn.classList.remove('bg-[#0344D3]','text-white');
        allBtn.classList.add('bg-zinc-800','text-zinc-300','border','border-zinc-700');
        btn.classList.toggle('bg-[#0344D3]');
        btn.classList.toggle('text-white');
        btn.classList.toggle('bg-zinc-800');
        btn.classList.toggle('text-zinc-300');
        btn.classList.toggle('border');
        btn.classList.toggle('border-zinc-700');
      }
    });
  });

  // ── Save toggle ──────────────────────────────────────────────────────────
  const saveLabel   = document.getElementById('save-search-label') as HTMLLabelElement;
  const toggleTrack = document.getElementById('toggle-track')      as HTMLDivElement;
  const toggleThumb = document.getElementById('toggle-thumb')      as HTMLDivElement;
  const toggleText  = document.getElementById('toggle-text')       as HTMLSpanElement;
  let saveEnabled = false;

  saveLabel.addEventListener('click', () => {
    saveEnabled = !saveEnabled;
    toggleTrack.style.backgroundColor = saveEnabled ? '#0344D3' : '';
    toggleTrack.style.borderColor     = saveEnabled ? '#0344D3' : '';
    toggleTrack.classList.toggle('bg-zinc-700',   !saveEnabled);
    toggleTrack.classList.toggle('border-zinc-600', !saveEnabled);
    toggleThumb.style.transform       = saveEnabled ? 'translateX(18px)' : '';
    toggleThumb.style.backgroundColor = saveEnabled ? '#ffffff' : '';
    toggleText.style.color            = saveEnabled ? '#d4d4d8' : '';
  });
</script>
