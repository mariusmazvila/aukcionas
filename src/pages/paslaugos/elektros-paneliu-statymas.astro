---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import CTASection from '../../components/sections/CTASection.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import config from '../../config';
import type { ServiceSchema } from '../../lib/schema';

// Service structured data — rodomas Google paieškos rezultatuose
const serviceSchema: ServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Elektros panelių statymas",
  description: "Pramoninių ir komercinių elektros skydų projektavimas, gamyba ir montavimas. Atitinka EN 61439 standartą. Sertifikuotos medžiagos, pilna dokumentacija.",
  provider: {
    "@type": "Organization",
    name: config.companyName,
    url: config.siteUrl,
  },
  areaServed: ["Vilnius", "Kaunas", "Klaipėda", "Šiauliai", "Panevėžys", "Lietuva"],
  serviceType: "Elektros skydų gamyba ir montavimas",
  url: `${config.siteUrl}/paslaugos/elektros-paneliu-statymas`,
};

const features = [
  'Paskirstymo skydai iki 6300 A',
  'Valdymo ir automatikos skydai',
  'ATS (automatinis tinklo perjungimas)',
  'MCC (variklių valdymo centrai)',
  'Apsaugos relių skydai',
  'UPS ir baterijų skydai',
  'ATEX (sprogimui pavojingos zonos)',
  'Lauko skydai IP65/IP66',
];

const specs = [
  { label: 'Srovės diapazonas', value: 'iki 6300 A' },
  { label: 'Įtampa', value: '400/690 V (LV), iki 36 kV (MV)' },
  { label: 'Standartas', value: 'EN 61439-1/2, IEC 61439' },
  { label: 'Apsaugos laipsnis', value: 'IP20 – IP66' },
  { label: 'Garantija', value: '5 metai' },
  { label: 'Terminai', value: '3–8 savaitės (nuo projekto patvirtinimo)' },
];
---

<BaseLayout
  title="Elektros panelių statymas"
  description="Pramoninių elektros skydų projektavimas ir gamyba. EN 61439 standartas, sertifikuotos medžiagos, pilna dokumentacija. Visa Lietuva."
>
  <!-- Papildomi schema.org duomenys puslapiui -->
  <Fragment slot="head">
    <StructuredData schema={serviceSchema} />
  </Fragment>

  <!-- Puslapio antraštė -->
  <section class="bg-gray-50 border-b border-gray-100 py-10 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Pagrindinis', href: '/' },
          { label: 'Paslaugos', href: '/paslaugos' },
          { label: 'Elektros panelių statymas', href: '/paslaugos/elektros-paneliu-statymas' },
        ]}
        class="mb-4"
      />

      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0 mt-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight tracking-tight">
            Elektros panelių statymas
          </h1>
          <p class="mt-3 text-lg text-gray-600 max-w-2xl leading-relaxed">
            Projektuojame ir gaminame paskirstymo bei valdymo skydus pramoniniam
            ir komerciniam sektoriui. Atitinkame EN 61439 standartą.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pagrindinis turinys -->
  <section class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">

        <!-- Aprašymas + savybės (2/3) -->
        <div class="lg:col-span-2 space-y-10">

          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Apie paslaugą</h2>
            <div class="space-y-4 text-gray-600 leading-relaxed">
              <p>
                Elektros skydai yra kiekvieno elektros tinklo širdis — juose sutelkta
                apsaugos, valdymo ir paskirstymo įranga. Blogai suprojektuotas ar
                pagamintas skydelis kelia ne tik gedimų, bet ir gaisro bei žmonių
                saugos riziką.
              </p>
              <p>
                Innomode gaminami skydai atitinka EN 61439 standartą — tai reiškia,
                kad kiekvienas egzempliorius išeina gamyklą su pilnu bandymų protokolu,
                atitikties deklaracija ir technine dokumentacija. Naudojame tik
                Schneider Electric, ABB, Siemens ir Eaton sertifikuotą įrangą.
              </p>
              <p>
                Gamybos terminas — 3 iki 8 savaitės, priklausomai nuo sudėtingumo.
                Skubūs atvejai aptariami individualiai.
              </p>
            </div>
          </div>

          <!-- Gaminamų skydų tipai -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-5">Gaminamų skydų tipai</h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {features.map((feature) => (
                <li class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-gray-700 text-sm">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Kokybės kontrolė -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Kokybės kontrolė</h2>
            <div class="bg-blue-50 rounded-2xl p-6 space-y-3">
              {[
                'Vizualinė ir matavimų patikra pagal EN 61439',
                'Dielektriniai bandymai (iki 3 kV)',
                'Apsaugos laipsnio IP patikra',
                'Funkciniai junginių bandymai',
                'Šiluminė apkrova ir ventiliacijos patikra',
                'Dokumentacijos komplektavimas prieš išvežimą',
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-sm text-blue-900">{item}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

        <!-- Techninės specifikacijos + CTA (1/3) -->
        <div class="space-y-6">

          <!-- Specs kortelė -->
          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
            <h3 class="font-semibold text-gray-900 mb-4 pb-3 border-b border-gray-100">
              Techninės specifikacijos
            </h3>
            <dl class="space-y-3">
              {specs.map(({ label, value }) => (
                <div>
                  <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">{label}</dt>
                  <dd class="text-sm font-medium text-gray-900 mt-0.5">{value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- CTA kortelė -->
          <div class="bg-blue-600 rounded-2xl p-6 text-white">
            <h3 class="font-semibold text-lg mb-2">Gauti pasiūlymą</h3>
            <p class="text-blue-100 text-sm mb-4 leading-relaxed">
              Papasakokite apie savo projektą — inžinierius atsakys per 1 darbo dieną.
            </p>
            <Button
              variant="secondary"
              href="/kontaktai"
              class="!bg-white !text-blue-700 hover:!bg-blue-50 w-full justify-center"
            >
              Susisiekti
            </Button>
          </div>

          <!-- Susijusios paslaugos -->
          <div class="bg-gray-50 rounded-2xl p-6">
            <h3 class="font-semibold text-gray-900 mb-3 text-sm uppercase tracking-wide">
              Susijusios paslaugos
            </h3>
            <ul class="space-y-2">
              {[
                { label: 'Projektavimas', href: '/paslaugos/projektavimas' },
                { label: 'Montavimas', href: '/paslaugos/montavimas' },
                { label: 'Techninė priežiūra', href: '/paslaugos/prieziura' },
              ].map(({ label, href }) => (
                <li>
                  <a href={href} class="text-sm text-blue-600 hover:text-blue-700 flex items-center gap-1 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </div>
  </section>

  <CTASection
    headline="Reikalingas elektros skydelis?"
    description="Pateikite užklausą — per 2 darbo dienas gausite orientacinę kainą ir techninę specifikaciją."
    primaryCta={{ text: 'Pateikti užklausą', href: '/kontaktai' }}
    secondaryCta={{ text: 'Mūsų darbai', href: '/darbai' }}
    background="dark"
  />
</BaseLayout>
