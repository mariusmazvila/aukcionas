# Nukopijuok šį failą į .env ir įrašyk tikrus ID'us.
# .env NIEKADA nekelk į git (jis jau .gitignore sąraše).

# Svetainės URL — naudojamas sitemap ir RSS generavimui
# Netlify: galima nustatyti kaip env kintamąjį dashboard'e
# Pastaba: config.ts taip pat turi siteUrl — abu turi sutapti
SITE_URL=https://innomode.lt

# Analytics konfigūracija

# Google Analytics 4 — rasi GA4 administratoriuje:
# Admin → Data Streams → tavo srautas → Measurement ID
PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel — rasi Facebook Events Manager:
# Events Manager → tavo Pixel → Pixel ID
PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXXX

# Google Tag Manager (opcionalus — naudok ARBA GA4 tiesiai, ARBA GTM)
# GTM naudok jei reikia valdyti kelis tag'us iš vieno taško
PUBLIC_GTM_ID=GTM-XXXXXXX
